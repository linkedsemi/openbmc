diff --git a/drivers/char/ipmi/lingsi/lingsi_sio.c b/drivers/char/ipmi/lingsi/lingsi_sio.c
new file mode 100644
index 000000000000..b230526e93a3
--- /dev/null
+++ b/drivers/char/ipmi/lingsi/lingsi_sio.c
@@ -0,0 +1,202 @@
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+#include <linux/irq.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/syscon.h>
+#include <linux/atomic.h>
+#include <linux/of_platform.h>
+#include "lingsi_espi_lpc_common.h"
+#define DEVICE_NAME "lingsi-sio"
+
+struct lingsi_ldn_dev {
+    u8 base_addr_lsb;
+    u8 base_addr_msb;
+    u8 enable;
+};
+
+struct lingsi_sio {
+    struct lingsi_espi_lpc_struct *parent;
+    struct lingsi_peri_ioport io_2e, io_2f;
+    struct lingsi_ldn_dev ldn_2, ldn_3, ldn_4, ldn_7,
+        ldn_b, ldn_c, ldn_d, ldn_e, ldn_f;
+    struct lingsi_ldn_dev *ldn;
+    u8 index;
+    u8 ldn_num;
+    u8 reg_2x[16];
+};
+
+static void select_ldn(struct lingsi_sio *sio, u8 ldn_num)
+{
+    switch (ldn_num) {
+    case 0x2:
+        sio->ldn = &sio->ldn_2;
+        break;
+    case 0x3:
+        sio->ldn = &sio->ldn_3;
+        break;
+    case 0x4:
+        sio->ldn = &sio->ldn_4;
+        break;
+    case 0x7:
+        sio->ldn = &sio->ldn_7;
+        break;
+    case 0xb:
+        sio->ldn = &sio->ldn_b;
+        break;
+    case 0xc:
+        sio->ldn = &sio->ldn_c;
+        break;
+    case 0xd:
+        sio->ldn = &sio->ldn_d;
+        break;
+    case 0xe:
+        sio->ldn = &sio->ldn_e;
+        break;
+    case 0xf:
+        sio->ldn = &sio->ldn_f;
+        break;
+    }
+}
+
+static void io_2e_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_sio *priv = ioport->ctx;
+    u8 *val = res;
+    *val = priv->index;
+}
+
+static void io_2e_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_sio *priv = ioport->ctx;
+    priv->index = *data;
+}
+
+static u8 ldn_dev_read(struct lingsi_ldn_dev *ldn, u8 index)
+{
+    u8 val = 0;
+    switch (index) {
+    case 0x30:
+        val = ldn->enable;
+        break;
+    case 0x60:
+        val = ldn->base_addr_msb;
+        break;
+    case 0x61:
+        val = ldn->base_addr_lsb;
+        break;
+    }
+    return val;
+}
+
+static void io_2f_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_sio *sio = ioport->ctx;
+    u8 *val = res;
+    if (sio->index == 0x7) {
+        *val = sio->ldn_num;
+    } else if (sio->index == 0x20) {
+        *val = 0x26;
+    } else if (sio->index >= 0x20 && sio->index < 0x30) {
+        *val = sio->reg_2x[sio->index & 0xf];
+    } else {
+        BUG_ON(sio->ldn == NULL);
+        *val = ldn_dev_read(sio->ldn, sio->index);
+    }
+}
+
+static void ldn_dev_write(struct lingsi_ldn_dev *ldn, u8 index, u8 val)
+{
+    switch (index) {
+    case 0x30:
+        ldn->enable = val;
+        break;
+    case 0x60:
+        ldn->base_addr_msb = val;
+        break;
+    case 0x61:
+        ldn->base_addr_lsb = val;
+        break;
+    }
+}
+
+static void io_2f_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_sio *sio = ioport->ctx;
+    if (sio->index == 0x7) {
+        sio->ldn_num = *data;
+        select_ldn(sio, sio->ldn_num);
+    } else if (sio->index >= 0x20 && sio->index < 0x30) {
+        sio->reg_2x[sio->index & 0xf] = *data;
+    } else {
+        BUG_ON(sio->ldn == NULL);
+        ldn_dev_write(sio->ldn, sio->index, *data);
+    }
+}
+
+#define SIO_PORT_ADD(x)    espi_lpc_add_ioport(espi_lpc, &priv->io_##x, io_##x##_read, io_##x##_write, 0x##x, priv)
+#define SIO_PORT_REMOVE(x) espi_lpc_remove_ioport(&priv->io_##x)
+
+static int lingsi_sio_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct platform_device *parent_pdev;
+    struct lingsi_espi_lpc_struct *espi_lpc;
+    struct lingsi_sio *priv;
+    struct device_node *parent = of_get_parent(dev->of_node);
+    if (!parent) {
+        dev_err(dev, "cannot get parent node\n");
+        return -ENODEV;
+    }
+    parent_pdev = of_find_device_by_node(parent);
+    if (!parent_pdev) {
+        dev_err(dev, "cannot get parent device\n");
+        return -ENODEV;
+    }
+    espi_lpc = platform_get_drvdata(parent_pdev);
+    if (!espi_lpc) {
+        dev_err(dev, "espi lpc not inited\n");
+        return -EPROBE_DEFER;
+    }
+    priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+    if (!priv) {
+        dev_err(dev, "cannot alloc lingsi_sio mem\n");
+        return -ENOMEM;
+    }
+    priv->parent = espi_lpc;
+    SIO_PORT_ADD(2e);
+    SIO_PORT_ADD(2f);
+
+    platform_set_drvdata(pdev, priv);
+
+    return 0;
+}
+
+static int lingsi_sio_remove(struct platform_device *pdev)
+{
+    struct lingsi_sio *priv = platform_get_drvdata(pdev);
+    SIO_PORT_REMOVE(2e);
+    SIO_PORT_REMOVE(2f);
+    return 0;
+}
+
+static const struct of_device_id lingsi_sio_match[] = {
+    { .compatible = "lingsi,sio" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, lingsi_sio_match);
+
+static struct platform_driver lingsi_sio_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .of_match_table = lingsi_sio_match,
+    },
+    .probe = lingsi_sio_probe,
+    .remove = lingsi_sio_remove,
+};
+module_platform_driver(lingsi_sio_driver);
+
+MODULE_LICENSE("GPL");
