@@ -0,0 +1,1002 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright 2020 IBM Corp.
+// Copyright (c) 2019-2020 Intel Corporation
+
+#include <linux/atomic.h>
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/v4l2-controls.h>
+#include <linux/videodev2.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-dev.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-dv-timings.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <linux/dmaengine.h>
+#include <media/videobuf2-v4l2.h>
+#include <media/videobuf2-dma-contig.h>
+#include <linux/ktime.h>
+
+#define DBG(format,...)\
+        printk(KERN_CRIT "info:%s:%d: "format"\n",__func__,__LINE__,##__VA_ARGS__);
+#define DBG_LINE DBG("")
+
+#define IMAGE_SIZE 1920000
+#define PIX_BPP 4
+
+#define DEVICE_NAME            "lingsi-video"
+
+#define MAX_FRAME_RATE        60
+#define MAX_HEIGHT            1200
+#define MAX_WIDTH            1920
+#define MIN_HEIGHT            480
+#define MIN_WIDTH            640
+
+#define HEIGHT 600
+#define WIDTH  800
+
+#define STOP_TIMEOUT            msecs_to_jiffies(1000)
+
+#define LINGSI_DMA_MAX_DATA_ITEMS    0xffff
+/*
+ * Valid transfer starts from @0 to @0xFFFE leading to unaligned scatter
+ * gather at boundary. Thus it's safer to round down this value on FIFO
+ * size (16 Bytes)
+ */
+#define LINGSI_DMA_ALIGNED_MAX_DATA_ITEMS    \
+    ALIGN_DOWN(LINGSI_DMA_MAX_DATA_ITEMS, 16)
+
+enum {
+    VIDEO_MODE_DETECT_DONE,
+    VIDEO_RES_CHANGE,
+    VIDEO_RES_DETECT,
+    VIDEO_STREAMING,
+    VIDEO_FRAME_INPRG,
+    VIDEO_STOPPED,
+    VIDEO_CLOCKS_ON,
+};
+
+struct lingsi_video_addr {
+    unsigned int size;
+    dma_addr_t dma;
+    void *virt;
+};
+
+struct lingsi_video_buffer {
+    struct vb2_v4l2_buffer vb;
+    struct list_head link;
+    dma_addr_t        paddr;
+    size_t            size;
+};
+
+#define to_lingsi_video_buffer(x) \
+    container_of((x), struct lingsi_video_buffer, vb)
+
+struct lingsi_video {
+    struct clk *eclk;
+    struct clk *vclk;
+
+    struct device *dev;
+    struct v4l2_device v4l2_dev;
+    struct v4l2_pix_format pix_fmt;
+    struct v4l2_bt_timings active_timings;
+    struct v4l2_bt_timings detected_timings;
+    u32 v4l2_input_status;
+    struct vb2_queue queue;
+    struct video_device vdev;
+    struct mutex video_lock;    /* v4l2 and videobuf2 lock */
+
+    wait_queue_head_t wait;
+    spinlock_t lock;        /* buffer list lock */
+
+    struct list_head buffers;
+    unsigned long flags;
+    unsigned int sequence;
+
+    unsigned int max_compressed_size;
+    struct lingsi_video_addr srcs[2];
+    struct lingsi_video_addr jpeg;
+
+    // bool yuv420;
+    unsigned int frame_rate;
+    // unsigned int jpeg_quality;
+
+    unsigned int frame_bottom;
+    unsigned int frame_left;
+    unsigned int frame_right;
+    unsigned int frame_top;
+
+
+    /* Protects the access of variables shared within the interrupt */
+    struct v4l2_format        fmt;
+
+    /* Protect this data structure */
+    struct dma_chan            *dma_chan;
+    dma_cookie_t            dma_cookie;
+    int                errors_count;
+    int                overrun_count;
+    int                buffers_count;
+
+    /* Ensure DMA operations atomicity */
+    struct mutex            dma_lock;
+    struct dma_async_tx_descriptor *tx;
+    unsigned long long vram;
+    dma_cookie_t cookie;
+};
+
+#define to_lingsi_video(x) container_of((x), struct lingsi_video, v4l2_dev)
+
+static const struct v4l2_dv_timings_cap lingsi_video_timings_cap = {
+    .type = V4L2_DV_BT_656_1120,
+    .bt = {
+        .min_width = MIN_WIDTH,
+        .max_width = MAX_WIDTH,
+        .min_height = MIN_HEIGHT,
+        .max_height = MAX_HEIGHT,
+        .min_pixelclock = 6574080, /* 640 x 480 x 24Hz */
+        .max_pixelclock = 138240000, /* 1920 x 1200 x 60Hz */
+        .standards = V4L2_DV_BT_STD_CEA861 | V4L2_DV_BT_STD_DMT |
+            V4L2_DV_BT_STD_CVT | V4L2_DV_BT_STD_GTF,
+        .capabilities = V4L2_DV_BT_CAP_PROGRESSIVE |
+            V4L2_DV_BT_CAP_REDUCED_BLANKING |
+            V4L2_DV_BT_CAP_CUSTOM,
+    },
+};
+
+
+static int lingsi_start_capture(struct lingsi_video *video, struct lingsi_video_buffer *buf);
+static void lingsi_dma_callback(void *param);
+
+static void lingsi_video_buffer_done(struct lingsi_video *video,
+                 struct lingsi_video_buffer *buf,
+                 size_t bytesused,
+                 int err)
+{
+    struct vb2_v4l2_buffer *vbuf;
+
+    if (!buf)
+        return;
+
+    list_del_init(&buf->link);
+    vbuf = &buf->vb;
+    vbuf->sequence = video->sequence++;
+    vbuf->field = V4L2_FIELD_NONE;
+    vbuf->vb2_buf.timestamp = ktime_get_ns();
+    vb2_set_plane_payload(&vbuf->vb2_buf, 0, bytesused);
+    vb2_buffer_done(&vbuf->vb2_buf,
+            err ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+    dev_dbg(video->dev, "buffer[%d] done seq=%d, bytesused=%zu\n",
+        vbuf->vb2_buf.index, vbuf->sequence, bytesused);
+    video->buffers_count++;
+}
+
+
+static int lingsi_start_dma(struct lingsi_video *video, struct lingsi_video_buffer *buf)
+{
+    if(buf == NULL) {
+        DBG("dma NULL buf")
+        return -EINVAL;
+    }
+
+    video->tx = video->dma_chan->device->device_prep_dma_memcpy(video->dma_chan,
+                buf->paddr, video->vram, buf->size, DMA_CTRL_ACK | DMA_PREP_INTERRUPT);
+    if (!video->tx) {
+        printk(KERN_INFO "Failed to prepare DMA memcpy");
+    }
+    video->tx->callback = lingsi_dma_callback;
+    video->tx->callback_param = video;
+    video->cookie = video->tx->tx_submit(video->tx);
+
+    if (dma_submit_error(video->cookie)) {
+        printk("DMA tx submit failed");
+    }
+
+    mutex_unlock(&video->dma_lock);
+
+    dma_async_issue_pending(video->dma_chan);
+
+    return 0;
+}
+
+static int lingsi_start_capture(struct lingsi_video *video, struct lingsi_video_buffer *buf)
+{
+    int ret;
+
+    if (!buf)
+        return -EINVAL;
+
+    ret = lingsi_start_dma(video, buf);
+    if (ret) {
+        video->errors_count++;
+        return ret;
+    }
+    return 0;
+}
+
+static int lingsi_video_start_frame(struct lingsi_video *video)
+{
+    unsigned long flags;
+    struct lingsi_video_buffer *buf;
+    int ret;
+
+    if (video->v4l2_input_status) {
+        dev_dbg(video->dev, "No signal; don't start frame\n");
+        return 0;
+    }
+
+    spin_lock_irqsave(&video->lock, flags);
+    buf = list_first_entry_or_null(&video->buffers, struct lingsi_video_buffer, link);
+    if (!buf) {
+        spin_unlock_irqrestore(&video->lock, flags);
+        dev_dbg(video->dev, "No buffers; don't start frame\n");
+        return -EPROTO;
+    }
+
+    set_bit(VIDEO_FRAME_INPRG, &video->flags);
+
+    /******** virtural memcpy ...********/
+    // addr = vb2_plane_vaddr(&buf->vb.vb2_buf, 0);
+    // memcpy(addr, video->base, IMAGE_SIZE);
+
+    /******** phy memcpy ...********/
+    buf->paddr = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+    buf->size = vb2_plane_size(&buf->vb.vb2_buf, 0);
+
+    spin_unlock_irqrestore(&video->lock, flags);
+    ret = lingsi_start_capture(video, buf);
+    if (ret) {
+        dev_err(video->dev, "%s: Start streaming failed, cannot start capture\n",
+            __func__);
+    }
+
+    return 0;
+}
+
+static void lingsi_dma_callback(void *param)
+{
+    struct lingsi_video *video = (struct lingsi_video *)param;
+    struct dma_tx_state state;
+    enum dma_status status;
+    struct lingsi_video_buffer *buf;
+
+    /* Check DMA status */
+    status = dmaengine_tx_status(video->dma_chan, video->dma_cookie, &state);
+
+    switch (status) {
+    case DMA_IN_PROGRESS:
+        dev_dbg(video->dev, "%s: Received DMA_IN_PROGRESS\n", __func__);
+        break;
+    case DMA_PAUSED:
+        dev_err(video->dev, "%s: Received DMA_PAUSED\n", __func__);
+        break;
+    case DMA_ERROR:
+        dev_err(video->dev, "%s: Received DMA_ERROR\n", __func__);
+
+        /* Return buffer to V4L2 in error state */
+        lingsi_video_buffer_done(video, buf, 0, -EIO);
+        break;
+    case DMA_COMPLETE:
+        dev_dbg(video->dev, "%s: Received DMA_COMPLETE\n", __func__);
+        spin_lock(&video->lock);
+        clear_bit(VIDEO_FRAME_INPRG, &video->flags);
+        buf = list_first_entry_or_null(&video->buffers,
+                            struct lingsi_video_buffer,
+                            link);
+        if (buf) {
+            vb2_set_plane_payload(&buf->vb.vb2_buf, 0, IMAGE_SIZE);
+
+            if (!list_is_last(&buf->link, &video->buffers)) {
+                buf->vb.vb2_buf.timestamp = ktime_get_ns();
+                buf->vb.sequence = video->sequence++;
+                buf->vb.field = V4L2_FIELD_NONE;
+                vb2_buffer_done(&buf->vb.vb2_buf,
+                        VB2_BUF_STATE_DONE);
+                list_del(&buf->link);
+            }
+        }
+        spin_unlock(&video->lock);
+
+        if (test_bit(VIDEO_STREAMING, &video->flags) && buf)
+            lingsi_video_start_frame(video);
+        return;
+    default:
+        dev_err(video->dev, "%s: Received unknown status\n", __func__);
+        break;
+    }
+}
+
+
+static void lingsi_video_off(struct lingsi_video *video)
+{
+    if (!test_bit(VIDEO_CLOCKS_ON, &video->flags))
+        return;
+
+    clear_bit(VIDEO_CLOCKS_ON, &video->flags);
+}
+
+static void lingsi_video_on(struct lingsi_video *video)
+{
+    if (test_bit(VIDEO_CLOCKS_ON, &video->flags))
+        return;
+
+    set_bit(VIDEO_CLOCKS_ON, &video->flags);
+}
+
+static void lingsi_video_bufs_done(struct lingsi_video *video, enum vb2_buffer_state state)
+{
+    unsigned long flags;
+    struct lingsi_video_buffer *buf;
+
+    spin_lock_irqsave(&video->lock, flags);
+    list_for_each_entry(buf, &video->buffers, link)
+        vb2_buffer_done(&buf->vb.vb2_buf, state);
+    INIT_LIST_HEAD(&video->buffers);
+    spin_unlock_irqrestore(&video->lock, flags);
+}
+
+#define res_check(v) test_and_clear_bit(VIDEO_MODE_DETECT_DONE, &(v)->flags)
+
+static void lingsi_video_get_resolution(struct lingsi_video *video)
+{
+    struct v4l2_bt_timings *det = &video->detected_timings;
+
+    det->height = HEIGHT;
+    det->width = WIDTH;
+    video->v4l2_input_status = 0;
+    dev_dbg(video->dev, "Got resolution: %dx%d\n", det->width, det->height);
+    return;
+}
+
+static void lingsi_video_set_resolution(struct lingsi_video *video)
+{
+    return;
+}
+
+static void lingsi_video_start(struct lingsi_video *video)
+{
+    lingsi_video_on(video);
+
+    /* Resolution set to 640x480 if no signal found */
+    lingsi_video_get_resolution(video);
+
+    /* Set timings since the device is being opened for the first time */
+    video->active_timings = video->detected_timings;
+    lingsi_video_set_resolution(video);
+
+    video->pix_fmt.width = WIDTH;
+    video->pix_fmt.height = HEIGHT;
+    video->pix_fmt.sizeimage = IMAGE_SIZE;
+    video->pix_fmt.field = V4L2_FIELD_NONE;
+    video->pix_fmt.colorspace = V4L2_COLORSPACE_RAW;
+    video->pix_fmt.bytesperline = video->pix_fmt.width * PIX_BPP;
+}
+
+static void lingsi_video_stop(struct lingsi_video *video)
+{
+    set_bit(VIDEO_STOPPED, &video->flags);
+
+    lingsi_video_off(video);
+
+    video->v4l2_input_status = V4L2_IN_ST_NO_SIGNAL;
+    video->flags = 0;
+}
