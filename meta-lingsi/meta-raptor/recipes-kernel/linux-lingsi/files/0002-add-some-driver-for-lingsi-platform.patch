diff --git a/drivers/char/ipmi/lingsi/lingsi_host_vuart.c b/drivers/char/ipmi/lingsi/lingsi_host_vuart.c
new file mode 100644
index 000000000000..3ba390eb7883
--- /dev/null
+++ b/drivers/char/ipmi/lingsi/lingsi_host_vuart.c
@@ -0,0 +1,294 @@
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+#include <linux/atomic.h>
+#include <linux/of_platform.h>
+#include <linux/serial.h>
+#include <linux/serial_core.h>
+#include "lingsi_espi_lpc_common.h"
+#include "lingsi_vuart.h"
+#define DEVICE_NAME "lingsi-host-vuart"
+struct host_vuart_reg {
+    uint8_t dll;
+    uint8_t dlh;
+    uint8_t ier;
+    uint8_t fcr;
+    uint8_t lcr;
+    uint8_t mcr;
+    uint8_t scr;
+};
+
+struct lingsi_host_vuart {
+    struct lingsi_espi_lpc_struct *parent;
+    struct lingsi_vuart uartp;
+    struct lingsi_upstream_irq up_irq;
+    struct lingsi_host_reg host_reg;
+    struct lingsi_peri_ioport ioport[8];
+    struct host_vuart_reg vuart_reg;
+    bool level_up_irq_active;
+    bool local_enabled;
+};
+
+static bool host_vuart_rx_available(struct lingsi_host_vuart *priv)
+{
+    return !lingsi_vuart_local_tx_empty(&priv->uartp);
+}
+
+static u8 host_vuart_reg_get_iir(struct lingsi_host_vuart *priv)
+{
+    bool tx_empty = true;
+    u8 iir;
+    iir = priv->vuart_reg.fcr & 0x1 ? 0xc0 : 0;
+    if ((priv->vuart_reg.ier & 0x1) && host_vuart_reg_get_iir(priv)) {
+        iir |= 0x4;
+    } else if ((priv->vuart_reg.ier & 0x2) & tx_empty) {
+        iir |= 0x2;
+    } else {
+        iir |= 0x1;
+    }
+    return iir;
+}
+
+static void host_vuart_report_inactive_level_up_irq(struct lingsi_host_vuart *priv)
+{
+    if ((host_vuart_reg_get_iir(priv) & 0xf) == 0x1) {
+        if (priv->up_irq.type & IRQ_TYPE_LEVEL_MASK) {
+            if (priv->level_up_irq_active) {
+                espi_lpc_set_level_irq(priv->parent, priv->up_irq.id, 0);
+                priv->level_up_irq_active = false;
+            }
+        }
+    }
+}
+
+static void host_vuart_report_active_edge_level_up_irq(struct lingsi_host_vuart *priv)
+{
+    if ((host_vuart_reg_get_iir(priv) & 0xf) == 0x1) {
+        return;
+    }
+    if (priv->up_irq.type & IRQ_TYPE_LEVEL_MASK) {
+        if (!priv->level_up_irq_active) {
+            espi_lpc_set_level_irq(priv->parent, priv->up_irq.id, 1);
+            priv->level_up_irq_active = true;
+        }
+    } else {
+        espi_lpc_raise_edge_irq(priv->parent, priv->up_irq.id);
+    }
+}
+
+static void host_vuart_reg0_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    u8 *val = res;
+    if (priv->vuart_reg.lcr & 0x80) {
+        *val = priv->vuart_reg.dll;
+    } else if (host_vuart_reg_get_iir(priv)) {
+        *val = lingsi_vuart_get_tx_char(&priv->uartp);
+        host_vuart_report_inactive_level_up_irq(priv);
+    }
+}
+
+static void host_vuart_reg0_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    if (priv->vuart_reg.lcr & 0x80) {
+        priv->vuart_reg.dll = *data;
+    } else {
+        lingsi_vuart_char_rx_handle(&priv->uartp, *data);
+        //vuart_report_inactive_level_up_irq(priv);
+    }
+}
+
+static void host_vuart_reg1_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    u8 *val = res;
+    if (priv->vuart_reg.lcr & 0x80) {
+        *val = priv->vuart_reg.dlh;
+    } else {
+        *val = priv->vuart_reg.ier;
+    }
+}
+
+static void host_vuart_reg1_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    if (priv->vuart_reg.lcr & 0x80) {
+        priv->vuart_reg.dlh = *data;
+    } else {
+        priv->vuart_reg.ier = *data;
+        host_vuart_report_active_edge_level_up_irq(priv);
+    }
+}
+
+static void host_vuart_reg2_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    u8 *val = res;
+    *val = host_vuart_reg_get_iir(priv);
+}
+
+static void host_vuart_reg2_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    priv->vuart_reg.fcr = *data;
+}
+
+static void host_vuart_reg3_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    u8 *val = res;
+    *val = priv->vuart_reg.lcr;
+}
+
+static void host_vuart_reg3_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    priv->vuart_reg.lcr = *data;
+}
+
+static void host_vuart_reg4_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    u8 *val = res;
+    *val = priv->vuart_reg.mcr;
+}
+
+static void host_vuart_reg4_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    priv->vuart_reg.mcr = *data;
+}
+
+static void host_vuart_reg5_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    u8 *val = res;
+    *val = 0x60;
+    if (host_vuart_rx_available(priv)) {
+        *val |= 0x1;
+    }
+}
+
+static void host_vuart_reg5_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    BUG_ON(1);
+}
+
+static void host_vuart_reg6_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    u8 *val = res;
+    *val = 0;
+}
+
+static void host_vuart_reg6_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    BUG_ON(1);
+}
+
+static void host_vuart_reg7_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    u8 *val = res;
+    *val = priv->vuart_reg.scr;
+}
+
+static void host_vuart_reg7_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_host_vuart *priv = ioport->ctx;
+    priv->vuart_reg.scr = *data;
+}
+
+static int lingsi_host_vuart_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct platform_device *parent_pdev;
+    struct lingsi_espi_lpc_struct *espi_lpc;
+    struct lingsi_host_vuart *priv;
+    struct device_node *parent = of_get_parent(dev->of_node);
+    int rc;
+    if (!parent) {
+        dev_err(dev, "cannot get parent node\n");
+        return -ENODEV;
+    }
+    parent_pdev = of_find_device_by_node(parent);
+    if (!parent_pdev) {
+        dev_err(dev, "cannot get parent device\n");
+        return -ENODEV;
+    }
+    espi_lpc = platform_get_drvdata(parent_pdev);
+    if (!espi_lpc) {
+        dev_err(dev, "espi lpc not inited\n");
+        return -EPROBE_DEFER;
+    }
+    priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+    if (!priv) {
+        dev_err(dev, "cannot alloc lingsi_host_dev mem\n");
+        return -ENOMEM;
+    }
+    priv->parent = espi_lpc;
+
+    rc = of_property_read_u32_array(pdev->dev.of_node, "host_reg", (u32 *)&priv->host_reg, 2);
+    if (rc < 0) {
+        dev_err(dev, "no valid 'host_reg' configured\n");
+        return rc;
+    }
+    rc = of_property_read_u32_array(pdev->dev.of_node, "upstream_irq", (u32 *)&priv->up_irq, 2);
+    if (rc < 0) {
+        dev_err(dev, "no valid 'upstream_irq' configured\n");
+        return rc;
+    }
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[0], host_vuart_reg0_read, host_vuart_reg0_write, priv->host_reg.base, priv);
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[1], host_vuart_reg1_read, host_vuart_reg1_write, priv->host_reg.base + 1, priv);
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[2], host_vuart_reg2_read, host_vuart_reg2_write, priv->host_reg.base + 2, priv);
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[3], host_vuart_reg3_read, host_vuart_reg3_write, priv->host_reg.base + 3, priv);
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[4], host_vuart_reg4_read, host_vuart_reg4_write, priv->host_reg.base + 4, priv);
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[5], host_vuart_reg5_read, host_vuart_reg5_write, priv->host_reg.base + 5, priv);
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[6], host_vuart_reg6_read, host_vuart_reg6_write, priv->host_reg.base + 6, priv);
+    espi_lpc_add_ioport(espi_lpc, &priv->ioport[7], host_vuart_reg7_read, host_vuart_reg7_write, priv->host_reg.base + 7, priv);
+
+    pdev->id = of_alias_get_id(pdev->dev.of_node, "vuart");
+    if (pdev->id < 0) {
+        dev_err(&pdev->dev, "id %d out of range\n", pdev->id);
+        return -EINVAL;
+    }
+    rc = lingsi_vuart_port_add(&priv->uartp, dev, pdev->id);
+    if (rc) {
+        dev_err(dev, "lingsi_vuart_port_init() failed; err=%i\n", rc);
+        return rc;
+    }
+    platform_set_drvdata(pdev, priv);
+    return 0;
+}
+
+static int lingsi_host_vuart_remove(struct platform_device *pdev)
+{
+    int i;
+    struct lingsi_host_vuart *priv = platform_get_drvdata(pdev);
+    lingsi_vuart_port_remove(&priv->uartp);
+    for (i = 0; i < 8; ++i) {
+        espi_lpc_remove_ioport(&priv->ioport[i]);
+    }
+    return 0;
+}
+
+static const struct of_device_id lingsi_host_vuart_match[] = {
+    { .compatible = "lingsi,host-vuart" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, lingsi_host_vuart_match);
+
+static struct platform_driver lingsi_host_vuart_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .of_match_table = lingsi_host_vuart_match,
+    },
+    .probe = lingsi_host_vuart_probe,
+    .remove = lingsi_host_vuart_remove,
+};
+module_platform_driver(lingsi_host_vuart_driver);
+
+MODULE_LICENSE("GPL");
