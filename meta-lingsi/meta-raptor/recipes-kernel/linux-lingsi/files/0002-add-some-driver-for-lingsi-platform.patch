+    },
+    {
+        .val_regs = 0x0038,
+        .rdata_reg = 0x0016c,
+        .irq_regs = 0x003c,
+        .tolerance_regs = 0x0050,
+        // .names = { "I", "J", "K", "L" },
+    },
+    {
+        .val_regs = 0x0054,
+        .rdata_reg = 0x00170,
+        .irq_regs = 0x0058,
+        .tolerance_regs = 0x006c,
+        // .names = { "M", "N", "O", "P" },
+    },
+    {
+        .val_regs = 0x0070,
+        .rdata_reg = 0x00174,
+        .irq_regs = 0x0074,
+        .tolerance_regs = 0x0088,
+    },
+    {
+        .val_regs = 0x008c,
+        .rdata_reg = 0x00178,
+        .irq_regs = 0x0090,
+        .tolerance_regs = 0x0104,
+    },
+    {
+        .val_regs = 0x0108,
+        .rdata_reg = 0x0017c,
+        .irq_regs = 0x010c,
+        .tolerance_regs = 0x0120,
+    },
+    {
+        .val_regs = 0x0124,
+        .rdata_reg = 0x00180,
+        .irq_regs = 0x0128,
+        .tolerance_regs = 0x013c,
+    },
+};
+
+enum lingsi_sgpio_reg {
+    reg_val,
+    reg_rdata,
+    reg_irq_enable,
+    reg_irq_type0,
+    reg_irq_type1,
+    reg_irq_type2,
+    reg_irq_status,
+    reg_tolerance,
+};
+
+#define GPIO_VAL_VALUE      0x00
+#define GPIO_IRQ_ENABLE     0x00
+#define GPIO_IRQ_TYPE0      0x04
+#define GPIO_IRQ_TYPE1      0x08
+#define GPIO_IRQ_TYPE2      0x0C
+#define GPIO_IRQ_STATUS     0x10
+
+static void __iomem *bank_reg(struct lingsi_sgpio *gpio,
+                     const struct lingsi_sgpio_bank *bank,
+                     const enum lingsi_sgpio_reg reg)
+{
+    switch (reg) {
+    case reg_val:
+        return gpio->base + bank->val_regs + GPIO_VAL_VALUE;
+    case reg_rdata:
+        return gpio->base + bank->rdata_reg;
+    case reg_irq_enable:
+        return gpio->base + bank->irq_regs + GPIO_IRQ_ENABLE;
+    case reg_irq_type0:
+        return gpio->base + bank->irq_regs + GPIO_IRQ_TYPE0;
+    case reg_irq_type1:
+        return gpio->base + bank->irq_regs + GPIO_IRQ_TYPE1;
+    case reg_irq_type2:
+        return gpio->base + bank->irq_regs + GPIO_IRQ_TYPE2;
+    case reg_irq_status:
+        return gpio->base + bank->irq_regs + GPIO_IRQ_STATUS;
+    case reg_tolerance:
+        return gpio->base + bank->tolerance_regs;
+    default:
+        /* acturally if code runs to here, it's an error case */
+        BUG();
+    }
+}
+
+#define GPIO_BANK(x)    ((x) >> 6)
+#define GPIO_OFFSET(x)  ((x) & GENMASK(5, 0))
+#define GPIO_BIT(x)     BIT(GPIO_OFFSET(x) >> 1)
+
+static const struct lingsi_sgpio_bank *to_bank(unsigned int offset)
+{
+    unsigned int bank;
+
+    bank = GPIO_BANK(offset);
+
+    WARN_ON(bank >= ARRAY_SIZE(lingsi_sgpio_banks));
+    return &lingsi_sgpio_banks[bank];
+}
+
+static int lingsi_sgpio_init_valid_mask(struct gpio_chip *gc,
+        unsigned long *valid_mask, unsigned int ngpios)
+{
+    bitmap_set(valid_mask, 0, ngpios);
+    return 0;
+}
+
+static void lingsi_sgpio_irq_init_valid_mask(struct gpio_chip *gc,
+        unsigned long *valid_mask, unsigned int ngpios)
+{
+    unsigned int i;
+
+    /* input GPIOs are even bits */
+    for (i = 0; i < ngpios; i++) {
+        if (i % 2)
+            clear_bit(i, valid_mask);
+    }
+}
+
+static bool lingsi_sgpio_is_input(unsigned int offset)
+{
+    return !(offset % 2);
+}
+
+static int lingsi_sgpio_get(struct gpio_chip *gc, unsigned int offset)
+{
+    struct lingsi_sgpio *gpio = gpiochip_get_data(gc);
+    const struct lingsi_sgpio_bank *bank = to_bank(offset);
+    unsigned long flags;
+    enum lingsi_sgpio_reg reg;
+    int rc = 0;
+
+    raw_spin_lock_irqsave(&gpio->lock, flags);
+
+    reg = lingsi_sgpio_is_input(offset) ? reg_val : reg_rdata;
+    rc = !!(ioread32(bank_reg(gpio, bank, reg)) & GPIO_BIT(offset));
+
+    raw_spin_unlock_irqrestore(&gpio->lock, flags);
+
+    return rc;
+}
+
+static int sgpio_set_value(struct gpio_chip *gc, unsigned int offset, int val)
+{
+    struct lingsi_sgpio *gpio = gpiochip_get_data(gc);
+    const struct lingsi_sgpio_bank *bank = to_bank(offset);
+    void __iomem *addr_r, *addr_w;
+    u32 reg = 0;
+
+    if (lingsi_sgpio_is_input(offset))
+        return -EINVAL;
+
+    /* Since this is an output, read the cached value from rdata, then
+     * update val. */
+    addr_r = bank_reg(gpio, bank, reg_rdata);
+    addr_w = bank_reg(gpio, bank, reg_val);
+
+    reg = ioread32(addr_r);
+
+    if (val)
+        reg |= GPIO_BIT(offset);
+    else
+        reg &= ~GPIO_BIT(offset);
+
+    iowrite32(reg, addr_w);
+
+    return 0;
+}
+
+static void lingsi_sgpio_set(struct gpio_chip *gc, unsigned int offset, int val)
+{
+    struct lingsi_sgpio *gpio = gpiochip_get_data(gc);
+    unsigned long flags;
+
+    raw_spin_lock_irqsave(&gpio->lock, flags);
+
+    sgpio_set_value(gc, offset, val);
+
+    raw_spin_unlock_irqrestore(&gpio->lock, flags);
+}
+
+static int lingsi_sgpio_dir_in(struct gpio_chip *gc, unsigned int offset)
+{
+    return lingsi_sgpio_is_input(offset) ? 0 : -EINVAL;
+}
+
+static int lingsi_sgpio_dir_out(struct gpio_chip *gc, unsigned int offset, int val)
+{
+    struct lingsi_sgpio *gpio = gpiochip_get_data(gc);
+    unsigned long flags;
+    int rc;
+
+    /* No special action is required for setting the direction; we'll
+     * error-out in sgpio_set_value if this isn't an output GPIO */
+
+    raw_spin_lock_irqsave(&gpio->lock, flags);
+    rc = sgpio_set_value(gc, offset, val);
+    raw_spin_unlock_irqrestore(&gpio->lock, flags);
+
+    return rc;
+}
+
+static int lingsi_sgpio_get_direction(struct gpio_chip *gc, unsigned int offset)
+{
+    return !!lingsi_sgpio_is_input(offset);
+}
+
+static void irqd_to_lingsi_sgpio_data(struct irq_data *d,
+                    struct lingsi_sgpio **gpio,
+                    const struct lingsi_sgpio_bank **bank,
+                    u32 *bit, int *offset)
+{
+    struct lingsi_sgpio *internal;
+
+    *offset = irqd_to_hwirq(d);
+    internal = irq_data_get_irq_chip_data(d);
+    WARN_ON(!internal);
+
+    *gpio = internal;
+    *bank = to_bank(*offset);
+    *bit = GPIO_BIT(*offset);
+}
+
+static void lingsi_sgpio_irq_ack(struct irq_data *d)
+{
+    const struct lingsi_sgpio_bank *bank;
+    struct lingsi_sgpio *gpio;
+    unsigned long flags;
+    void __iomem *status_addr;
+    int offset;
+    u32 bit;
+
+    irqd_to_lingsi_sgpio_data(d, &gpio, &bank, &bit, &offset);
+
+    status_addr = bank_reg(gpio, bank, reg_irq_status);
+
+    raw_spin_lock_irqsave(&gpio->lock, flags);
+
+    iowrite32(bit, status_addr);
+
+    raw_spin_unlock_irqrestore(&gpio->lock, flags);
+}
+
+static void lingsi_sgpio_irq_set_mask(struct irq_data *d, bool set)
+{
+    const struct lingsi_sgpio_bank *bank;
+    struct lingsi_sgpio *gpio;
+    unsigned long flags;
+    u32 reg, bit;
+    void __iomem *addr;
+    int offset;
+
+    irqd_to_lingsi_sgpio_data(d, &gpio, &bank, &bit, &offset);
+    addr = bank_reg(gpio, bank, reg_irq_enable);
+
+    /* Unmasking the IRQ */
+    if (set)
+        gpiochip_enable_irq(&gpio->chip, irqd_to_hwirq(d));
+
+    raw_spin_lock_irqsave(&gpio->lock, flags);
+
+    reg = ioread32(addr);
+    if (set)
+        reg |= bit;
+    else
+        reg &= ~bit;
+
+    iowrite32(reg, addr);
+
+    raw_spin_unlock_irqrestore(&gpio->lock, flags);
+
+    /* Masking the IRQ */
+    if (!set)
+        gpiochip_disable_irq(&gpio->chip, irqd_to_hwirq(d));
+
+
+}
+
+static void lingsi_sgpio_irq_mask(struct irq_data *d)
+{
+    lingsi_sgpio_irq_set_mask(d, false);
+}
+
+static void lingsi_sgpio_irq_unmask(struct irq_data *d)
+{
+    lingsi_sgpio_irq_set_mask(d, true);
+}
+
+static int lingsi_sgpio_set_type(struct irq_data *d, unsigned int type)
+{
+    u32 type0 = 0;
+    u32 type1 = 0;
+    u32 type2 = 0;
+    u32 bit, reg;
+    const struct lingsi_sgpio_bank *bank;
+    irq_flow_handler_t handler;
+    struct lingsi_sgpio *gpio;
+    unsigned long flags;
+    void __iomem *addr;
+    int offset;
+
+    irqd_to_lingsi_sgpio_data(d, &gpio, &bank, &bit, &offset);
+
+    switch (type & IRQ_TYPE_SENSE_MASK) {
+    case IRQ_TYPE_EDGE_BOTH:
+        type2 |= bit;
+        fallthrough;
+    case IRQ_TYPE_EDGE_RISING:
+        type0 |= bit;
+        fallthrough;
+    case IRQ_TYPE_EDGE_FALLING:
+        handler = handle_edge_irq;
+        break;
+    case IRQ_TYPE_LEVEL_HIGH:
+        type0 |= bit;
+        fallthrough;
+    case IRQ_TYPE_LEVEL_LOW:
+        type1 |= bit;
+        handler = handle_level_irq;
+        break;
+    default:
+        return -EINVAL;
+    }
+
+    raw_spin_lock_irqsave(&gpio->lock, flags);
+
+    addr = bank_reg(gpio, bank, reg_irq_type0);
+    reg = ioread32(addr);
+    reg = (reg & ~bit) | type0;
+    iowrite32(reg, addr);
+
+    addr = bank_reg(gpio, bank, reg_irq_type1);
+    reg = ioread32(addr);
+    reg = (reg & ~bit) | type1;
+    iowrite32(reg, addr);
+
+    addr = bank_reg(gpio, bank, reg_irq_type2);
+    reg = ioread32(addr);
+    reg = (reg & ~bit) | type2;
+    iowrite32(reg, addr);
+
+    raw_spin_unlock_irqrestore(&gpio->lock, flags);
+
+    irq_set_handler_locked(d, handler);
+
+    return 0;
+}
+
+static void lingsi_sgpio_irq_handler(struct irq_desc *desc)
+{
+    struct gpio_chip *gc = irq_desc_get_handler_data(desc);
+    struct irq_chip *ic = irq_desc_get_chip(desc);
+    struct lingsi_sgpio *data = gpiochip_get_data(gc);
+    unsigned int i, p;
+    unsigned long reg;
+
+    chained_irq_enter(ic, desc);
+
+    for (i = 0; i < ARRAY_SIZE(lingsi_sgpio_banks); i++) {
+        const struct lingsi_sgpio_bank *bank = &lingsi_sgpio_banks[i];
+
+        reg = ioread32(bank_reg(data, bank, reg_irq_status));
+
+        for_each_set_bit(p, &reg, 32)
+            generic_handle_domain_irq(gc->irq.domain, (i * 32 + p) * 2);
+    }
+
+    chained_irq_exit(ic, desc);
+}
+
+static void lingsi_sgpio_irq_print_chip(struct irq_data *d, struct seq_file *p)
+{
+    const struct lingsi_sgpio_bank *bank;
+    struct lingsi_sgpio *gpio;
+    u32 bit;
+    int offset;
+
+    irqd_to_lingsi_sgpio_data(d, &gpio, &bank, &bit, &offset);
+    seq_printf(p, dev_name(gpio->dev));
+}
+
+static const struct irq_chip lingsi_sgpio_irq_chip = {
+    .irq_ack = lingsi_sgpio_irq_ack,
+    .irq_mask = lingsi_sgpio_irq_mask,
+    .irq_unmask = lingsi_sgpio_irq_unmask,
+    .irq_set_type = lingsi_sgpio_set_type,
+    .irq_print_chip = lingsi_sgpio_irq_print_chip,
+    .flags = IRQCHIP_IMMUTABLE,
+    GPIOCHIP_IRQ_RESOURCE_HELPERS,
+};
+
+static int lingsi_sgpio_setup_irqs(struct lingsi_sgpio *gpio,
+                   struct platform_device *pdev)
+{
+    int rc, i;
+    const struct lingsi_sgpio_bank *bank;
+    struct gpio_irq_chip *irq;
+    rc = platform_get_irq(pdev, 0);
+    if (rc < 0)
+        return rc;
+
+    gpio->irq = rc;
+
+    /* Disable IRQ and clear Interrupt status registers for all SGPIO Pins. */
+    for (i = 0; i < ARRAY_SIZE(lingsi_sgpio_banks); i++) {
+        bank =  &lingsi_sgpio_banks[i];
+        /* disable irq enable bits */
+        iowrite32(0x00000000, bank_reg(gpio, bank, reg_irq_enable));
+        /* clear status bits */
+        iowrite32(0xffffffff, bank_reg(gpio, bank, reg_irq_status));
+    }
+    irq = &gpio->chip.irq;
+    gpio_irq_chip_set_chip(irq, &lingsi_sgpio_irq_chip);
+    irq->init_valid_mask = lingsi_sgpio_irq_init_valid_mask;
+    irq->handler = handle_bad_irq;
+    irq->default_type = IRQ_TYPE_NONE;
+    irq->parent_handler = lingsi_sgpio_irq_handler;
+    irq->parent_handler_data = gpio;
+    irq->parents = &gpio->irq;
+    irq->num_parents = 1;
+    /* Apply default IRQ settings */
+    for (i = 0; i < ARRAY_SIZE(lingsi_sgpio_banks); i++) {
+        bank = &lingsi_sgpio_banks[i];
+        /* set falling or level-low irq */
+        iowrite32(0x00000000, bank_reg(gpio, bank, reg_irq_type0));
+        /* trigger type is edge */
+        iowrite32(0x00000000, bank_reg(gpio, bank, reg_irq_type1));
+        /* single edge trigger */
+        iowrite32(0x00000000, bank_reg(gpio, bank, reg_irq_type2));
+    }
+    return 0;
+}
+
+static int lingsi_sgpio_reset_tolerance(struct gpio_chip *chip,
+                    unsigned int offset, bool enable)
+{
+    struct lingsi_sgpio *gpio = gpiochip_get_data(chip);
+    unsigned long flags;
+    void __iomem *reg;
+    u32 val;
+
+    reg = bank_reg(gpio, to_bank(offset), reg_tolerance);
+
+    raw_spin_lock_irqsave(&gpio->lock, flags);
+
+    val = readl(reg);
+
+    if (enable)
+        val |= GPIO_BIT(offset);
+    else
+        val &= ~GPIO_BIT(offset);
+
+    writel(val, reg);
+
+    raw_spin_unlock_irqrestore(&gpio->lock, flags);
+
+    return 0;
+}
+
+static int lingsi_sgpio_set_config(struct gpio_chip *chip, unsigned int offset,
+                   unsigned long config)
+{
+    unsigned long param = pinconf_to_config_param(config);
+    u32 arg = pinconf_to_config_argument(config);
+
+    if (param == PIN_CONFIG_PERSIST_STATE)
+        return lingsi_sgpio_reset_tolerance(chip, offset, arg);
+
+    return -ENOTSUPP;
+}
+
+static const struct lingsi_sgpio_pdata raptor_sgpiom_pdata = {
+    .pin_mask = GENMASK(10, 5),
+};
+
+static const struct of_device_id lingsi_sgpio_of_table[] = {
+    { .compatible = "lingsi,sgpiom", .data = &raptor_sgpiom_pdata, },
+    {}
+};
+
+MODULE_DEVICE_TABLE(of, lingsi_sgpio_of_table);
+
+static int __init lingsi_sgpio_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    u32 nr_gpios, sgpio_freq, sgpio_clk_div, gpio_cnt_regval, pin_mask;
+    const struct lingsi_sgpio_pdata *pdata;
+    struct lingsi_sgpio *gpio;
+    unsigned long apb_freq;
+    int rc;
+    gpio = devm_kzalloc(&pdev->dev, sizeof(*gpio), GFP_KERNEL);
+    if (!gpio)
+        return -ENOMEM;
+    gpio->base = devm_platform_ioremap_resource(pdev, 0);
+    if (IS_ERR(gpio->base))
+        return PTR_ERR(gpio->base);
+
+    gpio->dev = &pdev->dev;
+    pdata = device_get_match_data(&pdev->dev);
+    if (!pdata)
+        return -EINVAL;
+    pin_mask = pdata->pin_mask;
+
+    rc = device_property_read_u32(&pdev->dev, "ngpios", &nr_gpios);
+    if (rc < 0) {
+        dev_err(&pdev->dev, "Could not read ngpios property\n");
+        return -EINVAL;
+    } else if (nr_gpios % 8) {
+        dev_err(&pdev->dev, "Number of GPIOs not multiple of 8: %d\n",
+            nr_gpios);
+        return -EINVAL;
+    }
+    rc = device_property_read_u32(&pdev->dev, "bus-frequency", &sgpio_freq);
+    if (rc < 0) {
+        dev_err(&pdev->dev, "Could not read bus-frequency property\n");
+        return -EINVAL;
+    }
+    gpio->pclk = devm_clk_get(&pdev->dev, NULL);
+    if (IS_ERR(gpio->pclk)) {
+        dev_err(&pdev->dev, "devm_clk_get failed\n");
+        return PTR_ERR(gpio->pclk);
+    }
+    apb_freq = clk_get_rate(gpio->pclk);
+
+    /*
+     * From the datasheet,
+     *    SGPIO period = 1/PCLK * 2 * (GPIO254[31:16] + 1)
+     *    period = 2 * (GPIO254[31:16] + 1) / PCLK
+     *    frequency = 1 / (2 * (GPIO254[31:16] + 1) / PCLK)
+     *    frequency = PCLK / (2 * (GPIO254[31:16] + 1))
+     *    frequency * 2 * (GPIO254[31:16] + 1) = PCLK
+     *    GPIO254[31:16] = PCLK / (frequency * 2) - 1
+     */
+    if (sgpio_freq == 0)
+        return -EINVAL;
+    sgpio_clk_div = (apb_freq / (sgpio_freq * 2)) - 1;
+
+    if (sgpio_clk_div > (1 << 16) - 1)
+        return -EINVAL;
+    gpio_cnt_regval = ((nr_gpios / 8) << LINGSI_SGPIO_PINS_SHIFT) & pin_mask;
+    iowrite32(FIELD_PREP(LINGSI_SGPIO_CLK_DIV_MASK, sgpio_clk_div) | gpio_cnt_regval |
+          LINGSI_SGPIO_ENABLE, gpio->base + LINGSI_SGPIO_CTRL);
+
+    raw_spin_lock_init(&gpio->lock);
+    gpio->chip.parent = &pdev->dev;
+    gpio->chip.ngpio = nr_gpios * 2;
+    gpio->chip.init_valid_mask = lingsi_sgpio_init_valid_mask;
+    gpio->chip.direction_input = lingsi_sgpio_dir_in;
+    gpio->chip.direction_output = lingsi_sgpio_dir_out;
+    gpio->chip.get_direction = lingsi_sgpio_get_direction;
+    gpio->chip.request = NULL;
+    gpio->chip.free = NULL;
+    gpio->chip.get = lingsi_sgpio_get;
+    gpio->chip.set = lingsi_sgpio_set;
+    gpio->chip.set_config = lingsi_sgpio_set_config;
+    gpio->chip.label = dev_name(&pdev->dev);
+    gpio->chip.base = -1;
+    lingsi_sgpio_setup_irqs(gpio, pdev);
+
+    rc = devm_gpiochip_add_data(&pdev->dev, &gpio->chip, gpio);
+    if (rc < 0)
+        return rc;
+
+    dev_info(dev, "initialized\n");
+    return 0;
+}
+
+static struct platform_driver lingsi_sgpio_driver = {
+    .driver = {
+        .name = KBUILD_MODNAME,
+        .of_match_table = lingsi_sgpio_of_table,
+    },
+};
+
+module_platform_driver_probe(lingsi_sgpio_driver, lingsi_sgpio_probe);
+MODULE_DESCRIPTION("Aspeed Serial GPIO Driver");
diff --git a/drivers/gpio/gpio-lingsi.c b/drivers/gpio/gpio-lingsi.c
new file mode 100644
index 000000000000..35783ee02f2a
--- /dev/null
+++ b/drivers/gpio/gpio-lingsi.c
@@ -0,0 +1,347 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// Copyright (C) 2024 linkedsemi
+//   Author: Hunter Liu <htliu@linkedsemi.com>
+
+#include <linux/bits.h>
+#include <linux/gpio/driver.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#define LINGSI_GPIO_IRQ_MAX_NUM       128
+#define LINGSI_GPIO_REG_SIZE_PER_BANK 0x20
+#define LINGSI_GPIO_PINS_PER_BANK     16
+
+#define LINGSI_GPIO_PORT(bank, line) \
+    ((LINGSI_GPIO_PINS_PER_BANK) * (bank) + (line))
+
+#define LINGSI_GPIO_LVS_LOCK 0x00
+#define LINGSI_GPIO_DOT      0x04
+#define LINGSI_GPIO_PD_PU    0x08
+#define LINGSI_GPIO_IEN_OD   0x0c
+#define LINGSI_GPIO_DS       0x10
+#define LINGSI_GPIO_AE       0x14
+#define LINGSI_GPIO_OE_FIR   0x18
+#define LINGSI_GPIO_HSS_DIN  0x1c
+
+struct lingsi_gpio_priv {
+    struct gpio_chip chip;
+    struct irq_chip irq_chip;
+    struct irq_domain *domain;
+    void __iomem *base;
+    spinlock_t lock;
+    u32 saved_vals[];
+};
+
+static inline uint32_t lingsi_gpio_pin(uint32_t gpio)
+{
+    return gpio % LINGSI_GPIO_PINS_PER_BANK;
+}
+
+static inline uint32_t lingsi_gpio_bank(uint32_t gpio)
+{
+    return gpio / LINGSI_GPIO_PINS_PER_BANK;
+}
+
+static inline uint32_t lingsi_gpio_bank_base(uint32_t bank)
+{
+    return bank * LINGSI_GPIO_REG_SIZE_PER_BANK;
+}
+
+static int lingsi_gpio_get_direction(struct gpio_chip *chip,
+                                     unsigned int offset)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+    if (reg & BIT(pin + LINGSI_GPIO_PINS_PER_BANK))
+        return GPIO_LINE_DIRECTION_OUT;
+
+    return GPIO_LINE_DIRECTION_IN;
+}
+
+static int lingsi_gpio_direction_input(struct gpio_chip *chip,
+                                       unsigned int offset)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+    reg &= ~(BIT(pin + LINGSI_GPIO_PINS_PER_BANK));
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+    reg &= ~(BIT(pin + LINGSI_GPIO_PINS_PER_BANK));
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+
+    return 0;
+}
+
+static int lingsi_gpio_direction_output(struct gpio_chip *chip,
+                                        unsigned int offset,
+                                        int val)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+    reg |= BIT(pin + LINGSI_GPIO_PINS_PER_BANK);
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+    reg |= BIT(pin + LINGSI_GPIO_PINS_PER_BANK);
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+
+    if (val) {
+        reg = BIT(pin);
+    } else {
+        reg = BIT(pin + LINGSI_GPIO_PINS_PER_BANK);
+    }
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_DOT);
+
+    return 0;
+}
+
+static int lingsi_gpio_get(struct gpio_chip *chip, unsigned int offset)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_HSS_DIN) & BIT(pin);
+    return !!reg;
+}
+
+static void lingsi_gpio_set(struct gpio_chip *chip,
+                            unsigned int offset,
+                            int val)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+
+    if (val) {
+        iowrite32(BIT(pin), priv->base + reg_offt + LINGSI_GPIO_DOT);
+    } else {
+        iowrite32(BIT(pin + LINGSI_GPIO_PINS_PER_BANK), priv->base + reg_offt + LINGSI_GPIO_DOT);
+    }
+}
+
+static int lingsi_gpio_to_irq(struct gpio_chip *chip, unsigned int offset)
+{
+    struct irq_fwspec fwspec;
+
+    if (offset > LINGSI_GPIO_IRQ_MAX_NUM)
+        return -ENXIO;
+
+    fwspec.fwnode = of_node_to_fwnode(chip->parent->of_node);
+    fwspec.param_count = 2;
+    fwspec.param[0] = offset;
+    /*
+     * IRQ_TYPE_NONE is rejected by the parent irq domain. Set LEVEL_HIGH
+     * temporarily. Anyway, ->irq_set_type() will override it later.
+     */
+    fwspec.param[1] = IRQ_TYPE_LEVEL_HIGH;
+
+    return irq_create_fwspec_mapping(&fwspec);
+}
+
+static int lingsi_gpio_irq_domain_translate(struct irq_domain *domain,
+                                            struct irq_fwspec *fwspec,
+                                            unsigned long *out_hwirq,
+                                            unsigned int *out_type)
+{
+    if (WARN_ON(fwspec->param_count < 2))
+        return -EINVAL;
+
+    *out_hwirq = fwspec->param[0];
+    *out_type = fwspec->param[1] & IRQ_TYPE_SENSE_MASK;
+
+    return 0;
+}
+
+static int lingsi_gpio_irq_domain_alloc(struct irq_domain *domain,
+                                        unsigned int virq,
+                                        unsigned int nr_irqs,
+                                        void *arg)
+{
+    struct lingsi_gpio_priv *priv = domain->host_data;
+    struct irq_fwspec *fwspec = arg;
+    struct irq_fwspec parent_fwspec;
+    irq_hw_number_t hwirq;
+    unsigned int type;
+    int ret;
+
+    if (WARN_ON(nr_irqs != 1))
+        return -EINVAL;
+
+    ret = lingsi_gpio_irq_domain_translate(domain, arg, &hwirq, &type);
+    if (ret)
+        return ret;
+
+    /* parent is lingsi exti_intc */
+    parent_fwspec.fwnode = domain->parent->fwnode;
+    parent_fwspec.param_count = 2;
+    parent_fwspec.param[0] = fwspec->param[0];
+    parent_fwspec.param[1] = fwspec->param[1];
+
+    ret = irq_domain_set_hwirq_and_chip(domain, virq, fwspec->param[0], &priv->irq_chip, priv);
+    if (ret)
+        return ret;
+
+    return irq_domain_alloc_irqs_parent(domain, virq, nr_irqs, &parent_fwspec);
+}
+
+static int lingsi_gpio_irq_domain_activate(struct irq_domain *domain,
+                                           struct irq_data *data,
+                                           bool early)
+{
+    struct lingsi_gpio_priv *priv = domain->host_data;
+    struct gpio_chip *chip = &priv->chip;
+
+    return gpiochip_lock_as_irq(chip, irqd_to_hwirq(data));
+}
+
+static void lingsi_gpio_irq_domain_deactivate(struct irq_domain *domain,
+                                              struct irq_data *data)
+{
+    struct lingsi_gpio_priv *priv = domain->host_data;
+    struct gpio_chip *chip = &priv->chip;
+
+    gpiochip_unlock_as_irq(chip, irqd_to_hwirq(data));
+}
+
+static const struct irq_domain_ops lingsi_gpio_irq_domain_ops = {
+    .alloc = lingsi_gpio_irq_domain_alloc,
+    .free = irq_domain_free_irqs_common,
+    .activate = lingsi_gpio_irq_domain_activate,
+    .deactivate = lingsi_gpio_irq_domain_deactivate,
+    .translate = lingsi_gpio_irq_domain_translate,
+};
+
+static unsigned int lingsi_gpio_get_nbanks(unsigned int ngpio)
+{
+    return DIV_ROUND_UP(ngpio, LINGSI_GPIO_PINS_PER_BANK);
+}
+
+static int lingsi_gpio_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct device_node *parent_np;
+    struct irq_domain *parent_domain;
+    struct lingsi_gpio_priv *priv;
+    struct gpio_chip *chip;
+    struct irq_chip *irq_chip;
+    unsigned int nregs;
+    u32 ngpios;
+    int ret;
+
+    parent_np = of_irq_find_parent(dev->of_node);
+    if (!parent_np)
+        return -ENXIO;
+
+    parent_domain = irq_find_host(parent_np);
+    of_node_put(parent_np);
+    if (!parent_domain)
+        return -EPROBE_DEFER;
+
+    ret = of_property_read_u32(dev->of_node, "ngpios", &ngpios);
+    if (ret)
+        return ret;
+
+    nregs = lingsi_gpio_get_nbanks(ngpios);
+    priv = devm_kzalloc(dev, struct_size(priv, saved_vals, nregs), GFP_KERNEL);
+    if (!priv)
+        return -ENOMEM;
+
+    priv->base = devm_platform_ioremap_resource(pdev, 0);
+    if (IS_ERR(priv->base))
+        return PTR_ERR(priv->base);
+
+    spin_lock_init(&priv->lock);
+
+    chip = &priv->chip;
+    chip->label = dev_name(dev);
+    chip->parent = dev;
+    chip->request = gpiochip_generic_request;
+    chip->free = gpiochip_generic_free;
+    chip->get_direction = lingsi_gpio_get_direction;
+    chip->direction_input = lingsi_gpio_direction_input;
+    chip->direction_output = lingsi_gpio_direction_output;
+    chip->get = lingsi_gpio_get;
+    chip->set = lingsi_gpio_set;
+    chip->to_irq = lingsi_gpio_to_irq;
+    chip->base = -1;
+    chip->ngpio = ngpios;
+
+    irq_chip = &priv->irq_chip;
+    irq_chip->name = dev_name(dev);
+    irq_chip->irq_eoi = irq_chip_eoi_parent;
+    irq_chip->irq_ack = irq_chip_ack_parent,
+    irq_chip->irq_mask = irq_chip_mask_parent;
+    irq_chip->irq_unmask = irq_chip_unmask_parent;
+    irq_chip->irq_set_affinity = irq_chip_set_affinity_parent;
+    irq_chip->irq_set_type = irq_chip_set_type_parent;
+
+    ret = devm_gpiochip_add_data(dev, chip, priv);
+    if (ret)
+        return ret;
+
+    priv->domain = irq_domain_create_hierarchy(
+        parent_domain, 0, LINGSI_GPIO_IRQ_MAX_NUM, of_node_to_fwnode(dev->of_node), &lingsi_gpio_irq_domain_ops, priv);
+    if (!priv->domain)
+        return -ENOMEM;
+
+    platform_set_drvdata(pdev, priv);
+
+    dev_info(dev, "initialized\n");
+    return 0;
+}
+
+static int lingsi_gpio_remove(struct platform_device *pdev)
+{
+    struct lingsi_gpio_priv *priv = platform_get_drvdata(pdev);
+
+    irq_domain_remove(priv->domain);
+
+    return 0;
+}
+
+static const struct of_device_id lingsi_gpio_match[] = {
+    { .compatible = "lingsi,gpio" },
+    { /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lingsi_gpio_match);
+
+static struct platform_driver lingsi_gpio_driver = {
+    .probe = lingsi_gpio_probe,
+    .remove = lingsi_gpio_remove,
+    .driver = {
+        .name = "lingsi-gpio",
+        .of_match_table = lingsi_gpio_match,
+    },
+};
+module_platform_driver(lingsi_gpio_driver);
+
+MODULE_AUTHOR("Hunter Liu <htliu@linkedsemi.com>");
+MODULE_DESCRIPTION("linkedsemi GPIO driver");
+MODULE_LICENSE("GPL v2");
