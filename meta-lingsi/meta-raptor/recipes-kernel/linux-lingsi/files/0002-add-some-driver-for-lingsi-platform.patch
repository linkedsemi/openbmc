+static const struct v4l2_file_operations lingsi_video_v4l2_fops = {
+    .owner = THIS_MODULE,
+    .read = vb2_fop_read,
+    .poll = vb2_fop_poll,
+    .unlocked_ioctl = video_ioctl2,
+    .mmap = vb2_fop_mmap,
+    .open = lingsi_video_open,
+    .release = lingsi_video_release,
+};
+
+static int lingsi_video_queue_setup(struct vb2_queue *q, unsigned int *num_buffers, unsigned int *num_planes, unsigned int sizes[], struct device *alloc_devs[])
+{
+    struct lingsi_video *video = vb2_get_drv_priv(q);
+
+    if (*num_planes) {
+        if (sizes[0] < video->max_compressed_size) {
+            return -EINVAL;
+        }
+
+        return 0;
+    }
+
+    *num_planes = 1;
+    sizes[0] = video->max_compressed_size;
+
+    return 0;
+}
+
+static int lingsi_video_buf_prepare(struct vb2_buffer *vb)
+{
+    struct lingsi_video *video = vb2_get_drv_priv(vb->vb2_queue);
+
+    if (vb2_plane_size(vb, 0) < video->max_compressed_size) {
+        return -EINVAL;
+    }
+
+    return 0;
+}
+
+static int lingsi_video_start_streaming(struct vb2_queue *q,
+                    unsigned int count)
+{
+    int rc;
+    struct lingsi_video *video = vb2_get_drv_priv(q);
+
+    video->sequence = 0;
+
+    rc = lingsi_video_start_frame(video);
+    if (rc) {
+        lingsi_video_bufs_done(video, VB2_BUF_STATE_QUEUED);
+        return rc;
+    }
+
+    set_bit(VIDEO_STREAMING, &video->flags);
+    return 0;
+}
+
+static void lingsi_video_stop_streaming(struct vb2_queue *q)
+{
+    int rc;
+    struct lingsi_video *video = vb2_get_drv_priv(q);
+
+    clear_bit(VIDEO_STREAMING, &video->flags);
+
+    rc = wait_event_timeout(video->wait,
+                !test_bit(VIDEO_FRAME_INPRG, &video->flags),
+                STOP_TIMEOUT);
+    if (!rc) {
+        dev_dbg(video->dev, "Timed out when stopping streaming\n");
+
+        /*
+         * Need to force stop any DMA and try and get HW into a good
+         * state for future callingsi to start streaming again.
+         */
+        lingsi_video_off(video);
+        lingsi_video_on(video);
+
+        // lingsi_video_init_regs(video);
+
+        lingsi_video_get_resolution(video);
+    }
+
+    lingsi_video_bufs_done(video, VB2_BUF_STATE_ERROR);
+
+    /* Stop all pending DMA operations */
+    mutex_lock(&video->dma_lock);
+
+    dmaengine_terminate_sync(video->dma_chan);
+    mutex_unlock(&video->dma_lock);
+}
+
+static void lingsi_video_buf_queue(struct vb2_buffer *vb)
+{
+    bool empty;
+    struct lingsi_video *video = vb2_get_drv_priv(vb->vb2_queue);
+    struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+    struct lingsi_video_buffer *avb = to_lingsi_video_buffer(vbuf);
+    unsigned long flags;
+
+    spin_lock_irqsave(&video->lock, flags);
+
+    empty = list_empty(&video->buffers);
+    list_add_tail(&avb->link, &video->buffers);
+    spin_unlock_irqrestore(&video->lock, flags);
+
+    if (test_bit(VIDEO_STREAMING, &video->flags) &&
+        !test_bit(VIDEO_FRAME_INPRG, &video->flags) && empty) {
+        lingsi_video_start_frame(video);
+    }
+}
