+#define ESPI_PC_RX_BUF_OFFSET 0x900
+#define ESPI_PC_TX_BUF_OFFSET 0xa00
+#define ESPI_VW_TX_BUF_OFFSET 0xb00
+
+static inline u8 *np_rx_buf_get(void __iomem *base)
+{
+    return base + ESPI_NP_RX_BUF_OFFSET;
+}
+
+static inline u8 *pc_rx_buf_get(void __iomem *base)
+{
+    return base + ESPI_PC_RX_BUF_OFFSET;
+}
+
+static inline u8 *pc_tx_buf_get(void __iomem *base)
+{
+    return base + ESPI_PC_TX_BUF_OFFSET;
+}
+
+static inline u8 *vw_tx_buf_get(void __iomem *base)
+{
+    return base + ESPI_VW_TX_BUF_OFFSET;
+}
+
+static void espi_vw_tx(struct lingsi_espi_lpc_struct *espi, u8 count, u8 idx, u8 val, ...)
+{
+    unsigned long flags;
+    va_list vargs;
+    u32 espi_stat;
+    u32 vw_first_word = val << 16 | idx << 8 | (count - 1);
+    u8 *vw_tx = vw_tx_buf_get(espi->base);
+    spin_lock_irqsave(&espi->u.espi.vw_tx_lock, flags);
+    do {
+        espi_stat = ioread32(espi->base + ESPI_STATUS);
+    } while (espi_stat & ESPI_SET_VWIRE_AVAIL);
+    iowrite32(count * 2, espi->base + ESPI_UP_VWIR_LEN_M1);
+    count--;
+    va_start(vargs, val);
+    if (count > 0) {
+        idx = va_arg(vargs, unsigned);
+        val = va_arg(vargs, unsigned);
+        vw_first_word |= idx << 24;
+        *vw_tx++ = val;
+        count--;
+    }
+    while (count--) {
+        idx = va_arg(vargs, unsigned);
+        val = va_arg(vargs, unsigned);
+        *vw_tx++ = idx;
+        *vw_tx++ = val;
+    }
+    va_end(vargs);
+    iowrite32(vw_first_word, espi->base + ESPI_UP_VWIR_DAT);
+    iowrite32(ESPI_ALERT_SET | ESPI_SET_VWIRE_AVAIL, espi->base + ESPI_STATUS_SET);
+    spin_unlock_irqrestore(&espi->u.espi.vw_tx_lock, flags);
+}
+
+static void espi_send_boot_done(struct lingsi_espi_lpc_struct *espi)
+{
+    espi_vw_tx(espi, 1, 5, ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_DONE_VLD | ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_DONE | ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_STATUS_VLD | ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_STATUS);
+}
+
+static void espi_send_oob_rst_ack(struct lingsi_espi_lpc_struct *espi)
+{
+    espi_vw_tx(espi, 1, 4, ESPI_SYS_EVT_4_OOB_RST_ACK_VLD | ESPI_SYS_EVT_4_OOB_RST_ACK);
+}
+
+static void espi_send_host_rst_ack(struct lingsi_espi_lpc_struct *espi)
+{
+    espi_vw_tx(espi, 1, 6, ESPI_SYS_EVT_6_HOST_RST_ACK_VLD | ESPI_SYS_EVT_6_HOST_RST_ACK);
+}
+
+static void espi_send_edge_int_evt(struct lingsi_espi_lpc_struct *espi, u8 idx)
+{
+    espi_vw_tx(espi, 2, idx & 0x80 ? 1 : 0, 1 << 7 | (idx & 0x7f), idx & 0x80 ? 1 : 0, idx & 0x7f);
+}
+
+static void espi_send_level_int_evt(struct lingsi_espi_lpc_struct *espi, u8 idx, u8 active)
+{
+    espi_vw_tx(espi, 1, idx & 0x80 ? 1 : 0, active << 7 | (idx & 0x7f));
+}
+
+static void mem_io_rd_rsp_pkt_build(u8 len, u32 data, u8 *up_data_buf, u32 *up_first_word, u16 *up_len)
+{
+    *up_first_word = 0x0f | len << 16 | (data & 0xff) << 24;
+    *up_len = 3 + len;
+    up_data_buf[0] = data >> 8;
+    up_data_buf[1] = data >> 16;
+    up_data_buf[2] = data >> 24;
+}
+
+static irqreturn_t lingsi_espi_irq(int irq, void *arg)
+{
+    struct lingsi_espi_lpc_struct *espi = arg;
+    unsigned int_stt = ioread32(espi->base + ESPI_INT_STT);
+    if (int_stt & ESPI_INT_NPST_FREE) {
+        u8 *rx = np_rx_buf_get(espi->base);
+        u8 opcode = rx[0];
+        iowrite32(ESPI_INT_NPST_FREE, espi->base + ESPI_INT_CLR);
+        if ((opcode & ~0xf) == 0x40) {
+            u32 up_first_word = 0;
+            u16 up_len = 1;
+            u8 len = (opcode & 0x3) + 1;
+            u8 *up_data_remain = pc_tx_buf_get(espi->base);
+            u32 res;
+            if (opcode & 0x8) //PUT_MEMRD32_SHORT
+            {
+                u32 addr = rx[1] << 24 | rx[2] << 16 | rx[3] << 8 | rx[4];
+                BUG_ON(opcode & 0x4);
+                memrd_short(espi, len, addr, &res);
+                mem_io_rd_rsp_pkt_build(len, res, up_data_remain, &up_first_word, &up_len);
+            } else {
+                u16 addr = rx[1] << 8 | rx[2];
+                if (opcode & 0x4) //PUT_IOWR_SHORT
+                {
+                    iowr_short(espi, len, addr, &rx[3]);
+                    up_first_word = 6;
+                    up_len = 3;
+                } else //PUT_IORD_SHORT
+                {
+                    iord_short(espi, len, addr, &res);
+                    mem_io_rd_rsp_pkt_build(len, res, up_data_remain, &up_first_word, &up_len);
+                }
+            }
+            iowrite32(up_first_word, espi->base + ESPI_UP_PSTC_DAT);
+            iowrite32(up_len - 1, espi->base + ESPI_UP_PSTC_LEN_M1);
+        }
+        iowrite32(ESPI_ALERT_SET | ESPI_SET_PERI_PC_AVAIL | ESPI_SET_PERI_NP_FREE, espi->base + ESPI_STATUS_SET);
+    }
+    if (int_stt & ESPI_INT_PSTC_FREE) {
+        u8 *rx = pc_rx_buf_get(espi->base);
+        u8 opcode = rx[0];
+        iowrite32(ESPI_INT_PSTC_FREE, espi->base + ESPI_INT_CLR);
+        if ((opcode & ~0x3) == 0x4c) //PUT_MEMWR32_SHORT
+        {
+            u8 len = (opcode & 0x3) + 1;
+            u32 addr = rx[1] << 24 | rx[2] << 16 | rx[3] << 8 | rx[4];
+            memwr_short(espi, len, addr, &rx[5]);
+        }
+
+        iowrite32(ESPI_SET_PERI_PC_FREE, espi->base + ESPI_STATUS_SET);
+    }
+    if (int_stt & ESPI_INT_DN_VWIR_S02) {
+        u32 dn_vwir_sys0 = ioread32(espi->base + ESPI_DN_VWIR_SYS0);
+        u8 s02 = dn_vwir_sys0 >> 16 & 0xf;
+        espi->u.espi.slp_s3_n = s02 & ESPI_SYS_EVT_2_SLP_S3_N ? 1 : 0;
+        espi->u.espi.slp_s4_n = s02 & ESPI_SYS_EVT_2_SLP_S4_N ? 1 : 0;
+        espi->u.espi.slp_s5_n = s02 & ESPI_SYS_EVT_2_SLP_S5_N ? 1 : 0;
+        iowrite32(ESPI_INT_DN_VWIR_S02, espi->base + ESPI_INT_CLR);
+    }
+    if (int_stt & ESPI_INT_DN_VWIR_S03) {
+        u32 dn_vwir_sys0 = ioread32(espi->base + ESPI_DN_VWIR_SYS0);
+        u8 s03 = dn_vwir_sys0 >> 24 & 0xf;
+        if (s03 & ESPI_SYS_EVT_3_OOB_RST_WARN) {
+            espi_send_oob_rst_ack(espi);
+        }
+        espi->u.espi.pltrst_n = s03 & ESPI_SYS_EVT_3_PLTRST_N ? 1 : 0;
+        espi->u.espi.sus_stat_n = s03 & ESPI_SYS_EVT_3_SUS_STAT_N ? 1 : 0;
+        iowrite32(ESPI_INT_DN_VWIR_S03, espi->base + ESPI_INT_CLR);
+    }
+    if (int_stt & ESPI_INT_DN_VWIR_S07) {
+        u32 dn_vwir_sys1 = ioread32(espi->base + ESPI_DN_VWIR_SYS1);
+        u8 s07 = dn_vwir_sys1 >> 24 & 0xf;
+        if (s07 & ESPI_SYS_EVT_7_HOST_RST_WARN) {
+            espi_send_host_rst_ack(espi);
+        }
+        espi->u.espi.nmiout_n = s07 & ESPI_SYS_EVT_7_NMIOUT_N ? 1 : 0;
+        espi->u.espi.smiout_n = s07 & ESPI_SYS_EVT_7_SMIOUT_N ? 1 : 0;
+        iowrite32(ESPI_INT_DN_VWIR_S07, espi->base + ESPI_INT_CLR);
+    }
+    if (int_stt & ESPI_INT_DN_RESET) {
+        while (1)
+            ;
+    }
+    return IRQ_HANDLED;
+}
+
+static void espi_reg_init(void __iomem *base)
+{
+    iowrite32(0x0 << ESPI_IO_MODE_SUPP_SHIFT | 0 << ESPI_OP_FREQ_SUPP_SHIFT | 0xf << ESPI_CH_SUPP_SHIFT, base + ESPI_GEN_CFG);
+    iowrite32(0x1 << ESPI_PER_MAX_PLOAD_SUPP_SHIFT | ESPI_PER_CH_RDY, base + ESPI_CH0_CFG);
+    iowrite32(0x1f << ESPI_VWIR_MAX_CNT_SUPP_SHIFT | ESPI_VWIR_CH_RDY, base + ESPI_CH1_CFG);
+    iowrite32(0x1 << ESPI_OOB_MAX_PLOAD_SUPP_SHIFT | ESPI_OOB_CH_RDY, base + ESPI_CH2_CFG);
+    iowrite32(0x3 << ESPI_FLINGSI_SHARE_SUPP_SHIFT | 0x1 << ESPI_FLINGSI_MAX_PLOAD_SUPP_SHIFT | ESPI_FLINGSI_CH_RDY, base + ESPI_CH3_CFG);
+
+    iowrite32(ESPI_ALERT_CLEAR | ESPI_SET_VWIRE_FREE | ESPI_SET_OOB_FREE
+                  | ESPI_SET_PERI_NP_FREE | ESPI_SET_PERI_PC_FREE
+                  | ESPI_SET_FLASH_C_FREE | ESPI_SET_FLASH_NP_FREE,
+              base + ESPI_STATUS_SET);
+    iowrite32(ESPI_NP_RX_BUF_OFFSET, base + ESPI_DN_NPST_ADR);
+    iowrite32(ESPI_PC_RX_BUF_OFFSET, base + ESPI_DN_PSTC_ADR);
+    iowrite32(ESPI_PC_TX_BUF_OFFSET, base + ESPI_UP_PSTC_ADR);
+    iowrite32(ESPI_VW_TX_BUF_OFFSET, base + ESPI_UP_VWIR_ADR);
+    iowrite32(ESPI_INT_DN_RESET | ESPI_INT_PSTC_FREE | ESPI_INT_NPST_FREE | ESPI_INT_DN_VWIR_S02 | ESPI_INT_DN_VWIR_S03 | ESPI_INT_DN_VWIR_S07, base + ESPI_INT_CLR);
+    iowrite32(ESPI_INT_DN_RESET | ESPI_INT_PSTC_FREE | ESPI_INT_NPST_FREE | ESPI_INT_DN_VWIR_S02 | ESPI_INT_DN_VWIR_S03 | ESPI_INT_DN_VWIR_S07, base + ESPI_INT_MASK);
+}
+
+static int lingsi_espi_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct lingsi_espi_lpc_struct *priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+    struct resource *res;
+    int irq, rc;
+    if (!priv)
+        return -ENOMEM;
+
+    priv->u.espi.slp_s3_n = 1;
+    priv->u.espi.slp_s4_n = 1;
+    priv->u.espi.slp_s5_n = 1;
+    priv->u.espi.pltrst_n = 1;
+    priv->u.espi.sus_stat_n = 1;
+    priv->u.espi.nmiout_n = 1;
+    priv->u.espi.smiout_n = 1;
+    priv->raise_edge_irq = espi_send_edge_int_evt;
+    priv->set_level_irq = espi_send_level_int_evt;
+
+    res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+    if (!res) {
+        dev_err(dev, "cannot get resource\n");
+        return -ENODEV;
+    }
+    priv->base = devm_ioremap_resource(dev, res);
+    if (IS_ERR(priv->base)) {
+        dev_err(dev, "cannot map registers\n");
+        return PTR_ERR(priv->base);
+    }
+    irq = platform_get_irq(pdev, 0);
+    if (irq < 0) {
+        dev_err(dev, "cannot get irq\n");
+        return irq;
+    }
+    rc = devm_request_irq(dev, irq, lingsi_espi_irq, IRQF_SHARED, dev_name(dev), priv);
+    if (rc < 0) {
+        dev_err(dev, "cannot request irq\n");
+        return rc;
+    }
+
+    INIT_LIST_HEAD(&priv->peri_io_list);
+    INIT_LIST_HEAD(&priv->peri_mem_list);
+
+    spin_lock_init(&priv->u.espi.vw_tx_lock);
+    platform_set_drvdata(pdev, priv);
+
+    espi_reg_init(priv->base);
+    espi_send_boot_done(priv);
+
+    return 0;
+}
+
+static int lingsi_espi_remove(struct platform_device *pdev)
+{
+    return 0;
+}
+
+static const struct of_device_id lingsi_espi_match[] = {
+    { .compatible = "lingsi,espi" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, lingsi_espi_match);
+
+static struct platform_driver lingsi_espi_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .of_match_table = lingsi_espi_match,
+    },
+    .probe = lingsi_espi_probe,
+    .remove = lingsi_espi_remove,
+};
+module_platform_driver(lingsi_espi_driver);
+
+MODULE_LICENSE("GPL");
diff --git a/drivers/char/ipmi/lingsi/lingsi_espi_lpc_common.c b/drivers/char/ipmi/lingsi/lingsi_espi_lpc_common.c
new file mode 100644
index 000000000000..638298d27d2c
--- /dev/null
+++ b/drivers/char/ipmi/lingsi/lingsi_espi_lpc_common.c
@@ -0,0 +1,106 @@
+#include <linux/module.h>
+#include <linux/init.h>
+#include "lingsi_espi_lpc_common.h"
+
+void espi_lpc_add_ioport(struct lingsi_espi_lpc_struct *peri, struct lingsi_peri_ioport *ioport, void (*io_read)(struct lingsi_peri_ioport *, u8, void *), void (*io_write)(struct lingsi_peri_ioport *, u8, u8 *), u16 addr, void *ctx)
+{
+    ioport->io_read = io_read;
+    ioport->io_write = io_write;
+    ioport->addr = addr;
+    ioport->ctx = ctx;
+    list_add(&ioport->head, &peri->peri_io_list);
+}
+EXPORT_SYMBOL(espi_lpc_add_ioport);
+
+void espi_lpc_remove_ioport(struct lingsi_peri_ioport *ioport)
+{
+    list_del(&ioport->head);
+}
+EXPORT_SYMBOL(espi_lpc_remove_ioport);
+
+void espi_lpc_add_mem(struct lingsi_espi_lpc_struct *peri, struct lingsi_peri_mem *mem, bool (*mem_read)(struct lingsi_peri_mem *, u32, u8, void *), bool (*mem_write)(struct lingsi_peri_mem *, u32, u8, u8 *), void *ctx)
+{
+    mem->mem_read = mem_read;
+    mem->mem_write = mem_write;
+    mem->ctx = ctx;
+    list_add(&mem->head, &peri->peri_mem_list);
+}
+EXPORT_SYMBOL(espi_lpc_add_mem);
+
+void espi_lpc_remove_mem(struct lingsi_peri_mem *mem)
+{
+    list_del(&mem->head);
+}
+EXPORT_SYMBOL(espi_lpc_remove_mem);
+
+void espi_lpc_raise_edge_irq(struct lingsi_espi_lpc_struct *espi, u8 idx)
+{
+    espi->raise_edge_irq(espi, idx);
+}
+EXPORT_SYMBOL(espi_lpc_raise_edge_irq);
+
+void espi_lpc_set_level_irq(struct lingsi_espi_lpc_struct *espi, u8 idx, u8 active)
+{
+    espi->set_level_irq(espi, idx, active);
+}
+EXPORT_SYMBOL(espi_lpc_set_level_irq);
+
+bool iord_short(struct lingsi_espi_lpc_struct *espi, u8 size, u16 addr, void *res)
+{
+    struct list_head *ptr;
+    list_for_each(ptr, &espi->peri_io_list)
+    {
+        struct lingsi_peri_ioport *io = list_entry(ptr, struct lingsi_peri_ioport, head);
+        if (addr == io->addr) {
+            io->io_read(io, size, res);
+            return true;
+        }
+    }
+    return false;
+}
+EXPORT_SYMBOL(iord_short);
+
+bool iowr_short(struct lingsi_espi_lpc_struct *espi, u8 size, u16 addr, u8 *data)
+{
+    struct list_head *ptr;
+    list_for_each(ptr, &espi->peri_io_list)
+    {
+        struct lingsi_peri_ioport *io = list_entry(ptr, struct lingsi_peri_ioport, head);
+        if (addr == io->addr) {
+            io->io_write(io, size, data);
+            return true;
+        }
+    }
+    return false;
+}
+EXPORT_SYMBOL(iowr_short);
+
+bool memwr_short(struct lingsi_espi_lpc_struct *espi, u8 size, u32 addr, u8 *data)
+{
+    struct list_head *ptr;
+    list_for_each(ptr, &espi->peri_mem_list)
+    {
+        struct lingsi_peri_mem *mem = list_entry(ptr, struct lingsi_peri_mem, head);
+        if (mem->mem_write(mem, addr, size, data)) {
+            return true;
+        }
+    }
+    return false;
+}
+EXPORT_SYMBOL(memwr_short);
+
+bool memrd_short(struct lingsi_espi_lpc_struct *espi, u8 size, u32 addr, void *res)
+{
+    struct list_head *ptr;
+    list_for_each(ptr, &espi->peri_mem_list)
+    {
+        struct lingsi_peri_mem *mem = list_entry(ptr, struct lingsi_peri_mem, head);
+        if (mem->mem_read(mem, addr, size, res)) {
+            return true;
+        }
+    }
+    return false;
+}
+EXPORT_SYMBOL(memrd_short);
+
+MODULE_LICENSE("GPL");
