diff --git a/drivers/char/ipmi/lingsi/lingsi_espi_lpc_common.h b/drivers/char/ipmi/lingsi/lingsi_espi_lpc_common.h
new file mode 100644
index 000000000000..d88135d6bf2b
--- /dev/null
+++ b/drivers/char/ipmi/lingsi/lingsi_espi_lpc_common.h
@@ -0,0 +1,67 @@
+#ifndef LINGSI_ESPI_LPC_COMMON_H
+#define LINGSI_ESPI_LPC_COMMON_H
+#include <linux/list.h>
+#include <linux/io.h>
+#include <linux/atomic.h>
+struct lingsi_peri_ioport {
+    struct list_head head;
+    void (*io_read)(struct lingsi_peri_ioport *ioport, u8 size, void *res);
+    void (*io_write)(struct lingsi_peri_ioport *ioport, u8 size, u8 *data);
+    void *ctx;
+    u16 addr;
+};
+
+struct lingsi_peri_mem {
+    struct list_head head;
+    bool (*mem_read)(struct lingsi_peri_mem *mem, u32 addr, u8 size, void *res);
+    bool (*mem_write)(struct lingsi_peri_mem *mem, u32 addr, u8 size, u8 *data);
+    void *ctx;
+};
+
+struct lingsi_upstream_irq {
+    u32 id;
+    u32 type;
+};
+
+struct lingsi_host_reg {
+    u32 base;
+    u32 range;
+};
+
+struct lingsi_espi_lpc_struct {
+    void __iomem *base;
+    struct list_head peri_io_list;
+    struct list_head peri_mem_list;
+    void (*raise_edge_irq)(struct lingsi_espi_lpc_struct *, u8);
+    void (*set_level_irq)(struct lingsi_espi_lpc_struct *, u8, u8);
+    union {
+        struct {
+            spinlock_t vw_tx_lock;
+            u8 slp_s3_n : 1,
+                slp_s4_n : 1,
+                slp_s5_n : 1,
+                pltrst_n : 1,
+                sus_stat_n : 1,
+                nmiout_n : 1,
+                smiout_n : 1;
+        } espi;
+        struct {
+            spinlock_t serirq_src_lock;
+            spinlock_t int_msk_lock;
+            u32 serirq_edge_mask;
+        } lpc;
+    } u;
+};
+
+bool iord_short(struct lingsi_espi_lpc_struct *espi, u8 size, u16 addr, void *res);
+bool iowr_short(struct lingsi_espi_lpc_struct *espi, u8 size, u16 addr, u8 *data);
+bool memwr_short(struct lingsi_espi_lpc_struct *espi, u8 size, u32 addr, u8 *data);
+bool memrd_short(struct lingsi_espi_lpc_struct *espi, u8 size, u32 addr, void *res);
+void espi_lpc_raise_edge_irq(struct lingsi_espi_lpc_struct *espi, u8 idx);
+void espi_lpc_set_level_irq(struct lingsi_espi_lpc_struct *espi, u8 idx, u8 active);
+void espi_lpc_add_ioport(struct lingsi_espi_lpc_struct *peri, struct lingsi_peri_ioport *ioport, void (*io_read)(struct lingsi_peri_ioport *, u8, void *), void (*io_write)(struct lingsi_peri_ioport *, u8, u8 *), u16 addr, void *ctx);
+void espi_lpc_remove_ioport(struct lingsi_peri_ioport *ioport);
+void espi_lpc_add_mem(struct lingsi_espi_lpc_struct *peri, struct lingsi_peri_mem *mem, bool (*mem_read)(struct lingsi_peri_mem *, u32, u8, void *), bool (*mem_write)(struct lingsi_peri_mem *, u32, u8, u8 *), void *ctx);
+void espi_lpc_remove_mem(struct lingsi_peri_mem *mem);
+
+#endif
