diff --git a/drivers/char/ipmi/lingsi/lingsi_kcs.c b/drivers/char/ipmi/lingsi/lingsi_kcs.c
new file mode 100644
index 000000000000..b5074dd55fe5
--- /dev/null
+++ b/drivers/char/ipmi/lingsi/lingsi_kcs.c
@@ -0,0 +1,304 @@
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+#include <linux/irq.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/syscon.h>
+#include <linux/atomic.h>
+#include <linux/of_platform.h>
+#include "../kcs_bmc_device.h"
+#include "lingsi_espi_lpc_common.h"
+#define DEVICE_NAME "lingsi-kcs-bmc"
+
+#define IDR 0x10
+#define ODR 0x14
+#define STR 0x18
+
+struct kcs_regs {
+    spinlock_t lock;
+    uint8_t status;
+    uint8_t data_out;
+    uint8_t data_in;
+};
+
+struct lingsi_kcs_bmc {
+    struct kcs_bmc_device kcs_bmc;
+    struct lingsi_espi_lpc_struct *parent;
+    struct lingsi_peri_ioport io_data;
+    struct lingsi_peri_ioport io_cmd_stt;
+    struct lingsi_upstream_irq up_irq;
+    struct kcs_regs reg;
+    u8 event_mask;
+};
+
+static inline struct lingsi_kcs_bmc *to_lingsi_kcs_bmc(struct kcs_bmc_device *kcs_bmc)
+{
+    return container_of(kcs_bmc, struct lingsi_kcs_bmc, kcs_bmc);
+}
+
+static u8 lingsi_kcs_inb(struct kcs_bmc_device *kcs_bmc, u32 reg)
+{
+    struct lingsi_kcs_bmc *lingsi_kcs = to_lingsi_kcs_bmc(kcs_bmc);
+    unsigned long flags;
+    u8 ret = 0;
+    if (reg == IDR) {
+        spin_lock_irqsave(&lingsi_kcs->reg.lock, flags);
+        lingsi_kcs->reg.status &= ~KCS_BMC_STR_IBF;
+        ret = lingsi_kcs->reg.data_in;
+        spin_unlock_irqrestore(&lingsi_kcs->reg.lock, flags);
+    } else if (reg == STR) {
+        ret = lingsi_kcs->reg.status;
+    } else {
+        dev_err(kcs_bmc->dev, "lingsi_kcs_inb error\n");
+        while (1)
+            ;
+    }
+    return ret;
+}
+
+static void lingsi_kcs_outb(struct kcs_bmc_device *kcs_bmc, u32 reg, u8 data)
+{
+    struct lingsi_kcs_bmc *lingsi_kcs = to_lingsi_kcs_bmc(kcs_bmc);
+    unsigned long flags;
+    if (reg == ODR) {
+        spin_lock_irqsave(&lingsi_kcs->reg.lock, flags);
+        lingsi_kcs->reg.status |= KCS_BMC_STR_OBF;
+        lingsi_kcs->reg.data_out = data;
+        spin_unlock_irqrestore(&lingsi_kcs->reg.lock, flags);
+        if (lingsi_kcs->up_irq.type & IRQ_TYPE_EDGE_BOTH) {
+            espi_lpc_raise_edge_irq(lingsi_kcs->parent, lingsi_kcs->up_irq.id);
+        } else if (lingsi_kcs->up_irq.type & IRQ_TYPE_LEVEL_MASK) {
+            espi_lpc_set_level_irq(lingsi_kcs->parent, lingsi_kcs->up_irq.id, 1);
+        }
+    } else {
+        dev_err(kcs_bmc->dev, "lingsi_kcs_outb error\n");
+        while (1)
+            ;
+    }
+}
+
+static void lingsi_kcs_updateb(struct kcs_bmc_device *kcs_bmc, u32 reg, u8 mask, u8 data)
+{
+    struct lingsi_kcs_bmc *lingsi_kcs = to_lingsi_kcs_bmc(kcs_bmc);
+    unsigned long flags;
+    if (reg == STR) {
+        spin_lock_irqsave(&lingsi_kcs->reg.lock, flags);
+        lingsi_kcs->reg.status = (lingsi_kcs->reg.status & ~mask) | data;
+        spin_unlock_irqrestore(&lingsi_kcs->reg.lock, flags);
+    } else {
+        dev_err(kcs_bmc->dev, "lingsi_kcs_updateb error\n");
+        while (1)
+            ;
+    }
+}
+
+static void lingsi_kcs_irq_mask_update(struct kcs_bmc_device *kcs_bmc, u8 mask, u8 state)
+{
+    struct lingsi_kcs_bmc *lingsi_kcs = to_lingsi_kcs_bmc(kcs_bmc);
+    lingsi_kcs->event_mask = (lingsi_kcs->event_mask & ~mask) | state;
+}
+
+static const struct kcs_bmc_device_ops lingsi_kcs_ops = {
+    .irq_mask_update = lingsi_kcs_irq_mask_update,
+    .io_inputb = lingsi_kcs_inb,
+    .io_outputb = lingsi_kcs_outb,
+    .io_updateb = lingsi_kcs_updateb,
+};
+
+static int lingsi_kcs_of_get_channel(struct platform_device *pdev)
+{
+    struct device_node *np;
+    u32 channel;
+    int rc;
+
+    np = pdev->dev.of_node;
+
+    rc = of_property_read_u32(np, "kcs_chan", &channel);
+    if ((rc != 0) || channel == 0) {
+        dev_err(&pdev->dev, "no valid 'kcs_chan' configured\n");
+        return -EINVAL;
+    }
+
+    return channel;
+}
+
+static int lingsi_kcs_of_get_io_address(struct platform_device *pdev, u32 addrs[2])
+{
+    int rc;
+
+    rc = of_property_read_u32(pdev->dev.of_node, "kcs_addr", addrs);
+    if (rc || addrs[0] > 0xffff) {
+        dev_err(&pdev->dev, "no valid 'kcs_addr' configured\n");
+        return -EINVAL;
+    }
+    addrs[1] = addrs[0] + 1;
+    return 2;
+}
+
+static void data_cmd_stt_iowr(struct lingsi_kcs_bmc *lingsi_kcs, u8 size, u8 *data, bool is_data)
+{
+    unsigned long flags;
+    spin_lock_irqsave(&lingsi_kcs->reg.lock, flags);
+    lingsi_kcs->reg.data_in = data[0];
+    lingsi_kcs->reg.status |= KCS_BMC_STR_IBF;
+    if (is_data) {
+        lingsi_kcs->reg.status &= ~KCS_BMC_STR_CMD_DAT;
+    } else {
+        lingsi_kcs->reg.status |= KCS_BMC_STR_CMD_DAT;
+    }
+    spin_unlock_irqrestore(&lingsi_kcs->reg.lock, flags);
+    if (lingsi_kcs->event_mask & KCS_BMC_EVENT_TYPE_IBF) {
+        kcs_bmc_handle_event(&lingsi_kcs->kcs_bmc);
+    }
+}
+
+static void data_io_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    u8 *val = res;
+    struct lingsi_kcs_bmc *lingsi_kcs = ioport->ctx;
+    unsigned long flags;
+    spin_lock_irqsave(&lingsi_kcs->reg.lock, flags);
+    *val = lingsi_kcs->reg.data_out;
+    lingsi_kcs->reg.status &= ~KCS_BMC_STR_OBF;
+    spin_unlock_irqrestore(&lingsi_kcs->reg.lock, flags);
+    if (lingsi_kcs->up_irq.type & IRQ_TYPE_LEVEL_MASK) {
+        espi_lpc_set_level_irq(lingsi_kcs->parent, lingsi_kcs->up_irq.id, 0);
+    }
+    if (lingsi_kcs->event_mask & KCS_BMC_EVENT_TYPE_OBE) {
+        kcs_bmc_handle_event(&lingsi_kcs->kcs_bmc);
+    }
+}
+
+static void data_io_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_kcs_bmc *lingsi_kcs = ioport->ctx;
+    data_cmd_stt_iowr(lingsi_kcs, size, data, true);
+}
+
+static void cmd_stt_io_read(struct lingsi_peri_ioport *ioport, u8 size, void *res)
+{
+    struct lingsi_kcs_bmc *lingsi_kcs = ioport->ctx;
+    unsigned long flags;
+    u8 *val = res;
+    spin_lock_irqsave(&lingsi_kcs->reg.lock, flags);
+    *val = lingsi_kcs->reg.status;
+    spin_unlock_irqrestore(&lingsi_kcs->reg.lock, flags);
+}
+
+static void cmd_stt_io_write(struct lingsi_peri_ioport *ioport, u8 size, u8 *data)
+{
+    struct lingsi_kcs_bmc *lingsi_kcs = ioport->ctx;
+    data_cmd_stt_iowr(lingsi_kcs, size, data, false);
+}
+
+static int lingsi_kcs_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct lingsi_kcs_bmc *priv;
+    struct kcs_bmc_device *kcs_bmc;
+    struct platform_device *parent_pdev;
+    struct lingsi_espi_lpc_struct *espi_lpc;
+    u32 addrs[2], chan;
+    int nr_addrs;
+    int rc;
+
+    struct device_node *parent = of_get_parent(dev->of_node);
+    if (!parent) {
+        dev_err(dev, "cannot get parent node\n");
+        return -ENODEV;
+    }
+    parent_pdev = of_find_device_by_node(parent);
+    if (!parent_pdev) {
+        dev_err(dev, "cannot get parent device\n");
+        return -ENODEV;
+    }
+    espi_lpc = platform_get_drvdata(parent_pdev);
+    if (!espi_lpc) {
+        dev_err(dev, "espi lpc not inited\n");
+        return -EPROBE_DEFER;
+    }
+
+    priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+    if (!priv)
+        return -ENOMEM;
+    priv->parent = espi_lpc;
+
+    chan = lingsi_kcs_of_get_channel(pdev);
+    if (chan < 0)
+        return chan;
+
+    nr_addrs = lingsi_kcs_of_get_io_address(pdev, addrs);
+    if (nr_addrs < 0)
+        return nr_addrs;
+
+    rc = of_property_read_u32_array(pdev->dev.of_node, "kcs_upstream_irq", (u32 *)&priv->up_irq, 2);
+    if (rc) {
+        priv->up_irq.type = IRQ_TYPE_NONE;
+    }
+
+    espi_lpc_add_ioport(espi_lpc, &priv->io_data, data_io_read, data_io_write, addrs[0], priv);
+
+    espi_lpc_add_ioport(espi_lpc, &priv->io_cmd_stt, cmd_stt_io_read, cmd_stt_io_write, addrs[1], priv);
+
+    spin_lock_init(&priv->reg.lock);
+
+    kcs_bmc = &priv->kcs_bmc;
+    kcs_bmc->dev = &pdev->dev;
+    kcs_bmc->channel = chan;
+    kcs_bmc->ioreg.idr = IDR;
+    kcs_bmc->ioreg.odr = ODR;
+    kcs_bmc->ioreg.str = STR;
+    kcs_bmc->ops = &lingsi_kcs_ops;
+
+    platform_set_drvdata(pdev, priv);
+
+    // npcm7xx_kcs_irq_mask_update(kcs_bmc, (KCS_BMC_EVENT_TYPE_IBF | KCS_BMC_EVENT_TYPE_OBE), 0);
+    // npcm7xx_kcs_enable_channel(kcs_bmc, true);
+
+    rc = kcs_bmc_add_device(kcs_bmc);
+    if (rc) {
+        dev_warn(&pdev->dev, "Failed to register channel %d: %d\n", kcs_bmc->channel, rc);
+        return rc;
+    }
+
+    // pr_info("channel=%u idr=0x%x odr=0x%x str=0x%x\n",
+    // 	chan,
+    // 	kcs_bmc->ioreg.idr, kcs_bmc->ioreg.odr, kcs_bmc->ioreg.str);
+
+    return 0;
+}
+
+static int lingsi_kcs_remove(struct platform_device *pdev)
+{
+    struct lingsi_kcs_bmc *priv = platform_get_drvdata(pdev);
+    struct kcs_bmc_device *kcs_bmc = &priv->kcs_bmc;
+
+    kcs_bmc_remove_device(kcs_bmc);
+    espi_lpc_remove_ioport(&priv->io_data);
+    espi_lpc_remove_ioport(&priv->io_cmd_stt);
+    // npcm7xx_kcs_enable_channel(kcs_bmc, false);
+    // npcm7xx_kcs_irq_mask_update(kcs_bmc, (KCS_BMC_EVENT_TYPE_IBF | KCS_BMC_EVENT_TYPE_OBE), 0);
+
+    return 0;
+}
+
+static const struct of_device_id lingsi_kcs_bmc_match[] = {
+    { .compatible = "lingsi,kcs-bmc" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, lingsi_kcs_bmc_match);
+
+static struct platform_driver lingsi_kcs_bmc_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .of_match_table = lingsi_kcs_bmc_match,
+    },
+    .probe = lingsi_kcs_probe,
+    .remove = lingsi_kcs_remove,
+};
+module_platform_driver(lingsi_kcs_bmc_driver);
+
+MODULE_LICENSE("GPL");
diff --git a/drivers/char/ipmi/lingsi/lingsi_lpc.c b/drivers/char/ipmi/lingsi/lingsi_lpc.c
new file mode 100644
index 000000000000..82c48f124b6a
--- /dev/null
+++ b/drivers/char/ipmi/lingsi/lingsi_lpc.c
@@ -0,0 +1,242 @@
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+#include <linux/irq.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/syscon.h>
+#include <linux/atomic.h>
+#include <linux/list.h>
+#include <linux/stdarg.h>
+#include "lingsi_espi_lpc_common.h"
+#define DEVICE_NAME "lingsi-lpc"
+
+#define LPC_CTRL0                   0x000
+#define LPC_SERIRQ_STOP_TO_MASK     GENMASK(27, 20)
+#define LPC_SERIRQ_STOP_TO_SHIFT    20
+#define LPC_SYNC_TO_MASK            GENMASK(19, 4)
+#define LPC_SYNC_TO_SHIFT           4
+#define LPC_CLK_PH                  BIT(1)
+#define LPC_ICAP_MODE               BIT(0)
+#define LPC_CTRL1                   0x004
+#define LPC_SYNC_MASK               GENMASK(11, 8)
+#define LPC_SYNC_SHIFT              8
+#define LPC_DATA_UP_MASK            GENMASK(7, 0)
+#define LPC_DATA_UP_SHIFT           0
+#define LPC_CTRL2_SERIRQ_SRC        0x008
+#define LPC_CTRL3                   0x00c
+#define LPC_INTR_SEND_CLR           BIT(2)
+#define LPC_SERIRQ_SEND             BIT(1)
+#define LPC_SYNC_VALID              BIT(0)
+#define LPC_INT_MSK                 0x010
+#define LPC_INT_CLR                 0x014
+#define LPC_INT_STT                 0x018
+#define LPC_INT_SERIRQ_STOP_INVALID BIT(4)
+#define LPC_INT_SERIRQ_STOP_TO      BIT(3)
+#define LPC_INT_SERIRQ_STOP         BIT(2)
+#define LPC_INT_SYNC_TO             BIT(1)
+#define LPC_INT_CMD_VALID           BIT(0)
+#define LPC_INT_RAW                 0x01c
+#define LPC_SERIRQ_SENT             0x020
+#define LPC_SERIRQ_MODE             0x024
+#define LPC_ADDR                    0x028
+#define LPC_RX                      0x02c
+#define LPC_DATA_DN_MASK            GENMASK(15, 8)
+#define LPC_DATA_DN_SHIFT           8
+#define LPC_IDCYC_MASK              GENMASK(7, 4)
+#define LPC_IDCYC_SHIFT             4
+#define LPC_START_MASK              GENMASK(3, 0)
+#define LPC_START_SHIFT             0
+#define LPC_FSM                     0x030
+
+#define LPC_TYPE_IO_READ   0x00
+#define LPC_TYPE_IO_WRITE  0x20
+#define LPC_TYPE_MEM_READ  0x40
+#define LPC_TYPE_MEM_WRITE 0x60
+
+static void serirq_int_set(struct lingsi_espi_lpc_struct *lpc, bool unmask)
+{
+    u32 int_msk;
+    unsigned long flags;
+    spin_lock_irqsave(&lpc->u.lpc.int_msk_lock, flags);
+    int_msk = ioread32(lpc->base + LPC_INT_MSK);
+    if (!unmask) {
+        int_msk &= ~LPC_INT_SERIRQ_STOP;
+    } else {
+        int_msk |= LPC_INT_SERIRQ_STOP;
+    }
+    iowrite32(int_msk, lpc->base + LPC_INT_MSK);
+    spin_unlock_irqrestore(&lpc->u.lpc.int_msk_lock, flags);
+}
+
+static irqreturn_t lingsi_lpc_irq(int irq, void *arg)
+{
+    struct lingsi_espi_lpc_struct *lpc = arg;
+    unsigned int_stt = ioread32(lpc->base + LPC_INT_STT);
+    if (int_stt & LPC_INT_CMD_VALID) {
+        u32 addr = ioread32(lpc->base + LPC_ADDR);
+        u32 rx = ioread32(lpc->base + LPC_RX);
+        u8 start_cycle_dir = rx & 0xff;
+        u8 data = rx >> 8;
+        u32 res = 0;
+        iowrite32(LPC_INT_CMD_VALID, lpc->base + LPC_INT_CLR);
+        switch (start_cycle_dir) {
+        case LPC_TYPE_IO_READ:
+            iord_short(lpc, 1, addr, &res);
+            break;
+        case LPC_TYPE_IO_WRITE:
+            iowr_short(lpc, 1, addr, &data);
+            break;
+        case LPC_TYPE_MEM_READ:
+            memrd_short(lpc, 1, addr, &res);
+            break;
+        case LPC_TYPE_MEM_WRITE:
+            memwr_short(lpc, 1, addr, &data);
+            break;
+        default:
+            BUG_ON(1);
+            while (1)
+                ;
+            break;
+        }
+        iowrite32(res, lpc->base + LPC_CTRL1);
+        iowrite32(LPC_SYNC_VALID, lpc->base + LPC_CTRL3);
+    }
+    if (int_stt & LPC_INT_SYNC_TO) {
+        iowrite32(LPC_INT_SYNC_TO, lpc->base + LPC_INT_CLR);
+        BUG_ON(1);
+        while (1)
+            ;
+    }
+    if (int_stt & LPC_INT_SERIRQ_STOP) {
+        u32 serirq_sent = ioread32(lpc->base + LPC_SERIRQ_SENT);
+        u32 serirq_src;
+        unsigned long flags;
+        spin_lock_irqsave(&lpc->u.lpc.serirq_src_lock, flags);
+        serirq_src = ioread32(lpc->base + LPC_CTRL2_SERIRQ_SRC);
+        serirq_src ^= (serirq_sent & lpc->u.lpc.serirq_edge_mask);
+        iowrite32(serirq_src, lpc->base + LPC_CTRL2_SERIRQ_SRC);
+        spin_unlock_irqrestore(&lpc->u.lpc.serirq_src_lock, flags);
+        iowrite32(LPC_INT_SERIRQ_STOP, lpc->base + LPC_INT_CLR);
+        if (!(serirq_src & lpc->u.lpc.serirq_edge_mask)) {
+            serirq_int_set(lpc, false);
+        }
+    }
+    if (int_stt & LPC_INT_SERIRQ_STOP_TO) {
+        iowrite32(LPC_INT_SERIRQ_STOP_TO, lpc->base + LPC_INT_CLR);
+        BUG_ON(1);
+        while (1)
+            ;
+    }
+    if (int_stt & LPC_INT_SERIRQ_STOP_INVALID) {
+        iowrite32(LPC_INT_SERIRQ_STOP_INVALID, lpc->base + LPC_INT_CLR);
+        BUG_ON(1);
+        while (1)
+            ;
+    }
+    return IRQ_HANDLED;
+}
+
+static void lpc_reg_init(void __iomem *base)
+{
+    iowrite32(LPC_INT_CMD_VALID | LPC_INT_SYNC_TO | LPC_INT_SERIRQ_STOP | LPC_INT_SERIRQ_STOP_TO | LPC_INT_SERIRQ_STOP_INVALID, base + LPC_INT_CLR);
+    iowrite32(LPC_INT_SYNC_TO | LPC_INT_SERIRQ_STOP_INVALID | LPC_INT_SERIRQ_STOP_TO | LPC_INT_CMD_VALID, base + LPC_INT_MSK);
+}
+
+static void lpc_send_edge_int_evt(struct lingsi_espi_lpc_struct *lpc, u8 idx)
+{
+    u32 serirq;
+    unsigned long flags;
+    lpc->u.lpc.serirq_edge_mask |= 1 << idx;
+    spin_lock_irqsave(&lpc->u.lpc.serirq_src_lock, flags);
+    serirq = ioread32(lpc->base + LPC_CTRL2_SERIRQ_SRC);
+    serirq |= 1 << idx;
+    iowrite32(serirq, lpc->base + LPC_CTRL2_SERIRQ_SRC);
+    spin_unlock_irqrestore(&lpc->u.lpc.serirq_src_lock, flags);
+    serirq_int_set(lpc, true);
+}
+
+static void lpc_send_level_int_evt(struct lingsi_espi_lpc_struct *lpc, u8 idx, u8 active)
+{
+    unsigned long flags;
+    u32 serirq;
+    spin_lock_irqsave(&lpc->u.lpc.serirq_src_lock, flags);
+    serirq = ioread32(lpc->base + LPC_CTRL2_SERIRQ_SRC);
+    if (active) {
+        serirq |= 1 << idx;
+    } else {
+        serirq &= ~1 << idx;
+    }
+    iowrite32(serirq, lpc->base + LPC_CTRL2_SERIRQ_SRC);
+    spin_unlock_irqrestore(&lpc->u.lpc.serirq_src_lock, flags);
+}
+
+static int lingsi_lpc_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct lingsi_espi_lpc_struct *priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+    struct resource *res;
+    int irq, rc;
+    if (!priv)
+        return -ENOMEM;
+
+    priv->raise_edge_irq = lpc_send_edge_int_evt;
+    priv->set_level_irq = lpc_send_level_int_evt;
+
+    res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+    if (!res) {
+        dev_err(dev, "cannot get resource\n");
+        return -ENODEV;
+    }
+    priv->base = devm_ioremap_resource(dev, res);
+    if (IS_ERR(priv->base)) {
+        dev_err(dev, "cannot map registers\n");
+        return PTR_ERR(priv->base);
+    }
+    irq = platform_get_irq(pdev, 0);
+    if (irq < 0) {
+        dev_err(dev, "cannot get irq\n");
+        return irq;
+    }
+    rc = devm_request_irq(dev, irq, lingsi_lpc_irq, IRQF_SHARED, dev_name(dev), priv);
+    if (rc < 0) {
+        dev_err(dev, "cannot request irq\n");
+        return rc;
+    }
+
+    INIT_LIST_HEAD(&priv->peri_io_list);
+    INIT_LIST_HEAD(&priv->peri_mem_list);
+    spin_lock_init(&priv->u.lpc.serirq_src_lock);
+    spin_lock_init(&priv->u.lpc.int_msk_lock);
+
+    platform_set_drvdata(pdev, priv);
+
+    lpc_reg_init(priv->base);
+
+    return 0;
+}
+
+static int lingsi_lpc_remove(struct platform_device *pdev)
+{
+    return 0;
+}
+
+static const struct of_device_id lingsi_lpc_match[] = {
+    { .compatible = "lingsi,lpc" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, lingsi_lpc_match);
+
+static struct platform_driver lingsi_lpc_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .of_match_table = lingsi_lpc_match,
+    },
+    .probe = lingsi_lpc_probe,
+    .remove = lingsi_lpc_remove,
+};
+module_platform_driver(lingsi_lpc_driver);
+
+MODULE_LICENSE("GPL");
diff --git a/drivers/char/ipmi/lingsi/lingsi_mmbi.c b/drivers/char/ipmi/lingsi/lingsi_mmbi.c
new file mode 100644
index 000000000000..c50a822666b7
--- /dev/null
+++ b/drivers/char/ipmi/lingsi/lingsi_mmbi.c
@@ -0,0 +1,221 @@
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+#include <linux/irq.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/syscon.h>
+#include <linux/atomic.h>
+#include <linux/of_platform.h>
+#include <linux/sizes.h>
+#include "lingsi_espi_lpc_common.h"
+#define DEVICE_NAME         "lingsi-mmbi"
+#define MMBI_DESC_SIGNATURE "#MMBI$"
+// #define SET_B_UP(mmbi) set_bit(1,(void *)&((mmbi)->ros.b2h_wp))
+// #define CLR_B_UP(mmbi) clear_bit(1,(void *)&((mmbi)->ros.b2h_wp))
+// #define SET_B_RST(mmbi) set_bit(0,(void *)&((mmbi)->ros.b2h_wp))
+// #define CLR_B_RST(mmbi) clear_bit(0,(void *)&((mmbi)->ros.b2h_wp))
+
+struct host_ros {
+    u32 b2h_wp;
+    u32 h2b_rp;
+};
+
+struct host_rws {
+    u32 h2b_wp;
+    u32 b2h_rp;
+};
+
+struct mmbi_desc {
+    u8 signature[6];
+    u8 version;
+    u8 os_use;
+    u32 b2h_ba;
+    u32 h2b_ba;
+    u32 b2h_l;
+    u32 h2b_l;
+    u8 buft;
+    u8 reserved0[7];
+    u32 h_ros_p;
+    u32 h_rws_p;
+    u8 h_int_t;
+    u8 h_int_l;
+    u8 reserved1[3];
+    u8 h_int_v;
+    u8 bmc_int_t;
+    u32 bmc_int_l;
+    u8 reserved2[4];
+    u8 bmc_int_v;
+    u8 reserved3[8];
+} __attribute__((packed));
+
+struct mmbi_struct {
+    struct mmbi_desc desc;
+    struct host_ros ros;
+    struct host_rws rws;
+    u32 buf[];
+};
+
+struct lingsi_mmbi {
+    struct lingsi_espi_lpc_struct *parent;
+    struct lingsi_peri_mem mem;
+    u32 host_addr;
+    u32 size_order;
+    u8 vw_idx;
+    u8 vw_data;
+    struct mmbi_struct *virt;
+};
+
+static inline u32 get_mmbi_total_size(struct lingsi_mmbi *priv)
+{
+    return PAGE_SIZE * (1 << priv->size_order);
+}
+
+static void init_mmbi_mem(struct lingsi_mmbi *priv, u32 total_size)
+{
+    struct mmbi_struct *base = priv->virt;
+    memcpy(base->desc.signature, MMBI_DESC_SIGNATURE, sizeof(base->desc.signature));
+    base->desc.version = 1;
+    base->desc.os_use = 0;
+    base->desc.b2h_l = (total_size - sizeof(struct mmbi_struct)) / 2;
+    base->desc.h2b_l = (total_size - sizeof(struct mmbi_struct)) / 2;
+    base->desc.b2h_ba = (u32)((u8 *)base->buf - (u8 *)base) / 8;
+    base->desc.h2b_ba = (u32)((u8 *)base->buf - (u8 *)base + total_size - base->desc.h2b_l) / 8;
+    base->desc.buft = 1;
+    base->desc.h_ros_p = (u32)((u8 *)&base->ros - (u8 *)base) / 8;
+    base->desc.h_rws_p = (u32)((u8 *)&base->rws - (u8 *)base) / 8;
+    base->desc.h_int_t = 3;
+    base->desc.h_int_l = priv->vw_idx;
+    base->desc.h_int_v = priv->vw_data;
+    base->desc.bmc_int_t = 0;
+    base->desc.bmc_int_l = 0;
+    base->desc.bmc_int_v = 0;
+    //SET_B_UP(base);
+}
+
+static bool mmbi_host_read(struct lingsi_peri_mem *mem, u32 addr, u8 size, void *res)
+{
+    struct lingsi_mmbi *priv = mem->ctx;
+    if (priv->host_addr > addr || priv->host_addr + get_mmbi_total_size(priv) <= addr) {
+        return false;
+    }
+    switch (size) {
+    case 1:
+        *(u8 *)res = *((u8 *)priv->virt + addr - priv->host_addr);
+        break;
+    case 2:
+        *(u16 *)res = *(u16 *)((u8 *)priv->virt + addr - priv->host_addr);
+        break;
+    case 4:
+        *(u32 *)res = *(u32 *)((u8 *)priv->virt + addr - priv->host_addr);
+        break;
+    default:
+        BUG_ON(1);
+        break;
+    }
+    return true;
+}
+
+static bool mmbi_host_write(struct lingsi_peri_mem *mem, u32 addr, u8 size, u8 *data)
+{
+    struct lingsi_mmbi *priv = mem->ctx;
+    if (priv->host_addr > addr || priv->host_addr + get_mmbi_total_size(priv) <= addr) {
+        return false;
+    }
+    switch (size) {
+    case 1:
+        *((u8 *)priv->virt + addr - priv->host_addr) = data[0];
+        break;
+    case 2:
+        *(u16 *)((u8 *)priv->virt + addr - priv->host_addr) = data[1] << 8 | data[0];
+        break;
+    case 4:
+        *(u32 *)((u8 *)priv->virt + addr - priv->host_addr) = data[3] << 24 | data[2] << 16 | data[1] << 8 | data[0];
+        break;
+    default:
+        BUG_ON(1);
+        break;
+    }
+    return true;
+}
+
+static int lingsi_mmbi_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct platform_device *parent_pdev;
+    struct lingsi_espi_lpc_struct *espi_lpc;
+    struct lingsi_mmbi *priv;
+    struct device_node *parent = of_get_parent(dev->of_node);
+    int rc;
+    if (!parent) {
+        dev_err(dev, "cannot get parent node\n");
+        return -ENODEV;
+    }
+    parent_pdev = of_find_device_by_node(parent);
+    if (!parent_pdev) {
+        dev_err(dev, "cannot get parent device\n");
+        return -ENODEV;
+    }
+    espi_lpc = platform_get_drvdata(parent_pdev);
+    if (!espi_lpc) {
+        dev_err(dev, "espi lpc not inited\n");
+        return -EPROBE_DEFER;
+    }
+    priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+    if (!priv) {
+        dev_err(dev, "cannot alloc lingsi_mmbi mem\n");
+        return -ENOMEM;
+    }
+    priv->parent = espi_lpc;
+    rc = of_property_read_u32(dev->of_node, "host-addr", &priv->host_addr);
+    if (rc) {
+        dev_err(dev, "cannot get MMBI host address\n");
+        return -ENODEV;
+    }
+    rc = of_property_read_u32(dev->of_node, "size-order", &priv->size_order);
+    if (rc) {
+        dev_err(dev, "cannot get MMBI size order\n");
+        return -EINVAL;
+    }
+    priv->virt = (void *)devm_get_free_pages(dev, GFP_KERNEL, priv->size_order);
+    if (!priv->virt) {
+        dev_err(dev, "cannot alloc mmbi mem\n");
+        return -ENOMEM;
+    }
+    init_mmbi_mem(priv, get_mmbi_total_size(priv));
+
+    espi_lpc_add_mem(espi_lpc, &priv->mem, mmbi_host_read, mmbi_host_write, priv);
+    ;
+
+    platform_set_drvdata(pdev, priv);
+
+    return 0;
+}
+
+static int lingsi_mmbi_remove(struct platform_device *pdev)
+{
+    struct lingsi_mmbi *priv = platform_get_drvdata(pdev);
+    espi_lpc_remove_mem(&priv->mem);
+
+    return 0;
+}
+
+static const struct of_device_id lingsi_mmbi_match[] = {
+    { .compatible = "lingsi,mmbi" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, lingsi_mmbi_match);
+
+static struct platform_driver lingsi_mmbi_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .of_match_table = lingsi_mmbi_match,
+    },
+    .probe = lingsi_mmbi_probe,
+    .remove = lingsi_mmbi_remove,
+};
+module_platform_driver(lingsi_mmbi_driver);
+
+MODULE_LICENSE("GPL");
