diff --git a/drivers/irqchip/irq-lingsi-exti.c b/drivers/irqchip/irq-lingsi-exti.c
new file mode 100644
index 000000000000..f2d6408f247c
--- /dev/null
+++ b/drivers/irqchip/irq-lingsi-exti.c
@@ -0,0 +1,388 @@
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/hwspinlock.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/irqdomain.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/of_platform.h>
+#include <linux/syscore_ops.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
+
+#define IRQS_PER_BANK 16
+
+#define LINGSI_EXTI_MSK 0x0
+#define LINGSI_EXTI_CLR 0x20
+#define LINGSI_EXTI_STT 0x40
+#define LINGSI_EXTI_RAW 0x60
+
+struct lingsi_exti_bank {
+    u32 mask;
+    u32 clr;
+    u32 stt;
+    u32 raw;
+};
+
+struct lingsi_exti_drv_data {
+    const struct lingsi_exti_bank **exti_banks;
+    u32 bank_nr;
+};
+
+struct lingsi_exti_chip_data {
+    struct lingsi_exti_host_data *host_data;
+    const struct lingsi_exti_bank *reg_bank;
+    u32 irq_level_bank;
+    struct raw_spinlock rlock;
+};
+
+struct lingsi_exti_host_data {
+    void __iomem *base;
+    struct lingsi_exti_chip_data *chips_data;
+    const struct lingsi_exti_drv_data *drv_data;
+    struct hwspinlock *hwlock;
+};
+
+static struct lingsi_exti_host_data *lingsi_host_data;
+
+static const struct lingsi_exti_bank lingsi_exti_b0 = {
+    .mask = LINGSI_EXTI_MSK,
+    .clr  = LINGSI_EXTI_CLR,
+    .stt  = LINGSI_EXTI_STT,
+    .raw  = LINGSI_EXTI_RAW,
+};
+
+static const struct lingsi_exti_bank lingsi_exti_b1 = {
+    .mask = LINGSI_EXTI_MSK + 0x4,
+    .clr  = LINGSI_EXTI_CLR + 0x4,
+    .stt  = LINGSI_EXTI_STT + 0x4,
+    .raw  = LINGSI_EXTI_RAW + 0x4,
+};
+
+static const struct lingsi_exti_bank lingsi_exti_b2 = {
+    .mask = LINGSI_EXTI_MSK + 0x8,
+    .clr  = LINGSI_EXTI_CLR + 0x8,
+    .stt  = LINGSI_EXTI_STT + 0x8,
+    .raw  = LINGSI_EXTI_RAW + 0x8,
+};
+
+static const struct lingsi_exti_bank lingsi_exti_b3 = {
+    .mask = LINGSI_EXTI_MSK + 0xc,
+    .clr  = LINGSI_EXTI_CLR + 0xc,
+    .stt  = LINGSI_EXTI_STT + 0xc,
+    .raw  = LINGSI_EXTI_RAW + 0xc,
+};
+
+static const struct lingsi_exti_bank lingsi_exti_b4 = {
+    .mask = LINGSI_EXTI_MSK + 0x10,
+    .clr  = LINGSI_EXTI_CLR + 0x10,
+    .stt  = LINGSI_EXTI_STT + 0x10,
+    .raw  = LINGSI_EXTI_RAW + 0x10,
+};
+
+static const struct lingsi_exti_bank lingsi_exti_b5 = {
+    .mask = LINGSI_EXTI_MSK + 0x14,
+    .clr  = LINGSI_EXTI_CLR + 0x14,
+    .stt  = LINGSI_EXTI_STT + 0x14,
+    .raw  = LINGSI_EXTI_RAW + 0x14,
+};
+
+static const struct lingsi_exti_bank lingsi_exti_b6 = {
+    .mask = LINGSI_EXTI_MSK + 0x18,
+    .clr  = LINGSI_EXTI_CLR + 0x18,
+    .stt  = LINGSI_EXTI_STT + 0x18,
+    .raw  = LINGSI_EXTI_RAW + 0x18,
+};
+
+static const struct lingsi_exti_bank lingsi_exti_b7 = {
+    .mask = LINGSI_EXTI_MSK + 0x1c,
+    .clr  = LINGSI_EXTI_CLR + 0x1c,
+    .stt  = LINGSI_EXTI_STT + 0x1c,
+    .raw  = LINGSI_EXTI_RAW + 0x1c,
+};
+
+static const struct lingsi_exti_bank *lingsi_exti_banks[] = {
+    &lingsi_exti_b0,
+    &lingsi_exti_b1,
+    &lingsi_exti_b2,
+    &lingsi_exti_b3,
+    &lingsi_exti_b4,
+    &lingsi_exti_b5,
+    &lingsi_exti_b6,
+    &lingsi_exti_b7,
+};
+
+static const struct lingsi_exti_drv_data lingsi_drv_data = {
+    .exti_banks = lingsi_exti_banks,
+    .bank_nr = ARRAY_SIZE(lingsi_exti_banks),
+};
+
+static unsigned long lingsi_exti_pending(struct irq_chip_generic *gc)
+{
+    struct lingsi_exti_chip_data *chip_data = gc->private;
+    void __iomem *base = chip_data->host_data->base;
+    const struct lingsi_exti_bank *lingsi_bank = chip_data->reg_bank;
+    unsigned long pending = 0;
+    unsigned long val = 0;
+    pending = readl_relaxed(base + lingsi_bank->stt);
+    pending |= (pending >> IRQS_PER_BANK);
+    pending &= GENMASK(IRQS_PER_BANK - 1, 0);
+    if(pending) {
+        val = readl_relaxed(base + lingsi_bank->mask);
+    }
+    return pending;
+}
+
+static void lingsi_irq_handler(struct irq_desc *desc)
+{
+    struct irq_domain *domain = irq_desc_get_handler_data(desc);
+    struct irq_chip *chip = irq_desc_get_chip(desc);
+    unsigned int nbanks = domain->gc->num_chips;
+    struct irq_chip_generic *gc;
+    unsigned long pending;
+    int n, i, irq_base = 0;
+    chained_irq_enter(chip, desc);
+
+    for (i = 0; i < nbanks; i++, irq_base += IRQS_PER_BANK) {
+        gc = irq_get_domain_generic_chip(domain, irq_base);
+
+        while ((pending = lingsi_exti_pending(gc))) {
+            for_each_set_bit(n, &pending, IRQS_PER_BANK) {
+                generic_handle_domain_irq(domain, irq_base + n);
+            }
+         }
+    }
+
+    chained_irq_exit(chip, desc);
+}
+
+static int lingsi_exti_set_irq_type(struct irq_data *d, unsigned int type)
+{
+    struct irq_chip_generic *gc = irq_data_get_irq_chip_data(d);
+    struct lingsi_exti_chip_data *chip_data = gc->private;
+    uint32_t *irq_level_bank = &chip_data->irq_level_bank;
+    uint32_t gpio = irqd_to_hwirq(d) % IRQS_PER_BANK;
+
+    irq_gc_lock(gc);
+
+    switch (type) {
+    case IRQ_TYPE_LEVEL_HIGH:
+    case IRQ_TYPE_EDGE_RISING:
+        *irq_level_bank |= BIT(gpio);
+        break;
+    case IRQ_TYPE_LEVEL_LOW:
+    case IRQ_TYPE_EDGE_FALLING:
+        *irq_level_bank |= BIT(gpio) << IRQS_PER_BANK;
+        break;
+    case IRQ_TYPE_EDGE_BOTH:
+        *irq_level_bank |= BIT(gpio) | (BIT(gpio) << IRQS_PER_BANK);
+        break;
+    default:
+        return -EINVAL;
+    }
+
+    irq_gc_unlock(gc);
+    return 0;
+}
+
+static int lingsi_exti_alloc(struct irq_domain *d, unsigned int virq,
+                unsigned int nr_irqs, void *data)
+{
+    struct irq_fwspec *fwspec = data;
+    irq_hw_number_t hwirq;
+    hwirq = fwspec->param[0];
+
+    irq_map_generic_chip(d, virq, hwirq);
+    return 0;
+}
+
+static void lingsi_exti_free(struct irq_domain *d, unsigned int virq,
+                unsigned int nr_irqs)
+{
+    struct irq_data *data = irq_domain_get_irq_data(d, virq);
+    irq_domain_reset_irq_data(data);
+}
+
+static const struct irq_domain_ops irq_exti_domain_ops = {
+    .map    = irq_map_generic_chip,
+    .alloc  = lingsi_exti_alloc,
+    .free    = lingsi_exti_free,
+};
+
+static void lingsi_exti_irq_ack(struct irq_data *d)
+{
+    struct irq_chip_generic *gc = irq_data_get_irq_chip_data(d);
+    struct lingsi_exti_chip_data *chip_data = gc->private;
+    void __iomem *base = chip_data->host_data->base;
+    const struct lingsi_exti_bank *lingsi_bank = chip_data->reg_bank;
+    uint32_t gpio = irqd_to_hwirq(d) % IRQS_PER_BANK;
+    irq_gc_lock(gc);
+
+    iowrite32(BIT(gpio) | (BIT(gpio) << IRQS_PER_BANK), base + lingsi_bank->clr);
+    iowrite32(0x0, base + lingsi_bank->clr);
+
+    irq_gc_unlock(gc);
+}
+
+/* Disable GPIO interrupt */
+static void lingsi_exti_irq_mask(struct irq_data *d)
+{
+    struct irq_chip_generic *gc = irq_data_get_irq_chip_data(d);
+    struct lingsi_exti_chip_data *chip_data = gc->private;
+    void __iomem *base = chip_data->host_data->base;
+    const struct lingsi_exti_bank *lingsi_bank = chip_data->reg_bank;
+    uint32_t *irq_level_bank = &chip_data->irq_level_bank;
+    uint32_t gpio = irqd_to_hwirq(d) % IRQS_PER_BANK;
+
+    raw_spin_lock(&chip_data->rlock);
+    *irq_level_bank &= ~(BIT(gpio) | (BIT(gpio) << IRQS_PER_BANK));
+    iowrite32(*irq_level_bank, base + lingsi_bank->mask);
+    iowrite32(0x0, base + lingsi_bank->clr);
+    raw_spin_unlock(&chip_data->rlock);
+}
+
+/* Enable GPIO interrupt */
+static void lingsi_exti_irq_unmask(struct irq_data *d)
+{
+    struct irq_chip_generic *gc = irq_data_get_irq_chip_data(d);
+    struct lingsi_exti_chip_data *chip_data = gc->private;
+    void __iomem *base = chip_data->host_data->base;
+    const struct lingsi_exti_bank *lingsi_bank = chip_data->reg_bank;
+    uint32_t *irq_level_bank = &chip_data->irq_level_bank;
+
+    raw_spin_lock(&chip_data->rlock);
+    iowrite32(*irq_level_bank, base + lingsi_bank->mask);
+    iowrite32(0x0, base + lingsi_bank->clr);
+    raw_spin_unlock(&chip_data->rlock);
+}
+
+static struct
+lingsi_exti_host_data *lingsi_exti_host_init(const struct lingsi_exti_drv_data *dd,
+                       struct device_node *node)
+{
+    struct lingsi_exti_host_data *host_data;
+    host_data = kzalloc(sizeof(*host_data), GFP_KERNEL);
+    if (!host_data)
+        return NULL;
+
+    host_data->drv_data = dd;
+    host_data->chips_data = kcalloc(dd->bank_nr,
+                    sizeof(struct lingsi_exti_chip_data),
+                    GFP_KERNEL);
+    if (!host_data->chips_data)
+        goto free_host_data;
+
+    host_data->base = of_iomap(node, 0);
+    if (!host_data->base) {
+        pr_err("%pOF: Unable to map registers\n", node);
+        goto free_chips_data;
+    }
+
+    lingsi_host_data = host_data;
+
+    return host_data;
+
+free_chips_data:
+    kfree(host_data->chips_data);
+free_host_data:
+    kfree(host_data);
+
+    return NULL;
+}
+
+static struct
+lingsi_exti_chip_data *lingsi_exti_chip_init(struct lingsi_exti_host_data *h_data,
+                       u32 bank_idx,
+                       struct device_node *node)
+{
+    const struct lingsi_exti_bank *lingsi_bank;
+    struct lingsi_exti_chip_data *chip_data;
+    lingsi_bank = h_data->drv_data->exti_banks[bank_idx];
+    chip_data = &h_data->chips_data[bank_idx];
+    chip_data->host_data = h_data;
+    chip_data->reg_bank = lingsi_bank;
+
+    raw_spin_lock_init(&chip_data->rlock);
+
+    pr_info("%pOF: bank%d\n", node, bank_idx);
+
+    return chip_data;
+}
+
+static int __init lingsi_exti_init(const struct lingsi_exti_drv_data *drv_data,
+                  struct device_node *node)
+{
+    struct lingsi_exti_host_data *host_data;
+    unsigned int clr = IRQ_NOREQUEST | IRQ_NOPROBE | IRQ_NOAUTOEN;
+    int nr_irqs, ret, i;
+    struct irq_chip_generic *gc;
+    struct irq_domain *domain;
+    host_data = lingsi_exti_host_init(drv_data, node);
+    if (!host_data)
+        return -ENOMEM;
+
+    domain = irq_domain_add_linear(node, drv_data->bank_nr * IRQS_PER_BANK,
+                       &irq_exti_domain_ops, NULL);
+    if (!domain) {
+        pr_err("%pOFn: Could not register interrupt domain.\n",
+               node);
+        ret = -ENOMEM;
+        goto out_unmap;
+    }
+
+    ret = irq_alloc_domain_generic_chips(domain, IRQS_PER_BANK, 1, "exti",
+                         handle_edge_irq, clr, 0, 0);
+    if (ret) {
+        pr_err("%pOF: Could not allocate generic interrupt chip.\n",
+               node);
+        goto out_free_domain;
+    }
+
+    for (i = 0; i < drv_data->bank_nr; i++) {
+        const struct lingsi_exti_bank *lingsi_bank;
+        struct lingsi_exti_chip_data *chip_data;
+
+        lingsi_bank = drv_data->exti_banks[i];
+        chip_data = lingsi_exti_chip_init(host_data, i, node);
+
+        gc = irq_get_domain_generic_chip(domain, i * IRQS_PER_BANK);
+
+        gc->reg_base = host_data->base;
+        gc->chip_types->type = IRQ_TYPE_EDGE_BOTH;
+        gc->chip_types->chip.irq_ack = lingsi_exti_irq_ack;
+        gc->chip_types->chip.irq_mask = lingsi_exti_irq_mask;
+        gc->chip_types->chip.irq_unmask = lingsi_exti_irq_unmask;
+        gc->chip_types->chip.irq_set_type = lingsi_exti_set_irq_type;
+        gc->private = (void *)chip_data;
+
+        iowrite32(0x0, gc->reg_base + lingsi_bank->clr);
+    }
+    nr_irqs = of_irq_count(node);
+    for (i = 0; i < nr_irqs; i++) {
+        unsigned int irq = irq_of_parse_and_map(node, i);
+        irq_set_handler_data(irq, domain);
+        irq_set_chained_handler(irq, lingsi_irq_handler);
+    }
+    return 0;
+
+out_free_domain:
+    irq_domain_remove(domain);
+out_unmap:
+    iounmap(host_data->base);
+    kfree(host_data->chips_data);
+    kfree(host_data);
+    return ret;
+}
+
+static int __init lingsi_exti_of_init(struct device_node *np,
+                       struct device_node *parent)
+{
+    return lingsi_exti_init(&lingsi_drv_data, np);
+}
+
+IRQCHIP_DECLARE(lingsi_exti, "lingsi,exti-intc", lingsi_exti_of_init);
