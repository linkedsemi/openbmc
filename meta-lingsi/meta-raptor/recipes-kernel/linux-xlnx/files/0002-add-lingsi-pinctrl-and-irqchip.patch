+static inline uint32_t lingsi_gpio_pin(uint32_t gpio)
+{
+    return gpio % LINGSI_GPIO_PINS_PER_BANK;
+}
+
+static inline uint32_t lingsi_gpio_bank(uint32_t gpio)
+{
+    return gpio / LINGSI_GPIO_PINS_PER_BANK;
+}
+
+static inline uint32_t lingsi_gpio_bank_base(uint32_t bank)
+{
+    return bank * LINGSI_GPIO_REG_SIZE_PER_BANK;
+}
+
+static inline uint32_t lingsi_gpio_get_mode(uint32_t function)
+{
+    switch (function) {
+    case LINGSI_PIN_GPIO:
+        return MODE_GPIO;
+    case LINGSI_PIN_AF(AF_START)... LINGSI_PIN_AF(AF_END):
+        return MODE_ALTER_FUNC;
+    }
+
+    return 0;
+}
+
+static inline uint32_t lingsi_gpio_get_alt(uint32_t function)
+{
+    switch (function) {
+    case LINGSI_PIN_GPIO:
+        return MODE_GPIO;
+    case LINGSI_PIN_AF(AF_START)... LINGSI_PIN_AF(AF_END):
+        return function;
+    }
+
+    return 0;
+}
+
+/* GPIO functions */
+
+static inline void __lingsi_gpio_set(struct lingsi_pinctrl *pctl,
+                                     unsigned offset,
+                                     uint32_t value)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+
+    if (!value) {
+        pin += LINGSI_GPIO_PINS_PER_BANK;
+    }
+
+    regmap_set_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_DOT, BIT(pin));
+}
+
+/* Pinctrl functions */
+static struct lingsi_pinctrl_group *
+lingsi_pctrl_find_group_by_pin(struct lingsi_pinctrl *pctl, uint32_t pin)
+{
+    uint32_t i;
+
+    for (i = 0; i < pctl->ngroups; i++) {
+        struct lingsi_pinctrl_group *grp = pctl->groups + i;
+
+        if (grp->pin == pin)
+            return grp;
+    }
+
+    return NULL;
+}
+
+static bool lingsi_pctrl_is_function_valid(struct lingsi_pinctrl *pctl,
+                                           uint32_t pin_num,
+                                           uint32_t fnum)
+{
+    uint32_t i;
+    uint32_t k;
+
+    for (i = 0; i < pctl->npins; i++) {
+        const struct lingsi_desc_pin *pin = pctl->pins + i;
+        const struct lingsi_desc_function *func = pin->functions;
+
+        if (pin->pin.number != pin_num)
+            continue;
+
+        for (k = 0; k < LINGSI_CONFIG_NUM; k++) {
+            if (func->num == fnum)
+                return true;
+            func++;
+        }
+
+        break;
+    }
+
+    dev_err(pctl->dev, "invalid function %d on pin %d .\n", fnum, pin_num);
+
+    return false;
+}
+
+static uint32_t lingsi_pctrl_dt_node_to_map_func(struct lingsi_pinctrl *pctl,
+                                            uint32_t pin,
+                                            uint32_t fnum,
+                                            struct lingsi_pinctrl_group *grp,
+                                            struct pinctrl_map **map,
+                                            unsigned *reserved_maps,
+                                            unsigned *num_maps)
+{
+    if (*num_maps == *reserved_maps)
+        return -ENOSPC;
+
+    (*map)[*num_maps].type = PIN_MAP_TYPE_MUX_GROUP;
+    (*map)[*num_maps].data.mux.group = grp->name;
+
+    if (!lingsi_pctrl_is_function_valid(pctl, pin, fnum))
+        return -EINVAL;
+
+    (*map)[*num_maps].data.mux.function = lingsi_gpio_functions[fnum];
+    (*num_maps)++;
+
+    return 0;
+}
+
+static uint32_t lingsi_pctrl_dt_subnode_to_map(struct pinctrl_dev *pctldev,
+                                          struct device_node *node,
+                                          struct pinctrl_map **map,
+                                          unsigned *reserved_maps,
+                                          unsigned *num_maps)
+{
+    struct lingsi_pinctrl *pctl;
+    struct lingsi_pinctrl_group *grp;
+    struct property *pins;
+    union pin_mux pmux;
+    bool has_config = 0;
+    uint32_t num_configs;
+    uint32_t num_pins;
+    uint32_t num_funcs;
+    uint32_t maps_per_pin;
+    uint32_t i;
+    uint32_t err = 0;
+    unsigned reserve = 0;
+    unsigned long *configs;
+
+    pctl = pinctrl_dev_get_drvdata(pctldev);
+    pins = of_find_property(node, "pinmux", NULL);
+    if (!pins) {
+        dev_err(pctl->dev, "missing pins property in node %pOFn .\n", node);
+        return -EINVAL;
+    }
+
+    err = pinconf_generic_parse_dt_config(node, pctldev, &configs, &num_configs);
+    if (err)
+        return err;
+
+    if (num_configs)
+        has_config = 1;
+
+    num_pins = pins->length / sizeof(uint64_t);
+    num_funcs = num_pins;
+    maps_per_pin = 0;
+    if (num_funcs)
+        maps_per_pin++;
+    if (has_config && num_pins >= 1)
+        maps_per_pin++;
+
+    if (!num_pins || !maps_per_pin) {
+        err = -EINVAL;
+        goto exit;
+    }
+
+    reserve = num_pins * maps_per_pin;
+
+    err = pinctrl_utils_reserve_map(pctldev, map, reserved_maps, num_maps, reserve);
+    if (err)
+        goto exit;
+
+    for (i = 0; i < num_pins; i++) {
+        err = of_property_read_u64_index(node, "pinmux", i, &(pmux.data));
+        if (err)
+            goto exit;
+        pctl->pflag[pmux.mux.num] = pmux.mux.flag;
+        pctl->pmode[pmux.mux.num] = pmux.mux.mode;
+
+        if (!lingsi_pctrl_is_function_valid(pctl, pmux.mux.num, pmux.mux.func)) {
+            err = -EINVAL;
+            goto exit;
+        }
+
+        grp = lingsi_pctrl_find_group_by_pin(pctl, pmux.mux.num);
+        if (!grp) {
+            dev_err(pctl->dev, "unable to match pmux.mux.num %d to group\n", pmux.mux.num);
+            err = -EINVAL;
+            goto exit;
+        }
+
+        err = lingsi_pctrl_dt_node_to_map_func(pctl, pmux.mux.num, pmux.mux.func, grp, map, reserved_maps, num_maps);
+        if (err)
+            goto exit;
+
+        if (has_config) {
+            err = pinctrl_utils_add_map_configs(pctldev, map, reserved_maps, num_maps, grp->name, configs, num_configs, PIN_MAP_TYPE_CONFIGS_GROUP);
+            if (err)
+                goto exit;
+        }
+    }
+
+exit:
+    kfree(configs);
+    return err;
+}
+
+static int lingsi_pctrl_dt_node_to_map(struct pinctrl_dev *pctldev,
+                                       struct device_node *np_config,
+                                       struct pinctrl_map **map,
+                                       unsigned *num_maps)
+{
+    struct device_node *np;
+    unsigned reserved_maps;
+    int ret;
+    *map = NULL;
+    *num_maps = 0;
+    reserved_maps = 0;
+
+    for_each_child_of_node (np_config, np) {
+        ret = lingsi_pctrl_dt_subnode_to_map(pctldev, np, map, &reserved_maps, num_maps);
+        if (ret < 0) {
+            pinctrl_utils_free_map(pctldev, *map, *num_maps);
+            of_node_put(np);
+            return ret;
+        }
+    }
+
+    return 0;
+}
+
+static int lingsi_pctrl_get_groups_count(struct pinctrl_dev *pctldev)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+
+    return pctl->ngroups;
+}
+
+static const char *lingsi_pctrl_get_group_name(struct pinctrl_dev *pctldev,
+                                               unsigned group)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    return pctl->groups[group].name;
+}
+
+static int lingsi_pctrl_get_group_pins(struct pinctrl_dev *pctldev,
+                                       unsigned group,
+                                       const unsigned **pins,
+                                       unsigned *num_pins)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+
+    *pins = (unsigned *)&pctl->groups[group].pin;
+    *num_pins = 1;
+
+    return 0;
+}
+
+static const struct pinctrl_ops lingsi_pctrl_ops = {
+    .dt_node_to_map = lingsi_pctrl_dt_node_to_map,
+    .dt_free_map = pinctrl_utils_free_map,
+    .get_groups_count = lingsi_pctrl_get_groups_count,
+    .get_group_name = lingsi_pctrl_get_group_name,
+    .get_group_pins = lingsi_pctrl_get_group_pins,
+};
+
+/* Pinmux functions */
+
+static int lingsi_pmx_get_funcs_cnt(struct pinctrl_dev *pctldev)
+{
+    return ARRAY_SIZE(lingsi_gpio_functions);
+}
+
+static const char *lingsi_pmx_get_func_name(struct pinctrl_dev *pctldev,
+                                            unsigned selector)
+{
+    return lingsi_gpio_functions[selector];
+}
+
+static int lingsi_pmx_get_func_groups(struct pinctrl_dev *pctldev,
+                                      unsigned function,
+                                      const char *const **groups,
+                                      unsigned *const num_groups)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+
+    *groups = pctl->grp_names;
+    *num_groups = pctl->ngroups;
+
+    return 0;
+}
+
+static uint32_t lingsi_pmx_set_mode(struct lingsi_pinctrl *pctl,
+                               uint32_t offset,
+                               uint32_t mode,
+                               uint32_t alt)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t alt_shift;
+    uint32_t alt_mask;
+    uint32_t alt_offset;
+    uint32_t val;
+    uint32_t err = 0;
+    unsigned long flags;
+
+    spin_lock_irqsave(&pctl->lock, flags);
+
+    if (pctl->hwlock) {
+        err = hwspin_lock_timeout_in_atomic(pctl->hwlock, HWSPNLCK_TIMEOUT);
+        if (err) {
+            dev_err(pctl->dev, "Can't get hwspinlock\n");
+            goto unlock;
+        }
+    }
+
+    switch (mode) {
+    case GPIO_LINE_DIRECTION_OUT:
+        /* disable alter func */
+        alt_offset = LINGSI_GPIO_PIN_SEL1 + (offset >> 5) * 0x4;
+        regmap_clear_bits(pctl->sysc_awo_regmap, alt_offset, BIT(offset % 32));
+        /* output */
+        val = BIT(LINGSI_GPIO_PINS_PER_BANK + pin);
+        regmap_set_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_OE_FIR, val);
+        break;
+    case GPIO_LINE_DIRECTION_IN:
+        /* disable alter func */
+        alt_offset = LINGSI_GPIO_PIN_SEL1 + (offset >> 5) * 0x4;
+        regmap_clear_bits(pctl->sysc_awo_regmap, alt_offset, BIT(offset % 32));
+        /* input */
+        val = BIT(LINGSI_GPIO_PINS_PER_BANK + pin);
+        regmap_clear_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_OE_FIR, val);
+        break;
+    default:
+        alt_offset = LINGSI_PER_FUNC_SEL + ALIGN_DOWN(offset, 4);
+        alt_shift = (offset % 4) * 8;
+        alt_mask = GENMASK(alt_shift + 7, alt_shift);
+        alt <<= alt_shift;
+        regmap_update_bits(pctl->sysc_per_regmap, alt_offset, alt_mask, alt);
+        /* enable alter func */
+        alt_offset = LINGSI_GPIO_PIN_SEL1 + (offset >> 5) * 0x4;
+        regmap_set_bits(pctl->sysc_awo_regmap, alt_offset, BIT(offset % 32));
+        if (pctl->pflag[offset].data) {
+            if (pctl->pflag[offset].mode.lock) {
+                regmap_set_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_LVS_LOCK, BIT(pin));
+            }
+            if (pctl->pflag[offset].mode.lvs) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_DOT, BIT(pin + LINGSI_GPIO_PINS_PER_BANK), pctl->pmode[offset].mode.lvs);
+            }
+            if (pctl->pflag[offset].mode.dot_clr) {
+                regmap_set_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_DOT, BIT(pin + LINGSI_GPIO_PINS_PER_BANK));
+            }
+            if (pctl->pflag[offset].mode.dot_set) {
+                regmap_set_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_DOT, BIT(pin));
+            }
+            if (pctl->pflag[offset].mode.pd) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_PD_PU, BIT(pin + LINGSI_GPIO_PINS_PER_BANK), pctl->pmode[offset].mode.pd);
+            }
+            if (pctl->pflag[offset].mode.pu) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_PD_PU, BIT(pin), pctl->pmode[offset].mode.pu);
+            }
+            if (pctl->pflag[offset].mode.ien) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_IEN_OD, BIT(pin + LINGSI_GPIO_PINS_PER_BANK), pctl->pmode[offset].mode.ien);
+            }
+            if (pctl->pflag[offset].mode.od) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_IEN_OD, BIT(pin), pctl->pmode[offset].mode.ien);
+            }
+            if (pctl->pflag[offset].mode.ds1) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_DS, BIT(pin + LINGSI_GPIO_PINS_PER_BANK), pctl->pmode[offset].mode.ds1);
+            }
+            if (pctl->pflag[offset].mode.ds2) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_DS, BIT(pin), pctl->pmode[offset].mode.ds2);
+            }
+            if (pctl->pflag[offset].mode.ae1) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_AE, BIT(pin + LINGSI_GPIO_PINS_PER_BANK), pctl->pmode[offset].mode.ae1);
+            }
+            if (pctl->pflag[offset].mode.ae2) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_AE, BIT(pin), pctl->pmode[offset].mode.ae2);
+            }
+            if (pctl->pflag[offset].mode.oe) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_OE_FIR, BIT(pin + LINGSI_GPIO_PINS_PER_BANK), pctl->pmode[offset].mode.oe);
+            }
+            if (pctl->pflag[offset].mode.oe) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_OE_FIR, BIT(pin), pctl->pmode[offset].mode.oe);
+            }
+            if (pctl->pflag[offset].mode.hss) {
+                regmap_update_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_HSS_DIN, BIT(pin + LINGSI_GPIO_PINS_PER_BANK), pctl->pmode[offset].mode.hss);
+            }
+        }
+        break;
+    };
+
+    if (pctl->hwlock)
+        hwspin_unlock_in_atomic(pctl->hwlock);
+
+unlock:
+    spin_unlock_irqrestore(&pctl->lock, flags);
+
+    return err;
+}
+
+void lingsi_pmx_get_mode(struct lingsi_pinctrl *pctl, uint32_t offset, uint32_t *mode, uint32_t *alt)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t alt_shift;
+    uint32_t alt_mask;
+    uint32_t alt_offset;
+    uint32_t val;
+    unsigned long flags;
+
+    spin_lock_irqsave(&pctl->lock, flags);
+
+    alt_offset = LINGSI_GPIO_PIN_SEL1 + (offset >> 5) * 0x4;
+    val = !!(regmap_test_bits(pctl->sysc_awo_regmap, alt_offset, BIT(offset % 32)));
+    if (val) {
+        /* alter func is on: AF mode */
+        alt_offset = LINGSI_PER_FUNC_SEL + ALIGN_DOWN(offset, 4);
+        regmap_read(pctl->sysc_per_regmap, alt_offset, &val);
+        alt_shift = (offset % 4) * 8;
+        alt_mask = GENMASK(alt_shift + 7, alt_shift);
+        *alt = (val & alt_mask) >> alt_shift;
+        *mode = MODE_ALTER_FUNC;
+    } else {
+        *alt = 0;
+        val = !!(regmap_test_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_OE_FIR, BIT(LINGSI_GPIO_PINS_PER_BANK + pin)));
+        if (val) {
+            *mode = GPIO_LINE_DIRECTION_OUT;
+        } else {
+            *mode = GPIO_LINE_DIRECTION_IN;
+        }
+    }
+    spin_unlock_irqrestore(&pctl->lock, flags);
+}
+
+static int lingsi_pmx_set_mux(struct pinctrl_dev *pctldev,
+                              unsigned function,
+                              unsigned group)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    struct lingsi_pinctrl_group *g = pctl->groups + group;
+    uint32_t mode, alt;
+    bool ret;
+
+    ret = lingsi_pctrl_is_function_valid(pctl, g->pin, function);
+    if (!ret)
+        return -EINVAL;
+
+    mode = lingsi_gpio_get_mode(function);
+    alt = lingsi_gpio_get_alt(function);
+
+    return lingsi_pmx_set_mode(pctl, g->pin, mode, alt);
+}
+
+static uint32_t lingsi_pmx_gpio_set_direction(struct pinctrl_dev *pctldev,
+                                         unsigned gpio,
+                                         bool input)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+
+    return lingsi_pmx_set_mode(pctl, gpio, input, 0);
+}
+
+static const struct pinmux_ops lingsi_pmx_ops = {
+    .get_functions_count = lingsi_pmx_get_funcs_cnt,
+    .get_function_name = lingsi_pmx_get_func_name,
+    .get_function_groups = lingsi_pmx_get_func_groups,
+    .set_mux = lingsi_pmx_set_mux,
+    .strict = true,
+};
