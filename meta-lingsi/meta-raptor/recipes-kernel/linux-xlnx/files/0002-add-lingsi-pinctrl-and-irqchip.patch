+/* Pinconf functions */
+
+static uint32_t lingsi_pconf_set_driving(struct lingsi_pinctrl *pctl,
+                                    unsigned offset,
+                                    uint32_t drive)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    unsigned long flags;
+    uint32_t err = 0;
+
+    spin_lock_irqsave(&pctl->lock, flags);
+
+    if (pctl->hwlock) {
+        err = hwspin_lock_timeout_in_atomic(pctl->hwlock, HWSPNLCK_TIMEOUT);
+        if (err) {
+            dev_err(pctl->dev, "Can't get hwspinlock\n");
+            goto unlock;
+        }
+    }
+
+    if (drive) {
+        regmap_set_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_IEN_OD, BIT(pin));
+    } else {
+        regmap_clear_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_IEN_OD, BIT(pin));
+    }
+
+    if (pctl->hwlock)
+        hwspin_unlock_in_atomic(pctl->hwlock);
+
+unlock:
+    spin_unlock_irqrestore(&pctl->lock, flags);
+
+    return err;
+}
+
+static uint32_t lingsi_pconf_get_driving(struct lingsi_pinctrl *pctl,
+                                         uint32_t offset)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t val;
+    unsigned long flags;
+
+    spin_lock_irqsave(&pctl->lock, flags);
+
+    val = !!(regmap_test_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_IEN_OD, BIT(pin)));
+
+    spin_unlock_irqrestore(&pctl->lock, flags);
+
+    return val;
+}
+
+static uint32_t lingsi_pconf_set_bias(struct lingsi_pinctrl *pctl,
+                                 unsigned offset,
+                                 uint32_t bias)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t val;
+    uint32_t err = 0;
+    unsigned long flags;
+
+    spin_lock_irqsave(&pctl->lock, flags);
+
+    if (pctl->hwlock) {
+        err = hwspin_lock_timeout_in_atomic(pctl->hwlock, HWSPNLCK_TIMEOUT);
+        if (err) {
+            dev_err(pctl->dev, "Can't get hwspinlock\n");
+            goto unlock;
+        }
+    }
+
+    if (bias == LINGSI_GPIO_PULL_UP) {
+        val = BIT(pin);
+    } else if (bias == LINGSI_GPIO_PULL_DOWN) {
+        val = BIT(pin + LINGSI_GPIO_PINS_PER_BANK);
+    }
+
+    regmap_set_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_PD_PU, val);
+
+    if (pctl->hwlock)
+        hwspin_unlock_in_atomic(pctl->hwlock);
+
+unlock:
+    spin_unlock_irqrestore(&pctl->lock, flags);
+
+    return err;
+}
+
+static uint32_t lingsi_pconf_get_bias(struct lingsi_pinctrl *pctl, uint32_t offset)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t val;
+    uint32_t ret;
+    unsigned long flags;
+
+    ret = LINGSI_GPIO_DISABLE_PULL_UP_DOWN;
+
+    spin_lock_irqsave(&pctl->lock, flags);
+
+    regmap_read(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_PD_PU, &val);
+    if (val & (BIT(pin))) {
+        ret = LINGSI_GPIO_PULL_UP;
+    } else if (val & (BIT(pin + LINGSI_GPIO_PINS_PER_BANK))) {
+        ret = LINGSI_GPIO_PULL_DOWN;
+    }
+    //TBG
+    //both LINGSI_GPIO_PULL_UP & LINGSI_GPIO_PULL_DOWN
+
+    spin_unlock_irqrestore(&pctl->lock, flags);
+
+    return ret;
+}
+
+static bool lingsi_pconf_get(struct lingsi_pinctrl *pctl,
+                             uint32_t offset,
+                             bool dir)
+{
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t val;
+    unsigned long flags;
+
+    spin_lock_irqsave(&pctl->lock, flags);
+
+    if (dir) {
+        val = !!(regmap_test_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_HSS_DIN, BIT(pin)));
+    } else {
+        val = !!(regmap_test_bits(pctl->gpio_regmap, reg_offt + LINGSI_GPIO_DOT, BIT(pin)));
+    }
+
+    spin_unlock_irqrestore(&pctl->lock, flags);
+
+    return val;
+}
+
+static uint32_t lingsi_pconf_parse_conf(struct pinctrl_dev *pctldev,
+                                   uint32_t pin,
+                                   enum pin_config_param param,
+                                   enum pin_config_param arg)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    uint32_t ret = 0;
+
+    switch (param) {
+    case PIN_CONFIG_DRIVE_PUSH_PULL:
+        ret = lingsi_pconf_set_driving(pctl, pin, 0);
+        break;
+    case PIN_CONFIG_DRIVE_OPEN_DRAIN:
+        ret = lingsi_pconf_set_driving(pctl, pin, 1);
+        break;
+    case PIN_CONFIG_BIAS_DISABLE:
+        ret = lingsi_pconf_set_bias(pctl, pin, 0);
+        break;
+    case PIN_CONFIG_BIAS_PULL_UP:
+        ret = lingsi_pconf_set_bias(pctl, pin, 1);
+        break;
+    case PIN_CONFIG_BIAS_PULL_DOWN:
+        ret = lingsi_pconf_set_bias(pctl, pin, 2);
+        break;
+    case PIN_CONFIG_OUTPUT:
+        __lingsi_gpio_set(pctl, pin, arg);
+        ret = lingsi_pmx_gpio_set_direction(pctldev, pin, GPIO_LINE_DIRECTION_OUT);
+        break;
+    default:
+        ret = -ENOTSUPP;
+    }
+
+    return ret;
+}
+
+static int lingsi_pconf_group_get(struct pinctrl_dev *pctldev,
+                                  unsigned group,
+                                  unsigned long *config)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+
+    *config = pctl->groups[group].config;
+
+    return 0;
+}
+
+static int lingsi_pconf_group_set(struct pinctrl_dev *pctldev, unsigned group, unsigned long *configs, unsigned num_configs)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    struct lingsi_pinctrl_group *g = &pctl->groups[group];
+    uint32_t i;
+    int ret;
+
+    for (i = 0; i < num_configs; i++) {
+        mutex_lock(&pctldev->mutex);
+        ret = lingsi_pconf_parse_conf(pctldev, g->pin, pinconf_to_config_param(configs[i]), pinconf_to_config_argument(configs[i]));
+        mutex_unlock(&pctldev->mutex);
+        if (ret < 0) {
+            return ret;
+        }
+
+        g->config = configs[i];
+    }
+
+    return 0;
+}
+
+static int lingsi_pconf_set(struct pinctrl_dev *pctldev, uint32_t pin, unsigned long *configs, uint32_t num_configs)
+{
+    uint32_t i;
+    int ret;
+
+    for (i = 0; i < num_configs; i++) {
+        ret = lingsi_pconf_parse_conf(pctldev, pin, pinconf_to_config_param(configs[i]), pinconf_to_config_argument(configs[i]));
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+
+static struct lingsi_desc_pin *
+lingsi_pconf_get_pin_desc_by_pin_number(struct lingsi_pinctrl *pctl,
+                                        uint32_t pin_number)
+{
+    struct lingsi_desc_pin *pins = pctl->pins;
+    uint32_t i;
+
+    for (i = 0; i < pctl->npins; i++) {
+        if (pins->pin.number == pin_number)
+            return pins;
+        pins++;
+    }
+    return NULL;
+}
+
+static void lingsi_pconf_dbg_show(struct pinctrl_dev *pctldev,
+                                  struct seq_file *s,
+                                  uint32_t offset)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    const struct lingsi_desc_pin *pin_desc;
+    uint32_t mode;
+    uint32_t alt;
+    uint32_t drive;
+    uint32_t bias;
+    bool val;
+    static const char *const modes[] = {
+        "output", "input", "alternate", "analog"
+    };
+    static const char *const biasing[] = {
+        "disabled", "pull up", "pull down", ""
+    };
+
+    lingsi_pmx_get_mode(pctl, offset, &mode, &alt);
+    bias = lingsi_pconf_get_bias(pctl, offset);
+    switch (mode) {
+    /* output */
+    case GPIO_LINE_DIRECTION_OUT:
+        drive = lingsi_pconf_get_driving(pctl, offset);
+        val = lingsi_pconf_get(pctl, offset, false);
+        seq_printf(s, "mode [%s] - value [%s] - drive [%s]", modes[mode], val ? "high" : "low", drive ? "open drain" : "push pull");
+        break;
+
+    /* input */
+    case GPIO_LINE_DIRECTION_IN:
+        val = lingsi_pconf_get(pctl, offset, true);
+        seq_printf(s, "mode [%s] - value [%s] - bias [%s]", modes[mode], val ? "high" : "low", biasing[bias]);
+        break;
+
+    /* alternate */
+    case MODE_ALTER_FUNC:
+        drive = lingsi_pconf_get_driving(pctl, offset);
+        pin_desc = lingsi_pconf_get_pin_desc_by_pin_number(pctl, offset);
+        if (!pin_desc)
+            return;
+
+        seq_printf(s, "mode [%s] - alter_func [%d] - alter_name [%s] - drive [%s] - bias [%s]", modes[mode], alt, pin_desc->functions[alt].name, drive ? "open drain" : "push pull", biasing[bias]);
+        break;
+
+    default:
+        break;
+    }
+}
+
+static const struct pinconf_ops lingsi_pconf_ops = {
+    .pin_config_group_get = lingsi_pconf_group_get,
+    .pin_config_group_set = lingsi_pconf_group_set,
+    .pin_config_set = lingsi_pconf_set,
+    .pin_config_dbg_show = lingsi_pconf_dbg_show,
+};
+
+static uint32_t lingsi_pctrl_build_state(struct platform_device *pdev)
+{
+    struct lingsi_pinctrl *pctl = platform_get_drvdata(pdev);
+    uint32_t i;
+
+    pctl->ngroups = pctl->npins;
+
+    /* Allocate groups */
+    pctl->groups = devm_kcalloc(&pdev->dev, pctl->ngroups, sizeof(*pctl->groups), GFP_KERNEL);
+    if (!pctl->groups)
+        return -ENOMEM;
+    /* We assume that one pin is one group, use pin name as group name. */
+    pctl->grp_names = devm_kcalloc(&pdev->dev, pctl->ngroups, sizeof(*pctl->grp_names), GFP_KERNEL);
+    if (!pctl->grp_names)
+        return -ENOMEM;
+    for (i = 0; i < pctl->npins; i++) {
+        const struct lingsi_desc_pin *pin = pctl->pins + i;
+        struct lingsi_pinctrl_group *group = pctl->groups + i;
+
+        group->name = pin->pin.name;
+
+        group->pin = pin->pin.number;
+        pctl->grp_names[i] = pin->pin.name;
+    }
+    return 0;
+}
+
+static uint32_t lingsi_pctrl_create_pins_tab(struct lingsi_pinctrl *pctl,
+                                        struct lingsi_desc_pin *pins)
+{
+    const struct lingsi_desc_pin *p;
+    uint32_t i;
+    uint32_t nb_pins_available = 0;
+
+    for (i = 0; i < pctl->match_data->npins; i++) {
+        p = pctl->match_data->pins + i;
+        if (pctl->pkg && !(pctl->pkg & p->pkg))
+            continue;
+        pins->pin = p->pin;
+        memcpy((struct lingsi_desc_pin *)pins->functions, p->functions, LINGSI_CONFIG_NUM * sizeof(struct lingsi_desc_function));
+        pins++;
+        nb_pins_available++;
+    }
+
+    pctl->npins = nb_pins_available;
+
+    return 0;
+}
+
+int lingsi_pctl_probe(struct platform_device *pdev)
+{
+    const struct lingsi_pinctrl_match_data *match_data;
+    struct device *dev = &pdev->dev;
+    struct lingsi_pinctrl *pctl;
+    struct pinctrl_pin_desc *pins;
+    uint32_t i;
+    uint32_t hwlock_id;
+    int ret;
+
+    match_data = device_get_match_data(dev);
+    if (!match_data)
+        return -EINVAL;
+
+    pctl = devm_kzalloc(dev, sizeof(*pctl), GFP_KERNEL);
+    if (!pctl)
+        return -ENOMEM;
+
+    platform_set_drvdata(pdev, pctl);
+
+    pctl->sysc_awo_regmap =
+        syscon_regmap_lookup_by_compatible("lingsi,sysc_awo");
+    if (IS_ERR(pctl->sysc_awo_regmap)) {
+        dev_err(pctl->dev, "didn't find lingsi,sysc_awo\n");
+        return PTR_ERR(pctl->sysc_awo_regmap);
+    }
+
+    pctl->sysc_per_regmap =
+        syscon_regmap_lookup_by_compatible("lingsi,sysc_per");
+    if (IS_ERR(pctl->sysc_per_regmap)) {
+        dev_err(pctl->dev, "didn't find lingsi,sysc_per\n");
+        return PTR_ERR(pctl->sysc_per_regmap);
+    }
+
+    pctl->gpio_regmap =
+        syscon_regmap_lookup_by_compatible("lingsi,gpio");
+    if (IS_ERR(pctl->gpio_regmap)) {
+        dev_err(pctl->dev, "didn't find lingsi,gpio\n");
+        return PTR_ERR(pctl->gpio_regmap);
+    }
+
+    spin_lock_init(&pctl->lock);
+
+    /* hwspinlock is optional */
+    hwlock_id = of_hwspin_lock_get_id(pdev->dev.of_node, 0);
+    if (hwlock_id < 0) {
+        if (hwlock_id == -EPROBE_DEFER)
+            return hwlock_id;
+    } else {
+        pctl->hwlock = hwspin_lock_request_specific(hwlock_id);
+    }
+
+    pctl->dev = dev;
+    pctl->match_data = match_data;
+    /*  get optional package information */
+    if (!device_property_read_u32(dev, "lingsi,package", &pctl->pkg))
+        dev_dbg(pctl->dev, "package detected: %x\n", pctl->pkg);
+
+    pctl->pins = devm_kcalloc(pctl->dev, pctl->match_data->npins, sizeof(*pctl->pins), GFP_KERNEL);
+    if (!pctl->pins)
+        return -ENOMEM;
+    pctl->pflag = devm_kcalloc(pctl->dev, pctl->match_data->npins, sizeof(union pin_mode), GFP_KERNEL);
+    if (!pctl->pflag)
+        return -ENOMEM;
+    pctl->pmode = devm_kcalloc(pctl->dev, pctl->match_data->npins, sizeof(union pin_mode), GFP_KERNEL);
+    if (!pctl->pmode)
+        return -ENOMEM;
+    ret = lingsi_pctrl_create_pins_tab(pctl, pctl->pins);
+    if (ret)
+        return ret;
+    ret = lingsi_pctrl_build_state(pdev);
+    if (ret) {
+        dev_err(dev, "build state failed: %d\n", ret);
+        return -EINVAL;
+    }
+
+    pins = devm_kcalloc(&pdev->dev, pctl->npins, sizeof(*pins), GFP_KERNEL);
+    if (!pins)
+        return -ENOMEM;
+    for (i = 0; i < pctl->npins; i++)
+        pins[i] = pctl->pins[i].pin;
+
+    pctl->pctl_desc.name = dev_name(&pdev->dev);
+    pctl->pctl_desc.owner = THIS_MODULE;
+    pctl->pctl_desc.pins = pins;
+    pctl->pctl_desc.npins = pctl->npins;
+    pctl->pctl_desc.link_consumers = true;
+    pctl->pctl_desc.confops = &lingsi_pconf_ops;
+    pctl->pctl_desc.pctlops = &lingsi_pctrl_ops;
+    pctl->pctl_desc.pmxops = &lingsi_pmx_ops;
+    pctl->dev = &pdev->dev;
+    pctl->pctl_dev = devm_pinctrl_register(&pdev->dev, &pctl->pctl_desc, pctl);
+    if (IS_ERR(pctl->pctl_dev)) {
+        dev_err(&pdev->dev, "Failed pinctrl registration\n");
+        return PTR_ERR(pctl->pctl_dev);
+    }
+
+    dev_info(dev, "initialized\n");
+    return 0;
+}
+
+MODULE_AUTHOR("Hunter Liu <htliu@linkedsemi.com>");
+MODULE_DESCRIPTION("linkedsemi GPIO driver");
+MODULE_LICENSE("GPL v2");
