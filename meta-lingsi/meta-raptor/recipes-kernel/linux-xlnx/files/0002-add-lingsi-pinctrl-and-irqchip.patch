+};
+
+struct lingsi_peri_drv_data {
+    const struct lingsi_peri_bank **peri_banks;
+    const u8 *desc_irqs;
+    u32 bank_nr;
+};
+
+struct lingsi_peri_chip_data {
+    struct lingsi_peri_host_data *host_data;
+    const struct lingsi_peri_bank *reg_bank;
+    struct raw_spinlock rlock;
+};
+
+struct lingsi_peri_host_data {
+    void __iomem *base;
+    struct lingsi_peri_chip_data *chips_data;
+    const struct lingsi_peri_drv_data *drv_data;
+    struct hwspinlock *hwlock;
+};
+
+static struct lingsi_peri_host_data *lingsi_host_data;
+
+static const struct lingsi_peri_bank lingsiraptor_peri_b1 = {
+    .ctrl = LINGSI_PERI_CTRL,
+    .mask = LINGSI_PERI_MASK0,
+    .clr  = LINGSI_PERI_CLR0,
+    .stt  = LINGSI_PERI_STT0,
+    .raw  = LINGSI_PERI_RAW0,
+};
+
+static const struct lingsi_peri_bank lingsiraptor_peri_b2 = {
+    .ctrl = LINGSI_PERI_CTRL,
+    .mask = LINGSI_PERI_MASK1,
+    .clr  = LINGSI_PERI_CLR1,
+    .stt  = LINGSI_PERI_STT1,
+    .raw  = LINGSI_PERI_RAW1,
+};
+
+static const struct lingsi_peri_bank *lingsiraptor_peri_banks[] = {
+    &lingsiraptor_peri_b1,
+    &lingsiraptor_peri_b2,
+};
+
+static const struct lingsi_peri_drv_data lingsi_raptor_drv_data = {
+    .peri_banks = lingsiraptor_peri_banks,
+    .bank_nr = ARRAY_SIZE(lingsiraptor_peri_banks),
+};
+
+static unsigned long lingsi_peri_pending(struct irq_chip_generic *gc)
+{
+    struct lingsi_peri_chip_data *chip_data = gc->private;
+    void __iomem *base = chip_data->host_data->base;
+    const struct lingsi_peri_bank *lingsi_bank = chip_data->reg_bank;
+    unsigned long pending = 0;
+    pending = readl_relaxed(base + lingsi_bank->stt);
+
+    return pending;
+}
+
+static void lingsi_irq_handler(struct irq_desc *desc)
+{
+    struct irq_domain *domain = irq_desc_get_handler_data(desc);
+    struct irq_chip *chip = irq_desc_get_chip(desc);
+    unsigned int nbanks = domain->gc->num_chips;
+    struct irq_chip_generic *gc;
+    unsigned long pending;
+    int n, i, irq_base = 0;
+    chained_irq_enter(chip, desc);
+
+    for (i = 0; i < nbanks; i++, irq_base += IRQS_PER_BANK) {
+        gc = irq_get_domain_generic_chip(domain, irq_base);
+        while ((pending = lingsi_peri_pending(gc))) {
+            if (pending) {
+                for_each_set_bit(n, &(pending), IRQS_PER_BANK) {
+                    generic_handle_domain_irq(domain, irq_base + n);
+                }
+            }
+         }
+    }
+
+    chained_irq_exit(chip, desc);
+}
+
+static int lingsi_peri_alloc(struct irq_domain *d, unsigned int virq,
+                unsigned int nr_irqs, void *data)
+{
+    struct irq_fwspec *fwspec = data;
+    irq_hw_number_t hwirq;
+    hwirq = fwspec->param[0];
+
+    irq_map_generic_chip(d, virq, hwirq);
+    return 0;
+}
+
+static void lingsi_peri_free(struct irq_domain *d, unsigned int virq,
+                unsigned int nr_irqs)
+{
+    struct irq_data *data = irq_domain_get_irq_data(d, virq);
+    irq_domain_reset_irq_data(data);
+}
+
+static const struct irq_domain_ops irq_peri_domain_ops = {
+    .map    = irq_map_generic_chip,
+    .alloc  = lingsi_peri_alloc,
+    .free   = lingsi_peri_free,
+};
+
+static struct
+lingsi_peri_host_data *lingsi_peri_host_init(const struct lingsi_peri_drv_data *dd,
+                       struct device_node *node)
+{
+    struct lingsi_peri_host_data *host_data;
+    host_data = kzalloc(sizeof(*host_data), GFP_KERNEL);
+    if (!host_data)
+        return NULL;
+
+    host_data->drv_data = dd;
+    host_data->chips_data = kcalloc(dd->bank_nr,
+                    sizeof(struct lingsi_peri_chip_data),
+                    GFP_KERNEL);
+    if (!host_data->chips_data)
+        goto free_host_data;
+
+    host_data->base = of_iomap(node, 0);
+    if (!host_data->base) {
+        pr_err("%pOF: Unable to map registers\n", node);
+        goto free_chips_data;
+    }
+
+    lingsi_host_data = host_data;
+
+    return host_data;
+
+free_chips_data:
+    kfree(host_data->chips_data);
+free_host_data:
+    kfree(host_data);
+
+    return NULL;
+}
+
+static struct
+lingsi_peri_chip_data *lingsi_peri_chip_init(struct lingsi_peri_host_data *h_data,
+                       u32 bank_idx,
+                       struct device_node *node)
+{
+    const struct lingsi_peri_bank *lingsi_bank;
+    struct lingsi_peri_chip_data *chip_data;
+    lingsi_bank = h_data->drv_data->peri_banks[bank_idx];
+    chip_data = &h_data->chips_data[bank_idx];
+    chip_data->host_data = h_data;
+    chip_data->reg_bank = lingsi_bank;
+
+    raw_spin_lock_init(&chip_data->rlock);
+
+    pr_info("%pOF: bank%d\n", node, bank_idx);
+
+    return chip_data;
+}
+
+static int lingsi_irq_set_irqchip_state(struct irq_data *d,
+                     enum irqchip_irq_state which, bool val)
+{
+    struct irq_chip_generic *gc = irq_data_get_irq_chip_data(d);
+    struct lingsi_peri_chip_data *chip_data = gc->private;
+    void __iomem *base = chip_data->host_data->base;
+    const struct lingsi_peri_bank *lingsi_bank = chip_data->reg_bank;
+    uint32_t hwirq = irqd_to_hwirq(d) % IRQS_PER_BANK;
+
+    switch (which) {
+    case IRQCHIP_STATE_PENDING:
+        if (!val) {
+            iowrite32(BIT(hwirq), base + lingsi_bank->clr);
+        }
+        break;
+
+    case IRQCHIP_STATE_MASKED:
+        iowrite32(BIT(hwirq), base + lingsi_bank->mask);
+        break;
+
+    default:
+        return -EINVAL;
+    }
+
+    return 0;
+}
+
+static int lingsi_irq_get_irqchip_state(struct irq_data *d,
+                     enum irqchip_irq_state which, bool *val)
+{
+    struct irq_chip_generic *gc = irq_data_get_irq_chip_data(d);
+    struct lingsi_peri_chip_data *chip_data = gc->private;
+    void __iomem *base = chip_data->host_data->base;
+    const struct lingsi_peri_bank *lingsi_bank = chip_data->reg_bank;
+    uint32_t hwirq = irqd_to_hwirq(d) % IRQS_PER_BANK;
+    unsigned long data;
+
+    irq_gc_lock(gc);
+
+    switch (which) {
+    case IRQCHIP_STATE_PENDING:
+        data = ioread32(base + lingsi_bank->raw);
+        *val = test_bit(hwirq, &data);
+        break;
+
+    case IRQCHIP_STATE_MASKED:
+        data = ioread32(base + lingsi_bank->mask);
+        *val = test_bit(hwirq, &data);
+        break;
+
+    default:
+        return -EINVAL;
+    }
+
+    irq_gc_unlock(gc);
+    return 0;
+}
+
+static int __init lingsi_peri_init(const struct lingsi_peri_drv_data *drv_data,
+                  struct device_node *node)
+{
+    struct lingsi_peri_host_data *host_data;
+    unsigned int clr = IRQ_NOREQUEST | IRQ_NOPROBE | IRQ_NOAUTOEN;
+    int nr_irqs, ret, i;
+    struct irq_chip_generic *gc;
+    struct irq_domain *domain;
+    host_data = lingsi_peri_host_init(drv_data, node);
+    if (!host_data)
+        return -ENOMEM;
+
+    domain = irq_domain_add_linear(node, drv_data->bank_nr * IRQS_PER_BANK,
+                       &irq_peri_domain_ops, NULL);
+    if (!domain) {
+        pr_err("%pOFn: Could not register interrupt domain.\n",
+               node);
+        ret = -ENOMEM;
+        goto out_unmap;
+    }
+
+    ret = irq_alloc_domain_generic_chips(domain, IRQS_PER_BANK, 1, "lingsi_peri",
+                         handle_edge_irq, clr, 0, 0);
+    if (ret) {
+        pr_err("%pOF: Could not allocate generic interrupt chip.\n",
+               node);
+        goto out_free_domain;
+    }
+
+    for (i = 0; i < drv_data->bank_nr; i++) {
+        const struct lingsi_peri_bank *lingsi_bank;
+        struct lingsi_peri_chip_data *chip_data;
+        lingsi_bank = drv_data->peri_banks[i];
+        chip_data = lingsi_peri_chip_init(host_data, i, node);
+        gc = irq_get_domain_generic_chip(domain, i * IRQS_PER_BANK);
+        gc->reg_base = host_data->base;
+        gc->chip_types->type = IRQ_TYPE_EDGE_BOTH;
+        gc->chip_types->chip.irq_unmask = irq_gc_mask_set_bit;
+        gc->chip_types->chip.irq_mask = irq_gc_mask_clr_bit;
+        gc->chip_types->chip.irq_ack = irq_gc_ack_set_bit;
+        gc->chip_types->chip.irq_get_irqchip_state = lingsi_irq_get_irqchip_state,
+        gc->chip_types->chip.irq_set_irqchip_state = lingsi_irq_set_irqchip_state,
+        gc->chip_types->regs.mask = lingsi_bank->mask;
+        gc->chip_types->regs.ack = lingsi_bank->clr;
+        gc->private = (void *)chip_data;
+    }
+    nr_irqs = of_irq_count(node);
+    for (i = 0; i < nr_irqs; i++) {
+        unsigned int irq = irq_of_parse_and_map(node, i);
+        irq_set_handler_data(irq, domain);
+        irq_set_chained_handler(irq, lingsi_irq_handler);
+    }
+    return 0;
+
+out_free_domain:
+    irq_domain_remove(domain);
+out_unmap:
+    iounmap(host_data->base);
+    kfree(host_data->chips_data);
+    kfree(host_data);
+    return ret;
+}
+
+static int __init lingsi_peri_of_init(struct device_node *np,
+                       struct device_node *parent)
+{
+    return lingsi_peri_init(&lingsi_raptor_drv_data, np);
+}
+
+IRQCHIP_DECLARE(lingsi_peri, "lingsi,peri-intc", lingsi_peri_of_init);
