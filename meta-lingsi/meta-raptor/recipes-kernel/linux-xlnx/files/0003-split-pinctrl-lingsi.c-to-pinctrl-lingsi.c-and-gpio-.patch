diff --git a/drivers/gpio/gpio-lingsi.c b/drivers/gpio/gpio-lingsi.c
new file mode 100644
index 000000000000..35783ee02f2a
--- /dev/null
+++ b/drivers/gpio/gpio-lingsi.c
@@ -0,0 +1,347 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// Copyright (C) 2024 linkedsemi
+//   Author: Hunter Liu <htliu@linkedsemi.com>
+
+#include <linux/bits.h>
+#include <linux/gpio/driver.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#define LINGSI_GPIO_IRQ_MAX_NUM       128
+#define LINGSI_GPIO_REG_SIZE_PER_BANK 0x20
+#define LINGSI_GPIO_PINS_PER_BANK     16
+
+#define LINGSI_GPIO_PORT(bank, line) \
+    ((LINGSI_GPIO_PINS_PER_BANK) * (bank) + (line))
+
+#define LINGSI_GPIO_LVS_LOCK 0x00
+#define LINGSI_GPIO_DOT      0x04
+#define LINGSI_GPIO_PD_PU    0x08
+#define LINGSI_GPIO_IEN_OD   0x0c
+#define LINGSI_GPIO_DS       0x10
+#define LINGSI_GPIO_AE       0x14
+#define LINGSI_GPIO_OE_FIR   0x18
+#define LINGSI_GPIO_HSS_DIN  0x1c
+
+struct lingsi_gpio_priv {
+    struct gpio_chip chip;
+    struct irq_chip irq_chip;
+    struct irq_domain *domain;
+    void __iomem *base;
+    spinlock_t lock;
+    u32 saved_vals[];
+};
+
+static inline uint32_t lingsi_gpio_pin(uint32_t gpio)
+{
+    return gpio % LINGSI_GPIO_PINS_PER_BANK;
+}
+
+static inline uint32_t lingsi_gpio_bank(uint32_t gpio)
+{
+    return gpio / LINGSI_GPIO_PINS_PER_BANK;
+}
+
+static inline uint32_t lingsi_gpio_bank_base(uint32_t bank)
+{
+    return bank * LINGSI_GPIO_REG_SIZE_PER_BANK;
+}
+
+static int lingsi_gpio_get_direction(struct gpio_chip *chip,
+                                     unsigned int offset)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+    if (reg & BIT(pin + LINGSI_GPIO_PINS_PER_BANK))
+        return GPIO_LINE_DIRECTION_OUT;
+
+    return GPIO_LINE_DIRECTION_IN;
+}
+
+static int lingsi_gpio_direction_input(struct gpio_chip *chip,
+                                       unsigned int offset)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+    reg &= ~(BIT(pin + LINGSI_GPIO_PINS_PER_BANK));
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+    reg &= ~(BIT(pin + LINGSI_GPIO_PINS_PER_BANK));
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+
+    return 0;
+}
+
+static int lingsi_gpio_direction_output(struct gpio_chip *chip,
+                                        unsigned int offset,
+                                        int val)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+    reg |= BIT(pin + LINGSI_GPIO_PINS_PER_BANK);
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_IEN_OD);
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+    reg |= BIT(pin + LINGSI_GPIO_PINS_PER_BANK);
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_OE_FIR);
+
+    if (val) {
+        reg = BIT(pin);
+    } else {
+        reg = BIT(pin + LINGSI_GPIO_PINS_PER_BANK);
+    }
+    iowrite32(reg, priv->base + reg_offt + LINGSI_GPIO_DOT);
+
+    return 0;
+}
+
+static int lingsi_gpio_get(struct gpio_chip *chip, unsigned int offset)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+    uint32_t reg;
+
+    reg = ioread32(priv->base + reg_offt + LINGSI_GPIO_HSS_DIN) & BIT(pin);
+    return !!reg;
+}
+
+static void lingsi_gpio_set(struct gpio_chip *chip,
+                            unsigned int offset,
+                            int val)
+{
+    struct lingsi_gpio_priv *priv = gpiochip_get_data(chip);
+    uint16_t bank = lingsi_gpio_bank(offset);
+    uint16_t pin = lingsi_gpio_pin(offset);
+    uint32_t reg_offt = lingsi_gpio_bank_base(bank);
+
+    if (val) {
+        iowrite32(BIT(pin), priv->base + reg_offt + LINGSI_GPIO_DOT);
+    } else {
+        iowrite32(BIT(pin + LINGSI_GPIO_PINS_PER_BANK), priv->base + reg_offt + LINGSI_GPIO_DOT);
+    }
+}
+
+static int lingsi_gpio_to_irq(struct gpio_chip *chip, unsigned int offset)
+{
+    struct irq_fwspec fwspec;
+
+    if (offset > LINGSI_GPIO_IRQ_MAX_NUM)
+        return -ENXIO;
+
+    fwspec.fwnode = of_node_to_fwnode(chip->parent->of_node);
+    fwspec.param_count = 2;
+    fwspec.param[0] = offset;
+    /*
+     * IRQ_TYPE_NONE is rejected by the parent irq domain. Set LEVEL_HIGH
+     * temporarily. Anyway, ->irq_set_type() will override it later.
+     */
+    fwspec.param[1] = IRQ_TYPE_LEVEL_HIGH;
+
+    return irq_create_fwspec_mapping(&fwspec);
+}
+
+static int lingsi_gpio_irq_domain_translate(struct irq_domain *domain,
+                                            struct irq_fwspec *fwspec,
+                                            unsigned long *out_hwirq,
+                                            unsigned int *out_type)
+{
+    if (WARN_ON(fwspec->param_count < 2))
+        return -EINVAL;
+
+    *out_hwirq = fwspec->param[0];
+    *out_type = fwspec->param[1] & IRQ_TYPE_SENSE_MASK;
+
+    return 0;
+}
+
+static int lingsi_gpio_irq_domain_alloc(struct irq_domain *domain,
+                                        unsigned int virq,
+                                        unsigned int nr_irqs,
+                                        void *arg)
+{
+    struct lingsi_gpio_priv *priv = domain->host_data;
+    struct irq_fwspec *fwspec = arg;
+    struct irq_fwspec parent_fwspec;
+    irq_hw_number_t hwirq;
+    unsigned int type;
+    int ret;
+
+    if (WARN_ON(nr_irqs != 1))
+        return -EINVAL;
+
+    ret = lingsi_gpio_irq_domain_translate(domain, arg, &hwirq, &type);
+    if (ret)
+        return ret;
+
+    /* parent is lingsi exti_intc */
+    parent_fwspec.fwnode = domain->parent->fwnode;
+    parent_fwspec.param_count = 2;
+    parent_fwspec.param[0] = fwspec->param[0];
+    parent_fwspec.param[1] = fwspec->param[1];
+
+    ret = irq_domain_set_hwirq_and_chip(domain, virq, fwspec->param[0], &priv->irq_chip, priv);
+    if (ret)
+        return ret;
+
+    return irq_domain_alloc_irqs_parent(domain, virq, nr_irqs, &parent_fwspec);
+}
+
+static int lingsi_gpio_irq_domain_activate(struct irq_domain *domain,
+                                           struct irq_data *data,
+                                           bool early)
+{
+    struct lingsi_gpio_priv *priv = domain->host_data;
+    struct gpio_chip *chip = &priv->chip;
+
+    return gpiochip_lock_as_irq(chip, irqd_to_hwirq(data));
+}
+
+static void lingsi_gpio_irq_domain_deactivate(struct irq_domain *domain,
+                                              struct irq_data *data)
+{
+    struct lingsi_gpio_priv *priv = domain->host_data;
+    struct gpio_chip *chip = &priv->chip;
+
+    gpiochip_unlock_as_irq(chip, irqd_to_hwirq(data));
+}
+
+static const struct irq_domain_ops lingsi_gpio_irq_domain_ops = {
+    .alloc = lingsi_gpio_irq_domain_alloc,
+    .free = irq_domain_free_irqs_common,
+    .activate = lingsi_gpio_irq_domain_activate,
+    .deactivate = lingsi_gpio_irq_domain_deactivate,
+    .translate = lingsi_gpio_irq_domain_translate,
+};
+
+static unsigned int lingsi_gpio_get_nbanks(unsigned int ngpio)
+{
+    return DIV_ROUND_UP(ngpio, LINGSI_GPIO_PINS_PER_BANK);
+}
+
+static int lingsi_gpio_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct device_node *parent_np;
+    struct irq_domain *parent_domain;
+    struct lingsi_gpio_priv *priv;
+    struct gpio_chip *chip;
+    struct irq_chip *irq_chip;
+    unsigned int nregs;
+    u32 ngpios;
+    int ret;
+
+    parent_np = of_irq_find_parent(dev->of_node);
+    if (!parent_np)
+        return -ENXIO;
+
+    parent_domain = irq_find_host(parent_np);
+    of_node_put(parent_np);
+    if (!parent_domain)
+        return -EPROBE_DEFER;
+
+    ret = of_property_read_u32(dev->of_node, "ngpios", &ngpios);
+    if (ret)
+        return ret;
+
+    nregs = lingsi_gpio_get_nbanks(ngpios);
+    priv = devm_kzalloc(dev, struct_size(priv, saved_vals, nregs), GFP_KERNEL);
+    if (!priv)
+        return -ENOMEM;
+
+    priv->base = devm_platform_ioremap_resource(pdev, 0);
+    if (IS_ERR(priv->base))
+        return PTR_ERR(priv->base);
+
+    spin_lock_init(&priv->lock);
+
+    chip = &priv->chip;
+    chip->label = dev_name(dev);
+    chip->parent = dev;
+    chip->request = gpiochip_generic_request;
+    chip->free = gpiochip_generic_free;
+    chip->get_direction = lingsi_gpio_get_direction;
+    chip->direction_input = lingsi_gpio_direction_input;
+    chip->direction_output = lingsi_gpio_direction_output;
+    chip->get = lingsi_gpio_get;
+    chip->set = lingsi_gpio_set;
+    chip->to_irq = lingsi_gpio_to_irq;
+    chip->base = -1;
+    chip->ngpio = ngpios;
+
+    irq_chip = &priv->irq_chip;
+    irq_chip->name = dev_name(dev);
+    irq_chip->irq_eoi = irq_chip_eoi_parent;
+    irq_chip->irq_ack = irq_chip_ack_parent,
+    irq_chip->irq_mask = irq_chip_mask_parent;
+    irq_chip->irq_unmask = irq_chip_unmask_parent;
+    irq_chip->irq_set_affinity = irq_chip_set_affinity_parent;
+    irq_chip->irq_set_type = irq_chip_set_type_parent;
+
+    ret = devm_gpiochip_add_data(dev, chip, priv);
+    if (ret)
+        return ret;
+
+    priv->domain = irq_domain_create_hierarchy(
+        parent_domain, 0, LINGSI_GPIO_IRQ_MAX_NUM, of_node_to_fwnode(dev->of_node), &lingsi_gpio_irq_domain_ops, priv);
+    if (!priv->domain)
+        return -ENOMEM;
+
+    platform_set_drvdata(pdev, priv);
+
+    dev_info(dev, "initialized\n");
+    return 0;
+}
+
+static int lingsi_gpio_remove(struct platform_device *pdev)
+{
+    struct lingsi_gpio_priv *priv = platform_get_drvdata(pdev);
+
+    irq_domain_remove(priv->domain);
+
+    return 0;
+}
+
+static const struct of_device_id lingsi_gpio_match[] = {
+    { .compatible = "lingsi,gpio" },
+    { /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lingsi_gpio_match);
+
+static struct platform_driver lingsi_gpio_driver = {
+    .probe = lingsi_gpio_probe,
+    .remove = lingsi_gpio_remove,
+    .driver = {
+        .name = "lingsi-gpio",
+        .of_match_table = lingsi_gpio_match,
+    },
+};
+module_platform_driver(lingsi_gpio_driver);
+
+MODULE_AUTHOR("Hunter Liu <htliu@linkedsemi.com>");
+MODULE_DESCRIPTION("linkedsemi GPIO driver");
+MODULE_LICENSE("GPL v2");
