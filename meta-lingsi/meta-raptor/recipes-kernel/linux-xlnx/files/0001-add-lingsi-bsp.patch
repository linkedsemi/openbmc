+/* Pinconf functions */
+
+static int lingsi_pconf_set_driving(struct lingsi_gpio_bank *bank,
+                   unsigned offset, u32 drive)
+{
+    struct lingsi_pinctrl *pctl = dev_get_drvdata(bank->gpio_chip.parent);
+    unsigned long flags;
+    u32 val;
+    int err = 0;
+    spin_lock_irqsave(&bank->lock, flags);
+
+    if (pctl->hwlock) {
+        err = hwspin_lock_timeout_in_atomic(pctl->hwlock,
+                            HWSPNLCK_TIMEOUT);
+        if (err) {
+            dev_err(pctl->dev, "Can't get hwspinlock\n");
+            goto unlock;
+        }
+    }
+
+    val = readl_relaxed(bank->base + LINGSI_GPIO_IEN_OD);
+    val &= ~BIT(offset);
+    val |= drive << offset;
+    iowrite32(val, bank->base + LINGSI_GPIO_IEN_OD);
+
+    if (pctl->hwlock)
+        hwspin_unlock_in_atomic(pctl->hwlock);
+
+    lingsi_gpio_backup_driving(bank, offset, drive);
+
+unlock:
+    spin_unlock_irqrestore(&bank->lock, flags);
+
+    return err;
+}
+
+static u32 lingsi_pconf_get_driving(struct lingsi_gpio_bank *bank,
+    unsigned int offset)
+{
+    unsigned long flags;
+    u32 val;
+    spin_lock_irqsave(&bank->lock, flags);
+
+    val = readl_relaxed(bank->base + LINGSI_GPIO_IEN_OD);
+    val &= BIT(offset);
+
+    spin_unlock_irqrestore(&bank->lock, flags);
+
+    return (val >> offset);
+}
+
+static int lingsi_pconf_set_bias(struct lingsi_gpio_bank *bank,
+                unsigned offset, u32 bias)
+{
+    struct lingsi_pinctrl *pctl = dev_get_drvdata(bank->gpio_chip.parent);
+    unsigned long flags;
+    u32 val;
+    int err = 0;
+    spin_lock_irqsave(&bank->lock, flags);
+
+    if (pctl->hwlock) {
+        err = hwspin_lock_timeout_in_atomic(pctl->hwlock,
+                            HWSPNLCK_TIMEOUT);
+        if (err) {
+            dev_err(pctl->dev, "Can't get hwspinlock\n");
+            goto unlock;
+        }
+    }
+
+    val = readl_relaxed(bank->base + LINGSI_GPIO_PUPD);
+    if(bias == LINGSI_GPIO_PULL_UP) {
+        val |= BIT(offset + SYSC_AWO_GPIOE_PU_POS);
+    } else if(bias == LINGSI_GPIO_PULL_DOWN) {
+        val |= BIT(offset + SYSC_AWO_GPIOE_PD_POS);
+    }
+    iowrite32(val, bank->base + LINGSI_GPIO_PUPD);
+
+    if (pctl->hwlock)
+        hwspin_unlock_in_atomic(pctl->hwlock);
+
+    lingsi_gpio_backup_bias(bank, offset, bias);
+
+unlock:
+    spin_unlock_irqrestore(&bank->lock, flags);
+
+    return err;
+}
+
+static u32 lingsi_pconf_get_bias(struct lingsi_gpio_bank *bank,
+    unsigned int offset)
+{
+    unsigned long flags;
+    u32 val;
+    u32 ret;
+    ret = LINGSI_GPIO_DISABLE_PULL_UP_DOWN;
+
+    spin_lock_irqsave(&bank->lock, flags);
+    val = readl_relaxed(bank->base + LINGSI_GPIO_PUPD);
+    if(val & (BIT(offset + SYSC_AWO_GPIOE_PU_POS))) {
+        ret = LINGSI_GPIO_PULL_UP;
+    } else if(val & (BIT(offset + SYSC_AWO_GPIOE_PD_POS))) {
+        ret = LINGSI_GPIO_PULL_DOWN;
+    }
+
+    spin_unlock_irqrestore(&bank->lock, flags);
+
+    return ret;
+}
+
+static bool lingsi_pconf_get(struct lingsi_gpio_bank *bank,
+    unsigned int offset, bool dir)
+{
+    unsigned long flags;
+    u32 val;
+    spin_lock_irqsave(&bank->lock, flags);
+
+    if (dir)
+        val = !!(readl_relaxed(bank->base + LINGSI_GPIO_DIN) &
+             BIT(offset));
+    else
+        val = !!(readl_relaxed(bank->base + LINGSI_GPIO_DOT) &
+             BIT(offset));
+
+    spin_unlock_irqrestore(&bank->lock, flags);
+
+    return val;
+}
+
+static int lingsi_pconf_parse_conf(struct pinctrl_dev *pctldev,
+        unsigned int pin, enum pin_config_param param,
+        enum pin_config_param arg)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    struct pinctrl_gpio_range *range;
+    struct lingsi_gpio_bank *bank;
+    int offset, ret = 0;
+
+    range = pinctrl_find_gpio_range_from_pin_nolock(pctldev, pin);
+    if (!range) {
+        dev_err(pctl->dev, "No gpio range defined.\n");
+        return -EINVAL;
+    }
+
+    bank = gpiochip_get_data(range->gc);
+    offset = lingsi_gpio_pin(pin);
+
+    if (!gpiochip_line_is_valid(range->gc, offset)) {
+        dev_warn(pctl->dev, "Can't access gpio %d\n", pin);
+        return -EACCES;
+    }
+
+    switch (param) {
+    case PIN_CONFIG_DRIVE_PUSH_PULL:
+        ret = lingsi_pconf_set_driving(bank, offset, 0);
+        break;
+    case PIN_CONFIG_DRIVE_OPEN_DRAIN:
+        ret = lingsi_pconf_set_driving(bank, offset, 1);
+        break;
+    case PIN_CONFIG_BIAS_DISABLE:
+        ret = lingsi_pconf_set_bias(bank, offset, 0);
+        break;
+    case PIN_CONFIG_BIAS_PULL_UP:
+        ret = lingsi_pconf_set_bias(bank, offset, 1);
+        break;
+    case PIN_CONFIG_BIAS_PULL_DOWN:
+        ret = lingsi_pconf_set_bias(bank, offset, 2);
+        break;
+    case PIN_CONFIG_OUTPUT:
+        __lingsi_gpio_set(bank, offset, arg);
+        ret = lingsi_pmx_gpio_set_direction(pctldev, range, pin, GPIO_LINE_DIRECTION_OUT);
+        break;
+    default:
+        ret = -ENOTSUPP;
+    }
+
+    return ret;
+}
+
+static int lingsi_pconf_group_get(struct pinctrl_dev *pctldev,
+                 unsigned group,
+                 unsigned long *config)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    *config = pctl->groups[group].config;
+
+    return 0;
+}
+
+static int lingsi_pconf_group_set(struct pinctrl_dev *pctldev, unsigned group,
+                 unsigned long *configs, unsigned num_configs)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    struct lingsi_pinctrl_group *g = &pctl->groups[group];
+    int i, ret;
+    for (i = 0; i < num_configs; i++) {
+        mutex_lock(&pctldev->mutex);
+        ret = lingsi_pconf_parse_conf(pctldev, g->pin,
+            pinconf_to_config_param(configs[i]),
+            pinconf_to_config_argument(configs[i]));
+        mutex_unlock(&pctldev->mutex);
+        if (ret < 0) {
+            return ret;
+        }
+
+        g->config = configs[i];
+    }
+
+    return 0;
+}
+
+static int lingsi_pconf_set(struct pinctrl_dev *pctldev, unsigned int pin,
+               unsigned long *configs, unsigned int num_configs)
+{
+    int i, ret;
+    for (i = 0; i < num_configs; i++) {
+        ret = lingsi_pconf_parse_conf(pctldev, pin,
+                pinconf_to_config_param(configs[i]),
+                pinconf_to_config_argument(configs[i]));
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+
+static struct lingsi_desc_pin *
+lingsi_pconf_get_pin_desc_by_pin_number(struct lingsi_pinctrl *pctl,
+                       unsigned int pin_number)
+{
+    struct lingsi_desc_pin *pins = pctl->pins;
+    int i;
+    for (i = 0; i < pctl->npins; i++) {
+        if (pins->pin.number == pin_number)
+            return pins;
+        pins++;
+    }
+    return NULL;
+}
+
+static void lingsi_pconf_dbg_show(struct pinctrl_dev *pctldev,
+                 struct seq_file *s,
+                 unsigned int pin)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    const struct lingsi_desc_pin *pin_desc;
+    struct pinctrl_gpio_range *range;
+    struct lingsi_gpio_bank *bank;
+    int offset;
+    u32 mode, alt, drive, speed, bias;
+    static const char * const modes[] = {
+            "input", "output", "alternate", "analog" };
+    static const char * const speeds[] = {
+            "low", "medium", "high", "very high" };
+    static const char * const biasing[] = {
+            "floating", "pull up", "pull down", "" };
+    bool val;
+    range = pinctrl_find_gpio_range_from_pin_nolock(pctldev, pin);
+    if (!range)
+        return;
+
+    bank = gpiochip_get_data(range->gc);
+    offset = lingsi_gpio_pin(pin);
+
+    if (!gpiochip_line_is_valid(range->gc, offset)) {
+        seq_puts(s, "NO ACCESS");
+        return;
+    }
+
+    lingsi_pmx_get_mode(bank, offset, &mode, &alt);
+    bias = lingsi_pconf_get_bias(bank, offset);
+
+    seq_printf(s, "%s ", modes[mode]);
+
+    switch (mode) {
+    /* output */
+    case GPIO_LINE_DIRECTION_OUT:
+        drive = lingsi_pconf_get_driving(bank, offset);
+        val = lingsi_pconf_get(bank, offset, false);
+        seq_printf(s, "- %s - %s - %s - %s %s",
+               val ? "high" : "low",
+               drive ? "open drain" : "push pull",
+               biasing[bias],
+               speeds[speed], "speed");
+        break;
+
+    /* input */
+    case GPIO_LINE_DIRECTION_IN:
+        val = lingsi_pconf_get(bank, offset, true);
+        seq_printf(s, "- %s - %s",
+               val ? "high" : "low",
+               biasing[bias]);
+        break;
+
+    /* alternate */
+    case 2:
+        drive = lingsi_pconf_get_driving(bank, offset);
+        pin_desc = lingsi_pconf_get_pin_desc_by_pin_number(pctl, pin);
+        if (!pin_desc)
+            return;
+
+        seq_printf(s, "%d (%s) - %s - %s - %s %s", alt,
+               pin_desc->functions[alt + 1].name,
+               drive ? "open drain" : "push pull",
+               biasing[bias],
+               speeds[speed], "speed");
+        break;
+
+    /* analog */
+    case 3:
+        break;
+    }
+}
+
+static const struct pinconf_ops lingsi_pconf_ops = {
+    .pin_config_group_get    = lingsi_pconf_group_get,
+    .pin_config_group_set    = lingsi_pconf_group_set,
+    .pin_config_set        = lingsi_pconf_set,
+    .pin_config_dbg_show    = lingsi_pconf_dbg_show,
+};
+
+static int lingsi_gpiolib_register_bank(struct lingsi_pinctrl *pctl, struct fwnode_handle *fwnode)
+{
+    struct lingsi_gpio_bank *bank = &pctl->banks[pctl->nbanks];
+    int bank_ioport_nr;
+    struct pinctrl_gpio_range *range = &bank->range;
+    struct fwnode_reference_args args;
+    struct device *dev = pctl->dev;
+    struct resource res;
+    int npins = LINGSI_GPIO_PINS_PER_BANK;
+    int bank_nr, err, i = 0;
+
+    if (!IS_ERR(bank->rstc))
+        reset_control_deassert(bank->rstc);
+
+    if (of_address_to_resource(to_of_node(fwnode), 0, &res)) {
+        return -ENODEV;
+    }
+
+    bank->base = devm_ioremap_resource(dev, &res);
+    if (IS_ERR(bank->base))
+        return PTR_ERR(bank->base);
+
+    if (IS_ERR(bank->base)) {
+        return PTR_ERR(bank->base);
+    }
+
+    bank->gpio_chip = lingsi_gpio_template;
+
+    fwnode_property_read_string(fwnode, "lingsi,bank-name", &bank->gpio_chip.label);
+
+    if (!fwnode_property_get_reference_args(fwnode, "gpio-ranges", NULL, 3, i, &args)) {
+        bank_nr = args.args[1] / LINGSI_GPIO_PINS_PER_BANK;
+        bank->gpio_chip.base = args.args[1];
+
+        /* get the llingsi defined gpio line (offset + nb of pins) */
+        npins = args.args[0] + args.args[2];
+        while (!fwnode_property_get_reference_args(fwnode, "gpio-ranges", NULL, 3, ++i, &args))
+            npins = max(npins, (int)(args.args[0] + args.args[2]));
+    } else {
+        bank_nr = pctl->nbanks;
+        bank->gpio_chip.base = bank_nr * LINGSI_GPIO_PINS_PER_BANK;
+        range->name = bank->gpio_chip.label;
+        range->id = bank_nr;
+        range->pin_base = range->id * LINGSI_GPIO_PINS_PER_BANK;
+        range->base = range->id * LINGSI_GPIO_PINS_PER_BANK;
+        range->npins = npins;
+        range->gc = &bank->gpio_chip;
+        pinctrl_add_gpio_range(pctl->pctl_dev,
+                       &pctl->banks[bank_nr].range);
+    }
+
+    if (fwnode_property_read_u32(fwnode, "lingsi,bank-ioport", &bank_ioport_nr))
+        bank_ioport_nr = bank_nr;
+
+    bank->gpio_chip.base = bank_nr * LINGSI_GPIO_PINS_PER_BANK;
+
+    bank->gpio_chip.ngpio = npins;
+    bank->gpio_chip.fwnode = fwnode;
+    bank->gpio_chip.parent = dev;
+    bank->bank_nr = bank_nr;
+    bank->bank_ioport_nr = bank_ioport_nr;
+    bank->secure_control = pctl->match_data->secure_control;
+    spin_lock_init(&bank->lock);
+
+    if (pctl->domain) {
+        /* create irq hierarchical domain */
+        bank->fwnode = fwnode;
+
+        bank->domain = irq_domain_create_hierarchy(pctl->domain, 0, LINGSI_GPIO_IRQ_LINE_PER_BANK,
+                               bank->fwnode, &lingsi_gpio_domain_ops,
+                               bank);
+
+        if (!bank->domain) {
+            err = -ENODEV;
+            goto err_clk;
+        }
+    }
+
+    err = gpiochip_add_data(&bank->gpio_chip, bank);
+    if (err) {
+        dev_err(dev, "Failed to add gpiochip(%d)!\n", bank_nr);
+        goto err_clk;
+    }
+    dev_info(dev, "%s bank added\n", bank->gpio_chip.label);
+    return 0;
+
+err_clk:
+    return err;
+}
+
+static struct irq_domain *lingsi_pctrl_get_irq_domain(struct platform_device *pdev)
+{
+    struct device_node *np = pdev->dev.of_node;
+    struct device_node *parent;
+    struct irq_domain *domain;
+
+    if (!of_find_property(np, "interrupt-parent", NULL))
+        return NULL;
+
+    parent = of_irq_find_parent(np);
+    if (!parent)
+        return ERR_PTR(-ENXIO);
+
+    domain = irq_find_host(parent);
+    of_node_put(parent);
+    if (!domain)
+        /* domain not registered yet */
+        return ERR_PTR(-EPROBE_DEFER);
+
+    return domain;
+}
+
+static int lingsi_pctrl_build_state(struct platform_device *pdev)
+{
+    struct lingsi_pinctrl *pctl = platform_get_drvdata(pdev);
+    int i;
+    pctl->ngroups = pctl->npins;
+
+    /* Allocate groups */
+    pctl->groups = devm_kcalloc(&pdev->dev, pctl->ngroups,
+                    sizeof(*pctl->groups), GFP_KERNEL);
+    if (!pctl->groups)
+        return -ENOMEM;
+    /* We assume that one pin is one group, use pin name as group name. */
+    pctl->grp_names = devm_kcalloc(&pdev->dev, pctl->ngroups,
+                       sizeof(*pctl->grp_names), GFP_KERNEL);
+    if (!pctl->grp_names)
+        return -ENOMEM;
+    for (i = 0; i < pctl->npins; i++) {
+        const struct lingsi_desc_pin *pin = pctl->pins + i;
+        struct lingsi_pinctrl_group *group = pctl->groups + i;
+
+        group->name = pin->pin.name;
+        group->pin = pin->pin.number;
+        pctl->grp_names[i] = pin->pin.name;
+    }
+    return 0;
+}
+
+static int lingsi_pctrl_create_pins_tab(struct lingsi_pinctrl *pctl,
+                       struct lingsi_desc_pin *pins)
+{
+    const struct lingsi_desc_pin *p;
+    int i, nb_pins_available = 0;
+
+    for (i = 0; i < pctl->match_data->npins; i++) {
+        p = pctl->match_data->pins + i;
+        if (pctl->pkg && !(pctl->pkg & p->pkg))
+            continue;
+        pins->pin = p->pin;
+        memcpy((struct lingsi_desc_pin *)pins->functions, p->functions,
+               LINGSI_CONFIG_NUM * sizeof(struct lingsi_desc_function));
+        pins++;
+        nb_pins_available++;
+    }
+
+    pctl->npins = nb_pins_available;
+
+    return 0;
+}
+
+int lingsi_pctl_probe(struct platform_device *pdev)
+{
+    const struct lingsi_pinctrl_match_data *match_data;
+    struct fwnode_handle *child;
+    struct device *dev = &pdev->dev;
+    struct lingsi_pinctrl *pctl;
+    struct pinctrl_pin_desc *pins;
+    int i, ret, hwlock_id;
+    unsigned int banks;
+
+    match_data = device_get_match_data(dev);
+    if (!match_data)
+        return -EINVAL;
+    if (!device_property_present(dev, "pins-are-numbered")) {
+        dev_err(dev, "only support pins-are-numbered format\n");
+        return -EINVAL;
+    }
+    pctl = devm_kzalloc(dev, sizeof(*pctl), GFP_KERNEL);
+    if (!pctl)
+        return -ENOMEM;;
+
+    pctl->sysc_awo_regmap =
+        syscon_regmap_lookup_by_compatible("lingsi,sysc_awo");
+    if (IS_ERR(pctl->sysc_awo_regmap)) {
+        dev_err(pctl->dev, "didn't find lingsi,sysc_awo\n");
+        return PTR_ERR(pctl->sysc_awo_regmap);
+    }
+
+    pctl->sysc_per_regmap =
+        syscon_regmap_lookup_by_compatible("lingsi,sysc_per");
+    if (IS_ERR(pctl->sysc_per_regmap)) {
+        dev_err(pctl->dev, "didn't find lingsi,sysc_per\n");
+        return PTR_ERR(pctl->sysc_per_regmap);
+    }
+
+    platform_set_drvdata(pdev, pctl);
+
+    /* check for IRQ controller (may require deferred probe) */
+    pctl->domain = lingsi_pctrl_get_irq_domain(pdev);
+    if (IS_ERR(pctl->domain))
+        return PTR_ERR(pctl->domain);
+    if (!pctl->domain)
+        dev_warn(dev, "pinctrl without interrupt support\n");
+
+    /* hwspinlock is optional */
+    hwlock_id = of_hwspin_lock_get_id(pdev->dev.of_node, 0);
+    if (hwlock_id < 0) {
+        if (hwlock_id == -EPROBE_DEFER)
+            return hwlock_id;
+    } else {
+        pctl->hwlock = hwspin_lock_request_specific(hwlock_id);
+    }
+
+    pctl->dev = dev;
+    pctl->match_data = match_data;
+    /*  get optional package information */
+    if (!device_property_read_u32(dev, "lingsi,package", &pctl->pkg))
+        dev_dbg(pctl->dev, "package detected: %x\n", pctl->pkg);
+
+    pctl->pins = devm_kcalloc(pctl->dev, pctl->match_data->npins,
+                  sizeof(*pctl->pins), GFP_KERNEL);
+    if (!pctl->pins)
+        return -ENOMEM;
+    ret = lingsi_pctrl_create_pins_tab(pctl, pctl->pins);
+    if (ret)
+        return ret;
+    ret = lingsi_pctrl_build_state(pdev);
+    if (ret) {
+        dev_err(dev, "build state failed: %d\n", ret);
+        return -EINVAL;
+    }
+
+    pins = devm_kcalloc(&pdev->dev, pctl->npins, sizeof(*pins),
+                GFP_KERNEL);
+    if (!pins)
+        return -ENOMEM;
+    for (i = 0; i < pctl->npins; i++)
+        pins[i] = pctl->pins[i].pin;
+
+    pctl->pctl_desc.name = dev_name(&pdev->dev);
+    pctl->pctl_desc.owner = THIS_MODULE;
+    pctl->pctl_desc.pins = pins;
+    pctl->pctl_desc.npins = pctl->npins;
+    pctl->pctl_desc.link_consumers = true;
+    pctl->pctl_desc.confops = &lingsi_pconf_ops;
+    pctl->pctl_desc.pctlops = &lingsi_pctrl_ops;
+    pctl->pctl_desc.pmxops = &lingsi_pmx_ops;
+    pctl->dev = &pdev->dev;
+    pctl->pctl_dev = devm_pinctrl_register(&pdev->dev, &pctl->pctl_desc,
+                           pctl);
+    if (IS_ERR(pctl->pctl_dev)) {
+        dev_err(&pdev->dev, "Failed pinctrl registration\n");
+        return PTR_ERR(pctl->pctl_dev);
+    }
+    banks = gpiochip_node_count(dev);
+    if (!banks) {
+        dev_err(dev, "at lelingsi one GPIO bank is required\n");
+        return -EINVAL;
+    }
+    pctl->banks = devm_kcalloc(dev, banks, sizeof(*pctl->banks),
+            GFP_KERNEL);
+    if (!pctl->banks)
+        return -ENOMEM;
+    i = 0;
+    for_each_gpiochip_node(dev, child) {
+        struct lingsi_gpio_bank *bank = &pctl->banks[i];
+        struct device_node *np = to_of_node(child);
+        bank->rstc = of_reset_control_get_exclusive(np, NULL);
+        if (PTR_ERR(bank->rstc) == -EPROBE_DEFER) {
+            fwnode_handle_put(child);
+            return -EPROBE_DEFER;
+        }
+
+        i++;
+    }
+    for_each_gpiochip_node(dev, child) {
+        ret = lingsi_gpiolib_register_bank(pctl, child);
+        if (ret) {
+            fwnode_handle_put(child);
+            return ret;
+        }
+
+        pctl->nbanks++;
+    }
+    dev_info(dev, "Pinctrl LINGSI initialized\n");
+
+    return 0;
+}
diff --git a/drivers/pinctrl/lingsi/pinctrl-lingsi.h b/drivers/pinctrl/lingsi/pinctrl-lingsi.h
new file mode 100644
index 000000000000..f73ffdce0f71
--- /dev/null
+++ b/drivers/pinctrl/lingsi/pinctrl-lingsi.h
@@ -0,0 +1,72 @@
+#ifndef __PINCTRL_LINGSI_H
+#define __PINCTRL_LINGSI_H
+
+#include <linux/pinctrl/pinctrl.h>
+#include <linux/pinctrl/pinconf-generic.h>
+#include <dt-bindings/pinctrl/lingsi-pinfunc.h>
+
+#define LINGSI_PIN_NO(x) ((x) << 8)
+#define LINGSI_GET_PIN_NO(x) ((x) >> 8)
+#define LINGSI_GET_PIN_FUNC(x) ((x) & 0xff)
+
+#define LINGSI_PIN_GPIO        0
+#define LINGSI_PIN_AF(x)        ((x))
+//when LINGSI_PIN_ANALOG exist, LINGSI_CONFIG_NUM is LINGSI_PIN_ANALOG
+#define LINGSI_CONFIG_NUM    (LINGSI_PIN_AF(AF_END + 1))
+#if 0
+#define LINGSI_PIN_ANALOG    (LINGSI_PIN_AF(AF_END))
+#define LINGSI_CONFIG_NUM    (LINGSI_PIN_ANALOG)
+#endif
+
+/*  package information */
+#define LINGSIMP_PKG_AA        BIT(0)
+#define LINGSIMP_PKG_AB        BIT(1)
+#define LINGSIMP_PKG_AC        BIT(2)
+#define LINGSIMP_PKG_AD        BIT(3)
+
+struct lingsi_desc_function {
+    const char *name;
+    const unsigned char num;
+};
+
+struct lingsi_desc_pin {
+    struct pinctrl_pin_desc pin;
+    const struct lingsi_desc_function functions[LINGSI_CONFIG_NUM];
+    const unsigned int pkg;
+};
+
+#define LINGSI_PIN(_pin, ...)                    \
+    {                            \
+        .pin = _pin,                    \
+        .functions = {    \
+            __VA_ARGS__},            \
+    }
+
+#define LINGSI_PIN_PKG(_pin, _pkg, ...)                    \
+    {                            \
+        .pin = _pin,                    \
+        .pkg  = _pkg,                \
+        .functions = {    \
+            __VA_ARGS__},            \
+    }
+#define LINGSI_FUNCTION(_num, _name)        \
+    [_num] = {                        \
+        .num = _num,                    \
+        .name = _name,                    \
+    }
+
+struct lingsi_pinctrl_match_data {
+    const struct lingsi_desc_pin *pins;
+    const unsigned int npins;
+    bool secure_control;
+};
+
+struct lingsi_gpio_bank;
+
+int lingsi_pctl_probe(struct platform_device *pdev);
+void lingsi_pmx_get_mode(struct lingsi_gpio_bank *bank,
+            int pin, u32 *mode, u32 *alt);
+int lingsi_pinctrl_suspend(struct device *dev);
+int lingsi_pinctrl_resume(struct device *dev);
+
+#endif /* __PINCTRL_LINGSI_H */
diff --git a/include/dt-bindings/pinctrl/lingsi-pinfunc.h b/include/dt-bindings/pinctrl/lingsi-pinfunc.h
new file mode 100644
index 000000000000..75b9a3329c1d
--- /dev/null
+++ b/include/dt-bindings/pinctrl/lingsi-pinfunc.h
@@ -0,0 +1,341 @@
+#ifndef PER_FUNC_MUX_H_
+#define PER_FUNC_MUX_H_
+
+#define MODE_GPIO   0
+/* set to 2 to compatible func lingsi_pmx_set_mode() */
+#define MODE_AF     2
+// #define ANALOG
+
+/* define Pins number*/
+#define PIN_NO(port, line)    (((port) - 'A') * 0x10 + (line))
+
+#define LINGSI_PINMUX(port, line, mode) (((PIN_NO(port, line)) << 8) | (mode))
+
+#define GPIO                0
+#define FIO_GPTIMA1_CH1     1
+#define FIO_GPTIMA1_CH2     2
+#define FIO_GPTIMA1_CH3     3
+#define FIO_GPTIMA1_CH4     4
+#define FIO_GPTIMA1_ETR     5
+#define FIO_GPTIMA2_CH1     6
+#define FIO_GPTIMA2_CH2     7
+#define FIO_GPTIMA2_CH3     8
+#define FIO_GPTIMA2_CH4     9
+#define FIO_GPTIMA2_ETR     10
+#define FIO_GPTIMB1_CH1     11
+#define FIO_GPTIMB1_CH2     12
+#define FIO_GPTIMB1_CH3     13
+#define FIO_GPTIMB1_CH4     14
+#define FIO_GPTIMB1_ETR     15
+#define FIO_GPTIMC1_CH1     16
+#define FIO_GPTIMC1_CH1N    17
+#define FIO_GPTIMC1_CH2     18
+#define FIO_GPTIMC1_BK      19
+#define FIO_ADTIM1_CH1      20
+#define FIO_ADTIM1_CH1N     21
+#define FIO_ADTIM1_CH2      22
+#define FIO_ADTIM1_CH2N     23
+#define FIO_ADTIM1_CH3      24
+#define FIO_ADTIM1_CH3N     25
+#define FIO_ADTIM1_CH4      26
+#define FIO_ADTIM1_ETR      27
+#define FIO_ADTIM1_BK       28
+#define FIO_ADTIM2_CH1      29
