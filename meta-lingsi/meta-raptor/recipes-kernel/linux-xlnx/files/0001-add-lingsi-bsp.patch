+static int lingsi_video_queue_setup(struct vb2_queue *q, unsigned int *num_buffers, unsigned int *num_planes, unsigned int sizes[], struct device *alloc_devs[])
+{
+    struct lingsi_video *video = vb2_get_drv_priv(q);
+
+    if (*num_planes) {
+        if (sizes[0] < video->max_compressed_size) {
+            return -EINVAL;
+        }
+
+        return 0;
+    }
+
+    *num_planes = 1;
+    sizes[0] = video->max_compressed_size;
+
+    return 0;
+}
+
+static int lingsi_video_buf_prepare(struct vb2_buffer *vb)
+{
+    struct lingsi_video *video = vb2_get_drv_priv(vb->vb2_queue);
+
+    if (vb2_plane_size(vb, 0) < video->max_compressed_size) {
+        return -EINVAL;
+    }
+
+    return 0;
+}
+
+static int lingsi_video_start_streaming(struct vb2_queue *q,
+                    unsigned int count)
+{
+    int rc;
+    struct lingsi_video *video = vb2_get_drv_priv(q);
+
+    video->sequence = 0;
+
+    rc = lingsi_video_start_frame(video);
+    if (rc) {
+        lingsi_video_bufs_done(video, VB2_BUF_STATE_QUEUED);
+        return rc;
+    }
+
+    set_bit(VIDEO_STREAMING, &video->flags);
+    return 0;
+}
+
+static void lingsi_video_stop_streaming(struct vb2_queue *q)
+{
+    int rc;
+    struct lingsi_video *video = vb2_get_drv_priv(q);
+
+    clear_bit(VIDEO_STREAMING, &video->flags);
+
+    rc = wait_event_timeout(video->wait,
+                !test_bit(VIDEO_FRAME_INPRG, &video->flags),
+                STOP_TIMEOUT);
+    if (!rc) {
+        dev_dbg(video->dev, "Timed out when stopping streaming\n");
+
+        /*
+         * Need to force stop any DMA and try and get HW into a good
+         * state for future callingsi to start streaming again.
+         */
+        lingsi_video_off(video);
+        lingsi_video_on(video);
+
+        // lingsi_video_init_regs(video);
+
+        lingsi_video_get_resolution(video);
+    }
+
+    lingsi_video_bufs_done(video, VB2_BUF_STATE_ERROR);
+
+    /* Stop all pending DMA operations */
+    mutex_lock(&video->dma_lock);
+
+    dmaengine_terminate_sync(video->dma_chan);
+    mutex_unlock(&video->dma_lock);
+}
+
+static void lingsi_video_buf_queue(struct vb2_buffer *vb)
+{
+    bool empty;
+    struct lingsi_video *video = vb2_get_drv_priv(vb->vb2_queue);
+    struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+    struct lingsi_video_buffer *avb = to_lingsi_video_buffer(vbuf);
+    unsigned long flags;
+
+    spin_lock_irqsave(&video->lock, flags);
+
+    empty = list_empty(&video->buffers);
+    list_add_tail(&avb->link, &video->buffers);
+    spin_unlock_irqrestore(&video->lock, flags);
+
+    if (test_bit(VIDEO_STREAMING, &video->flags) &&
+        !test_bit(VIDEO_FRAME_INPRG, &video->flags) && empty) {
+        lingsi_video_start_frame(video);
+    }
+}
+
+static const struct vb2_ops lingsi_video_vb2_ops = {
+    .queue_setup = lingsi_video_queue_setup,
+    .wait_prepare = vb2_ops_wait_prepare,
+    .wait_finish = vb2_ops_wait_finish,
+    .buf_prepare = lingsi_video_buf_prepare,
+    .start_streaming = lingsi_video_start_streaming,
+    .stop_streaming = lingsi_video_stop_streaming,
+    .buf_queue =  lingsi_video_buf_queue,
+};
+
+static int lingsi_video_setup_video(struct lingsi_video *video)
+{
+    struct v4l2_device *v4l2_dev = &video->v4l2_dev;
+    struct vb2_queue *vbq = &video->queue;
+    struct video_device *vdev = &video->vdev;
+    int rc;
+
+    video->pix_fmt.pixelformat = V4L2_PIX_FMT_XRGB32;
+    video->pix_fmt.field = V4L2_FIELD_NONE;
+    video->pix_fmt.colorspace = V4L2_COLORSPACE_SRGB;
+    video->pix_fmt.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+    video->v4l2_input_status = V4L2_IN_ST_NO_SIGNAL;
+
+    rc = v4l2_device_register(video->dev, v4l2_dev);
+    if (rc) {
+        dev_err(video->dev, "Failed to register v4l2 device\n");
+        return rc;
+    }
+
+    vbq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+    vbq->io_modes = VB2_MMAP | VB2_READ | VB2_DMABUF;
+    vbq->dev = v4l2_dev->dev;
+    vbq->lock = &video->video_lock;
+    vbq->ops = &lingsi_video_vb2_ops;
+    vbq->mem_ops = &vb2_dma_contig_memops; //&vb2_dma_sg_memops;
+    vbq->drv_priv = video;
+    vbq->buf_struct_size = sizeof(struct lingsi_video_buffer);
+    vbq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+    vbq->min_buffers_needed = 3;
+
+    rc = vb2_queue_init(vbq);
+    if (rc) {
+        v4l2_device_unregister(v4l2_dev);
+
+        dev_err(video->dev, "Failed to init vb2 queue\n");
+        return rc;
+    }
+
+    vdev->queue = vbq;
+    vdev->fops = &lingsi_video_v4l2_fops;
+    vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_READWRITE |
+        V4L2_CAP_STREAMING;
+    vdev->v4l2_dev = v4l2_dev;
+    strscpy(vdev->name, DEVICE_NAME, sizeof(vdev->name));
+    vdev->vfl_type = VFL_TYPE_VIDEO;
+    vdev->vfl_dir = VFL_DIR_RX;
+    vdev->release = video_device_release_empty;
+    vdev->ioctl_ops = &lingsi_video_ioctl_ops;
+    vdev->lock = &video->video_lock;
+
+    video_set_drvdata(vdev, video);
+    rc = video_register_device(vdev, VFL_TYPE_VIDEO, 0);
+    if (rc) {
+        v4l2_device_unregister(v4l2_dev);
+
+        dev_err(video->dev, "Failed to register video device\n");
+        return rc;
+    }
+
+    return 0;
+}
+
+static int lingsi_video_init(struct lingsi_video *video)
+{
+    int rc;
+    struct device *dev = video->dev;
+
+    of_reserved_mem_device_init(dev);
+
+    rc = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+    if (rc) {
+        dev_err(dev, "Failed to set DMA mask\n");
+        goto err_release_reserved_mem;
+    }
+    return 0;
+
+err_release_reserved_mem:
+    of_reserved_mem_device_release(dev);
+    return rc;
+}
+
+static const struct of_device_id lingsi_video_of_match[] = {
+    { .compatible = "lingsi,video-engine" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, lingsi_video_of_match);
+
+static int lingsi_video_probe(struct platform_device *pdev)
+{
+    struct device_node *np = pdev->dev.of_node;
+    struct lingsi_video *video;
+    int rc;
+    int ret = 0;
+
+    video = devm_kzalloc(&pdev->dev, sizeof(*video), GFP_KERNEL);
+    if (!video){
+        return -ENOMEM;
+    }
+
+    rc = of_property_read_u64(np, "vram", &video->vram);
+    if(rc) {
+        dev_err(&pdev->dev, "No specify vram in dts\n");
+        return -ENOMEM;
+    }
+
+    video->dma_chan = dma_request_chan(&pdev->dev, "gdma");
+    if (IS_ERR(video->dma_chan)) {
+        ret = PTR_ERR(video->dma_chan);
+        if (ret != -EPROBE_DEFER)
+            dev_err(&pdev->dev,
+                "Failed to request DMA channel: %d\n", ret);
+        return ret;
+    }
+
+    video->max_compressed_size = IMAGE_SIZE;
+    video->frame_rate = 30;
+    video->dev = &pdev->dev;
+    spin_lock_init(&video->lock);
+    mutex_init(&video->video_lock);
+    mutex_init(&video->dma_lock);
+    init_waitqueue_head(&video->wait);
+
+    INIT_LIST_HEAD(&video->buffers);
+
+    rc = lingsi_video_init(video);
+    if (rc)
+        return rc;
+
+    rc = lingsi_video_setup_video(video);
+    if (rc) {
+        return rc;
+    }
+
+    return 0;
+}
+
+static int lingsi_video_remove(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct v4l2_device *v4l2_dev = dev_get_drvdata(dev);
+    struct lingsi_video *video = to_lingsi_video(v4l2_dev);
+
+    lingsi_video_off(video);
+
+    vb2_video_unregister_device(&video->vdev);
+
+    v4l2_device_unregister(v4l2_dev);
+
+    of_reserved_mem_device_release(dev);
+
+    dma_release_channel(video->dma_chan);
+    return 0;
+}
+
+static struct platform_driver lingsi_video_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .of_match_table = lingsi_video_of_match,
+    },
+    .probe = lingsi_video_probe,
+    .remove = lingsi_video_remove,
+};
+
+module_platform_driver(lingsi_video_driver);
+
+MODULE_DESCRIPTION("LINGSI Video Engine Driver");
+MODULE_AUTHOR("Eddie James");
+MODULE_LICENSE("GPL v2");
