+static int lingsi_video_open(struct file *file)
+{
+    int rc;
+    struct lingsi_video *video = video_drvdata(file);
+
+    mutex_lock(&video->video_lock);
+
+    rc = v4l2_fh_open(file);
+    if (rc) {
+        mutex_unlock(&video->video_lock);
+        return rc;
+    }
+
+    if (v4l2_fh_is_singular_file(file))
+        lingsi_video_start(video);
+
+    mutex_unlock(&video->video_lock);
+
+    return 0;
+}
+
+static int lingsi_video_release(struct file *file)
+{
+    int rc;
+    struct lingsi_video *video = video_drvdata(file);
+
+    mutex_lock(&video->video_lock);
+
+    if (v4l2_fh_is_singular_file(file))
+        lingsi_video_stop(video);
+
+    rc = _vb2_fop_release(file, NULL);
+
+    mutex_unlock(&video->video_lock);
+
+    return rc;
+}
