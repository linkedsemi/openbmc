+static void lingsi_video_off(struct lingsi_video *video)
+{
+    if (!test_bit(VIDEO_CLOCKS_ON, &video->flags))
+        return;
+
+    clear_bit(VIDEO_CLOCKS_ON, &video->flags);
+}
