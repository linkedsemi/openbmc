+static const struct irq_domain_ops lingsi_gpio_domain_ops = {
+    .translate    = lingsi_gpio_domain_translate,
+    .alloc        = lingsi_gpio_domain_alloc,
+    .free        = lingsi_gpio_domain_free,
+};
