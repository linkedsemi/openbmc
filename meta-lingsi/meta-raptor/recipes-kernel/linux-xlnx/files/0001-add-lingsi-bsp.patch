+static int lingsi_video_enum_frameintervals(struct file *file, void *fh, struct v4l2_frmivalenum *fival)
+{
+    struct lingsi_video *video = video_drvdata(file);
+
+    if (fival->index) {
+        return -EINVAL;
+    }
+
+    if (fival->width != video->detected_timings.width ||
+        fival->height != video->detected_timings.height) {
+        return -EINVAL;
+    }
+
+    if (fival->pixel_format != V4L2_PIX_FMT_XRGB32) {
+        return -EINVAL;
+    }
+
+    fival->type = V4L2_FRMIVAL_TYPE_CONTINUOUS;
+
+    fival->stepwise.min.denominator = MAX_FRAME_RATE;
+    fival->stepwise.min.numerator = 1;
+    fival->stepwise.max.denominator = 1;
+    fival->stepwise.max.numerator = 1;
+    fival->stepwise.step = fival->stepwise.max;
+
+    return 0;
+}
