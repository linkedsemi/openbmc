+    .init_valid_mask    = lingsi_gpio_init_valid_mask,
+};
+
+static void lingsi_gpio_irq_trigger(struct irq_data *d)
+{
+    struct lingsi_gpio_bank *bank = d->domain->host_data;
+    int level;
+    /* Do not access the GPIO if this is not LEVEL triggered IRQ. */
+    if (!(bank->irq_type[d->hwirq] & IRQ_TYPE_LEVEL_MASK))
+        return;
+
+    /* If level interrupt type then retrig */
+    level = lingsi_gpio_get(&bank->gpio_chip, d->hwirq);
+    if ((level == 0 && bank->irq_type[d->hwirq] == IRQ_TYPE_LEVEL_LOW) ||
+        (level == 1 && bank->irq_type[d->hwirq] == IRQ_TYPE_LEVEL_HIGH))
+        irq_chip_retrigger_hierarchy(d);
+}
+
+static void lingsi_gpio_irq_eoi(struct irq_data *d)
+{
+    irq_chip_eoi_parent(d);
+    lingsi_gpio_irq_trigger(d);
+};
+
+static int lingsi_gpio_set_type(struct irq_data *d, unsigned int type)
+{
+    struct lingsi_gpio_bank *bank = d->domain->host_data;
+    u32 parent_type;
+    switch (type) {
+    case IRQ_TYPE_EDGE_RISING:
+    case IRQ_TYPE_EDGE_FALLING:
+    case IRQ_TYPE_EDGE_BOTH:
+        parent_type = type;
+        break;
+    case IRQ_TYPE_LEVEL_HIGH:
+        parent_type = IRQ_TYPE_EDGE_RISING;
+        break;
+    case IRQ_TYPE_LEVEL_LOW:
+        parent_type = IRQ_TYPE_EDGE_FALLING;
+        break;
+    default:
+        return -EINVAL;
+    }
+
+    bank->irq_type[d->hwirq] = type;
+
+    return irq_chip_set_type_parent(d, parent_type);
+};
+
+static int lingsi_gpio_irq_request_resources(struct irq_data *irq_data)
+{
+    struct lingsi_gpio_bank *bank = irq_data->domain->host_data;
+    struct lingsi_pinctrl *pctl = dev_get_drvdata(bank->gpio_chip.parent);
+    int ret;
+    ret = lingsi_gpio_direction_input(&bank->gpio_chip, irq_data->hwirq % LINGSI_GPIO_IRQ_LINE_PER_BANK);
+    if (ret) {
+        dev_err(pctl->dev, "lingsi_gpio_direction_input fail\n");
+        return ret;
+    }
+
+    ret = gpiochip_lock_as_irq(&bank->gpio_chip, irq_data->hwirq % LINGSI_GPIO_IRQ_LINE_PER_BANK);
+    if (ret) {
+        dev_err(pctl->dev, "unable to lock HW IRQ %lu for IRQ\n",
+            irq_data->hwirq);
+        return ret;
+    }
+
+    return 0;
+}
+
+static void lingsi_gpio_irq_release_resources(struct irq_data *irq_data)
+{
+    struct lingsi_gpio_bank *bank = irq_data->domain->host_data;
+    gpiochip_unlock_as_irq(&bank->gpio_chip, irq_data->hwirq % LINGSI_GPIO_IRQ_LINE_PER_BANK);
+}
+
+
+static void lingsi_gpio_irq_unmask(struct irq_data *d)
+{
+    irq_chip_unmask_parent(d);
+    /*
+    在取消屏蔽后立即触发中断，
+    这意味着如果存在等待处理的中断事件，
+    那么在中断被允许后会立刻得到响应并进入处理器进行处理。
+    这种设计可能是因为在某些情况下
+    （例如硬件已经检测到中断事件但在中断被屏蔽期间未通知处理器），
+    需要在中断被重新打开时确保立即触发一次中断服务例程来处理积压的中断请求。
+    */
+    lingsi_gpio_irq_trigger(d);
+}
+
+static struct irq_chip lingsi_gpio_irq_chip = {
+    .name        = "lingsigpio",
+    .irq_eoi    = lingsi_gpio_irq_eoi,
+    .irq_ack    = irq_chip_ack_parent,
+    .irq_mask    = irq_chip_mask_parent,
+    .irq_unmask    = lingsi_gpio_irq_unmask,
+    .irq_set_type    = lingsi_gpio_set_type,
+    .irq_request_resources = lingsi_gpio_irq_request_resources,
+    .irq_release_resources = lingsi_gpio_irq_release_resources,
+};
