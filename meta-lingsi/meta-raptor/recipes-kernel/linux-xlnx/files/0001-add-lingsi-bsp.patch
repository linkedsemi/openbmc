+static int lingsi_pmx_set_mode(struct lingsi_gpio_bank *bank,
+                  int pin, u32 mode, u32 alt)
+{
+    struct lingsi_pinctrl *pctl = dev_get_drvdata(bank->gpio_chip.parent);
+    u32 val;
+    int alt_shift;
+    int alt_mask;
+    int alt_offset;
+    uint8_t func_io_num;
+    unsigned long flags;
+    int err = 0;
+    spin_lock_irqsave(&bank->lock, flags);
+
+    if (pctl->hwlock) {
+        err = hwspin_lock_timeout_in_atomic(pctl->hwlock,
+                            HWSPNLCK_TIMEOUT);
+        if (err) {
+            dev_err(pctl->dev, "Can't get hwspinlock\n");
+            goto unlock;
+        }
+    }
+
+    func_io_num = bank->gpio_chip.base + pin;
+    switch(mode) {
+    case GPIO_LINE_DIRECTION_OUT:
+        /* disable alter func */
+        alt_offset = LINGSI_GPIO_PIN_SEL1 + (func_io_num >> 5) * 0x4;
+        regmap_clear_bits(pctl->sysc_awo_regmap, alt_offset, BIT(func_io_num % 32));
+        /* output */
+        val = readl_relaxed(bank->base + LINGSI_GPIO_OE_FIR);
+        val |= BIT(LINGSI_GPIO_PINS_PER_BANK + pin);
+        iowrite32(val, bank->base + LINGSI_GPIO_OE_FIR);
+        break;
+    case GPIO_LINE_DIRECTION_IN:
+        /* disable alter func */
+        alt_offset = LINGSI_GPIO_PIN_SEL1 + (func_io_num >> 5) * 0x4;
+        regmap_clear_bits(pctl->sysc_awo_regmap, alt_offset, BIT(func_io_num % 32));
+        /* input */
+        val = readl_relaxed(bank->base + LINGSI_GPIO_OE_FIR);
+        val &= ~(BIT(LINGSI_GPIO_PINS_PER_BANK + pin));
+        iowrite32(val, bank->base + LINGSI_GPIO_OE_FIR);
+        break;
+    default:
+        alt_offset = LINGSI_PER_FUNC_SEL + ALIGN_DOWN(func_io_num, 4);
+        alt_shift = (func_io_num % 4) * 8;
+        alt_mask = GENMASK(alt_shift + 7, alt_shift);
+        alt <<= alt_shift;
+        regmap_update_bits(pctl->sysc_per_regmap, alt_offset, alt_mask, alt);
+        /* enable alter func */
+        alt_offset = LINGSI_GPIO_PIN_SEL1 + (func_io_num >> 5) * 0x4;
+        regmap_set_bits(pctl->sysc_awo_regmap, alt_offset, BIT(func_io_num % 32));
+
+        if(func_io_num == 1 || func_io_num == 2) {
+            regmap_read(pctl->sysc_awo_regmap, alt_offset, &val);
+        }
+        break;
+    };
+
+    if (pctl->hwlock)
+        hwspin_unlock_in_atomic(pctl->hwlock);
+
+    lingsi_gpio_backup_mode(bank, pin, mode, alt);
+
+unlock:
+    spin_unlock_irqrestore(&bank->lock, flags);
+
+    return err;
+}
+
+void lingsi_pmx_get_mode(struct lingsi_gpio_bank *bank, int pin, u32 *mode,
+            u32 *alt)
+{
+    struct lingsi_pinctrl *pctl = dev_get_drvdata(bank->gpio_chip.parent);
+    u32 val;
+    int alt_shift;
+    int alt_mask;
+    int alt_offset;
+    uint8_t func_io_num;
+    unsigned long flags;
+    spin_lock_irqsave(&bank->lock, flags);
+
+    func_io_num = bank->gpio_chip.base + pin;
+    alt_offset = LINGSI_GPIO_PIN_SEL1 + (func_io_num >> 5) * 0x4;
+    regmap_read(pctl->sysc_awo_regmap, alt_offset, &val);
+    val &= BIT(func_io_num % 32);
+    if (val) {
+        /* alter func is on: AF mode */
+        alt_offset = LINGSI_PER_FUNC_SEL + ALIGN_DOWN(func_io_num, 4);
+        regmap_read(pctl->sysc_per_regmap, alt_offset, &val);
+        alt_shift = (func_io_num % 4) * 8;
+        alt_mask = GENMASK(alt_shift + 7, alt_shift);
+        *alt = (val & alt_mask) >> alt_shift;
+        *mode = MODE_AF;
+    } else {
+        *alt = 0;
+        val = readl_relaxed(bank->base + LINGSI_GPIO_OE_FIR);
+        if(val & BIT(LINGSI_GPIO_PINS_PER_BANK + pin)) {
+            *mode = GPIO_LINE_DIRECTION_OUT;
+        } else {
+            *mode = GPIO_LINE_DIRECTION_IN;
+        }
+    }
+    spin_unlock_irqrestore(&bank->lock, flags);
+}
+
+static int lingsi_pmx_set_mux(struct pinctrl_dev *pctldev,
+                unsigned function,
+                unsigned group)
+{
+    bool ret;
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    struct lingsi_pinctrl_group *g = pctl->groups + group;
+    struct pinctrl_gpio_range *range;
+    struct lingsi_gpio_bank *bank;
+    u32 mode, alt;
+    int pin;
+    ret = lingsi_pctrl_is_function_valid(pctl, g->pin, function);
+    if (!ret)
+        return -EINVAL;
+
+    range = pinctrl_find_gpio_range_from_pin(pctldev, g->pin);
+    if (!range) {
+        dev_err(pctl->dev, "No gpio range defined.\n");
+        return -EINVAL;
+    }
+
+    bank = gpiochip_get_data(range->gc);
+    pin = lingsi_gpio_pin(g->pin);
+
+    mode = lingsi_gpio_get_mode(function);
+    alt = lingsi_gpio_get_alt(function);
+
+    return lingsi_pmx_set_mode(bank, pin, mode, alt);
+}
+
+static int lingsi_pmx_gpio_set_direction(struct pinctrl_dev *pctldev,
+            struct pinctrl_gpio_range *range, unsigned gpio,
+            bool input)
+{
+    struct lingsi_gpio_bank *bank = gpiochip_get_data(range->gc);
+    int pin = lingsi_gpio_pin(gpio);
+    return lingsi_pmx_set_mode(bank, pin, input, 0);
+}
+
+static int lingsi_pmx_request(struct pinctrl_dev *pctldev, unsigned int gpio)
+{
+    struct lingsi_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+    struct pinctrl_gpio_range *range;
+    range = pinctrl_find_gpio_range_from_pin_nolock(pctldev, gpio);
+    if (!range) {
+        dev_err(pctl->dev, "No gpio range defined.\n");
+        return -EINVAL;
+    }
+
+    if (!gpiochip_line_is_valid(range->gc, lingsi_gpio_pin(gpio))) {
+        dev_warn(pctl->dev, "Can't access gpio %d\n", gpio);
+        return -EACCES;
+    }
+
+    return 0;
+}
