+static int lingsi_start_capture(struct lingsi_video *video, struct lingsi_video_buffer *buf);
+static void lingsi_dma_callback(void *param);
+
+static void lingsi_video_buffer_done(struct lingsi_video *video,
+                 struct lingsi_video_buffer *buf,
+                 size_t bytesused,
+                 int err)
+{
+    struct vb2_v4l2_buffer *vbuf;
+
+    if (!buf)
+        return;
+
+    list_del_init(&buf->link);
+    vbuf = &buf->vb;
+    vbuf->sequence = video->sequence++;
+    vbuf->field = V4L2_FIELD_NONE;
+    vbuf->vb2_buf.timestamp = ktime_get_ns();
+    vb2_set_plane_payload(&vbuf->vb2_buf, 0, bytesused);
+    vb2_buffer_done(&vbuf->vb2_buf,
+            err ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+    dev_dbg(video->dev, "buffer[%d] done seq=%d, bytesused=%zu\n",
+        vbuf->vb2_buf.index, vbuf->sequence, bytesused);
+    video->buffers_count++;
+}
+
+
+static int lingsi_start_dma(struct lingsi_video *video, struct lingsi_video_buffer *buf)
+{
+    if(buf == NULL) {
+        DBG("dma NULL buf")
+        return -EINVAL;
+    }
+
+    video->tx = video->dma_chan->device->device_prep_dma_memcpy(video->dma_chan,
+                buf->paddr, video->vram, buf->size, DMA_CTRL_ACK | DMA_PREP_INTERRUPT);
+    if (!video->tx) {
+        printk(KERN_INFO "Failed to prepare DMA memcpy");
+    }
+    video->tx->callback = lingsi_dma_callback;
+    video->tx->callback_param = video;
+    video->cookie = video->tx->tx_submit(video->tx);
+
+    if (dma_submit_error(video->cookie)) {
+        printk("DMA tx submit failed");
+    }
+
+    mutex_unlock(&video->dma_lock);
+
+    dma_async_issue_pending(video->dma_chan);
+
+    return 0;
+}
+
+static int lingsi_start_capture(struct lingsi_video *video, struct lingsi_video_buffer *buf)
+{
+    int ret;
+
+    if (!buf)
+        return -EINVAL;
+
+    ret = lingsi_start_dma(video, buf);
+    if (ret) {
+        video->errors_count++;
+        return ret;
+    }
+    return 0;
+}
+
+static int lingsi_video_start_frame(struct lingsi_video *video)
+{
+    unsigned long flags;
+    struct lingsi_video_buffer *buf;
+    int ret;
+
+    if (video->v4l2_input_status) {
+        dev_dbg(video->dev, "No signal; don't start frame\n");
+        return 0;
+    }
+
+    spin_lock_irqsave(&video->lock, flags);
+    buf = list_first_entry_or_null(&video->buffers, struct lingsi_video_buffer, link);
+    if (!buf) {
+        spin_unlock_irqrestore(&video->lock, flags);
+        dev_dbg(video->dev, "No buffers; don't start frame\n");
+        return -EPROTO;
+    }
+
+    set_bit(VIDEO_FRAME_INPRG, &video->flags);
+
+    /******** virtural memcpy ...********/
+    // addr = vb2_plane_vaddr(&buf->vb.vb2_buf, 0);
+    // memcpy(addr, video->base, IMAGE_SIZE);
+
+    /******** phy memcpy ...********/
+    buf->paddr = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+    buf->size = vb2_plane_size(&buf->vb.vb2_buf, 0);
+
+    spin_unlock_irqrestore(&video->lock, flags);
+    ret = lingsi_start_capture(video, buf);
+    if (ret) {
+        dev_err(video->dev, "%s: Start streaming failed, cannot start capture\n",
+            __func__);
+    }
+
+    return 0;
+}
+
+static void lingsi_dma_callback(void *param)
+{
+    struct lingsi_video *video = (struct lingsi_video *)param;
+    struct dma_tx_state state;
+    enum dma_status status;
+    struct lingsi_video_buffer *buf;
+
+    /* Check DMA status */
+    status = dmaengine_tx_status(video->dma_chan, video->dma_cookie, &state);
+
+    switch (status) {
+    case DMA_IN_PROGRESS:
+        dev_dbg(video->dev, "%s: Received DMA_IN_PROGRESS\n", __func__);
+        break;
+    case DMA_PAUSED:
+        dev_err(video->dev, "%s: Received DMA_PAUSED\n", __func__);
+        break;
+    case DMA_ERROR:
+        dev_err(video->dev, "%s: Received DMA_ERROR\n", __func__);
+
+        /* Return buffer to V4L2 in error state */
+        lingsi_video_buffer_done(video, buf, 0, -EIO);
+        break;
+    case DMA_COMPLETE:
+        dev_dbg(video->dev, "%s: Received DMA_COMPLETE\n", __func__);
+        spin_lock(&video->lock);
+        clear_bit(VIDEO_FRAME_INPRG, &video->flags);
+        buf = list_first_entry_or_null(&video->buffers,
+                            struct lingsi_video_buffer,
+                            link);
+        if (buf) {
+            vb2_set_plane_payload(&buf->vb.vb2_buf, 0, IMAGE_SIZE);
+
+            if (!list_is_last(&buf->link, &video->buffers)) {
+                buf->vb.vb2_buf.timestamp = ktime_get_ns();
+                buf->vb.sequence = video->sequence++;
+                buf->vb.field = V4L2_FIELD_NONE;
+                vb2_buffer_done(&buf->vb.vb2_buf,
+                        VB2_BUF_STATE_DONE);
+                list_del(&buf->link);
+            }
+        }
+        spin_unlock(&video->lock);
+
+        if (test_bit(VIDEO_STREAMING, &video->flags) && buf)
+            lingsi_video_start_frame(video);
+        return;
+    default:
+        dev_err(video->dev, "%s: Received unknown status\n", __func__);
+        break;
+    }
+}
