+static inline int lingsi_gpio_pin(int gpio)
+{
+    return gpio % LINGSI_GPIO_PINS_PER_BANK;
+}
+
+static inline u32 lingsi_gpio_get_mode(u32 function)
+{
+    switch (function) {
+    case LINGSI_PIN_GPIO:
+        return MODE_GPIO;
+    case LINGSI_PIN_AF(AF_START) ... LINGSI_PIN_AF(AF_END):
+        return MODE_AF;
+    }
+
+    return 0;
+}
+
+static inline u32 lingsi_gpio_get_alt(u32 function)
+{
+    switch (function) {
+    case LINGSI_PIN_GPIO:
+        return MODE_GPIO;
+    case LINGSI_PIN_AF(AF_START) ... LINGSI_PIN_AF(AF_END):
+        return function;
+    }
+
+    return 0;
+}
+
+static void lingsi_gpio_backup_value(struct lingsi_gpio_bank *bank,
+                    u32 offset, u32 value)
+{
+    bank->pin_backup[offset] &= ~BIT(LINGSI_GPIO_BKP_VAL);
+    bank->pin_backup[offset] |= value << LINGSI_GPIO_BKP_VAL;
+}
+
+static void lingsi_gpio_backup_mode(struct lingsi_gpio_bank *bank, u32 offset,
+                   u32 mode, u32 alt)
+{
+    bank->pin_backup[offset] &= ~(LINGSI_GPIO_BKP_MODE_MASK |
+                      LINGSI_GPIO_BKP_ALT_MASK);
+    bank->pin_backup[offset] |= mode << LINGSI_GPIO_BKP_MODE_SHIFT;
+    bank->pin_backup[offset] |= alt << LINGSI_GPIO_BKP_ALT_SHIFT;
+}
+
+static void lingsi_gpio_backup_driving(struct lingsi_gpio_bank *bank, u32 offset,
+                      u32 drive)
+{
+    bank->pin_backup[offset] &= ~BIT(LINGSI_GPIO_BKP_TYPE);
+    bank->pin_backup[offset] |= drive << LINGSI_GPIO_BKP_TYPE;
+}
+
+static void lingsi_gpio_backup_bias(struct lingsi_gpio_bank *bank, u32 offset,
+                   u32 bias)
+{
+    bank->pin_backup[offset] &= ~LINGSI_GPIO_BKP_PUPD_MASK;
+    bank->pin_backup[offset] |= bias << LINGSI_GPIO_BKP_PUPD_SHIFT;
+}
+
+/* GPIO functions */
+
+static inline void __lingsi_gpio_set(struct lingsi_gpio_bank *bank,
+    unsigned offset, int value)
+{
+    lingsi_gpio_backup_value(bank, offset, value);
+
+    if (!value) {
+        offset += LINGSI_GPIO_PINS_PER_BANK;
+    } else {
+    }
+
+    iowrite32(BIT(offset), bank->base + LINGSI_GPIO_DOT);
+}
+
+static int lingsi_gpio_request(struct gpio_chip *chip, unsigned offset)
+{
+    struct lingsi_gpio_bank *bank = gpiochip_get_data(chip);
+    struct lingsi_pinctrl *pctl = dev_get_drvdata(bank->gpio_chip.parent);
+    struct pinctrl_gpio_range *range;
+    int pin = offset + bank->gpio_chip.base;
+
+    range = pinctrl_find_gpio_range_from_pin_nolock(pctl->pctl_dev, pin);
+    if (!range) {
+        dev_err(pctl->dev, "pin %d not in range.\n", pin);
+        return -EINVAL;
+    }
+
+    return pinctrl_gpio_request(chip->base + offset);
+}
+
+static void lingsi_gpio_free(struct gpio_chip *chip, unsigned offset)
+{
+    pinctrl_gpio_free(chip->base + offset);
+}
+
+static int lingsi_gpio_get(struct gpio_chip *chip, unsigned offset)
+{
+    struct lingsi_gpio_bank *bank = gpiochip_get_data(chip);
+    return !!(readl_relaxed(bank->base + LINGSI_GPIO_DIN) & BIT(offset));
+}
+
+static void lingsi_gpio_set(struct gpio_chip *chip, unsigned offset, int value)
+{
+    struct lingsi_gpio_bank *bank = gpiochip_get_data(chip);
+    __lingsi_gpio_set(bank, offset, value);
+}
+
+static int lingsi_gpio_direction_input(struct gpio_chip *chip, unsigned offset)
+{
+    return pinctrl_gpio_direction_input(chip->base + offset);
+}
+
+static int lingsi_gpio_direction_output(struct gpio_chip *chip,
+    unsigned offset, int value)
+{
+    struct lingsi_gpio_bank *bank = gpiochip_get_data(chip);
+    __lingsi_gpio_set(bank, offset, value);
+    pinctrl_gpio_direction_output(chip->base + offset);
+
+    return 0;
+}
+
+static int lingsi_gpio_to_irq(struct gpio_chip *chip, unsigned int offset)
+{
+    struct lingsi_gpio_bank *bank = gpiochip_get_data(chip);
+    struct irq_fwspec fwspec;
+
+    fwspec.fwnode = bank->fwnode;
+    fwspec.param_count = 2;
+    fwspec.param[0] = offset;
+    fwspec.param[1] = IRQ_TYPE_NONE;
+
+    return irq_create_fwspec_mapping(&fwspec);
+}
+
+static int lingsi_gpio_get_direction(struct gpio_chip *chip, unsigned int offset)
+{
+    struct lingsi_gpio_bank *bank = gpiochip_get_data(chip);
+    int pin = lingsi_gpio_pin(offset);
+    int ret;
+    u32 mode, alt;
+    lingsi_pmx_get_mode(bank, pin, &mode, &alt);
+    if ((alt == 0) && (mode == GPIO_LINE_DIRECTION_IN))
+        ret = GPIO_LINE_DIRECTION_IN;
+    else if ((alt == 0) && (mode == GPIO_LINE_DIRECTION_OUT))
+        ret = GPIO_LINE_DIRECTION_OUT;
+    else {
+        ret = -EINVAL;
+    }
+
+    return ret;
+}
+
+static int lingsi_gpio_init_valid_mask(struct gpio_chip *chip,
+                      unsigned long *valid_mask,
+                      unsigned int ngpios)
+{
