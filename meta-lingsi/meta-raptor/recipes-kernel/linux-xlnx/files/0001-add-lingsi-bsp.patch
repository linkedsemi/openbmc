+
+static int lingsi_gpio_domain_translate(struct irq_domain *d,
+                       struct irq_fwspec *fwspec,
+                       unsigned long *hwirq,
+                       unsigned int *type)
+{
+    struct lingsi_gpio_bank *bank = d->host_data;
+
+    if ((fwspec->param_count != 2) ||
+        (fwspec->param[0] >= LINGSI_GPIO_IRQ_LINE))
+        return -EINVAL;
+
+    *hwirq = fwspec->param[0] + bank->gpio_chip.base;
+    *type = fwspec->param[1];
+    return 0;
+}
+
+static int lingsi_gpio_domain_alloc(struct irq_domain *d,
+                   unsigned int virq,
+                   unsigned int nr_irqs, void *data)
+{
+    struct lingsi_gpio_bank *bank = d->host_data;
+    struct irq_fwspec *fwspec = data;
+    struct irq_fwspec parent_fwspec;
+    irq_hw_number_t hwirq = fwspec->param[0] + bank->gpio_chip.base;
+
+    parent_fwspec.fwnode = d->parent->fwnode;
+    parent_fwspec.param_count = 2;
+    parent_fwspec.param[0] = hwirq;
+    parent_fwspec.param[1] = fwspec->param[1];
+    irq_domain_set_hwirq_and_chip(d, virq, hwirq, &lingsi_gpio_irq_chip,
+                      bank);
+
+    return irq_domain_alloc_irqs_parent(d, virq, nr_irqs, &parent_fwspec);
+}
+
+static void lingsi_gpio_domain_free(struct irq_domain *d, unsigned int virq,
+                   unsigned int nr_irqs)
+{
+    irq_domain_free_irqs_common(d, virq, nr_irqs);
+}
