+static void lingsi_video_get_resolution(struct lingsi_video *video)
+{
+    struct v4l2_bt_timings *det = &video->detected_timings;
+
+    det->height = HEIGHT;
+    det->width = WIDTH;
+    video->v4l2_input_status = 0;
+    dev_dbg(video->dev, "Got resolution: %dx%d\n", det->width, det->height);
+    return;
+}
+
+static void lingsi_video_set_resolution(struct lingsi_video *video)
+{
+    return;
+}
+
+static void lingsi_video_start(struct lingsi_video *video)
+{
+    lingsi_video_on(video);
+
+    /* Resolution set to 640x480 if no signal found */
+    lingsi_video_get_resolution(video);
+
+    /* Set timings since the device is being opened for the first time */
+    video->active_timings = video->detected_timings;
+    lingsi_video_set_resolution(video);
+
+    video->pix_fmt.width = WIDTH;
+    video->pix_fmt.height = HEIGHT;
+    video->pix_fmt.sizeimage = IMAGE_SIZE;
+    video->pix_fmt.field = V4L2_FIELD_NONE;
+    video->pix_fmt.colorspace = V4L2_COLORSPACE_RAW;
+    video->pix_fmt.bytesperline = video->pix_fmt.width * PIX_BPP;
+}
+
+static void lingsi_video_stop(struct lingsi_video *video)
+{
+    set_bit(VIDEO_STOPPED, &video->flags);
+
+    lingsi_video_off(video);
+
+    video->v4l2_input_status = V4L2_IN_ST_NO_SIGNAL;
+    video->flags = 0;
+}
