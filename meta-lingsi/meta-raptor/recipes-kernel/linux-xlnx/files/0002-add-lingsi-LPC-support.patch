diff --git a/drivers/char/ipmi/lingsi/Kconfig b/drivers/char/ipmi/lingsi/Kconfig
index 9504b4cb3639..63b6c3f23e97 100644
--- a/drivers/char/ipmi/lingsi/Kconfig
+++ b/drivers/char/ipmi/lingsi/Kconfig
@@ -1,14 +1,19 @@
 # SPDX-License-Identifier: GPL-2.0-only
 if ARCH_LINGSI || COMPILE_TEST
 
-config LINGSI_ESPI_LPC
-    bool "LINGSI_ESPI_LPC"
+config LINGSI_ESPI
+    bool "LINGSI_ESPI"
+    help
+      TBD
+
+config LINGSI_LPC
+    bool "LINGSI_LPC"
     help
       TBD
 
 config LINGSI_KCS_IPMI_BMC
     select IPMI_KCS_BMC
