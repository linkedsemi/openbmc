Upstream-Status: Pending

 board/xilinx/zynq/board.c |   56 ++
 board/xilinx/zynq/iomux.c | 1275 +++++++++++++++++++++++++++++++++++++
 2 files changed, 1331 insertions(+)
 create mode 100644 board/xilinx/zynq/iomux.c

diff --git a/board/xilinx/zynq/board.c b/board/xilinx/zynq/board.c
index 17ee541bd8..1a49586480 100644
--- a/board/xilinx/zynq/board.c
+++ b/board/xilinx/zynq/board.c
@@ -19,8 +19,10 @@
 #include <wdt.h>
 #include <zynqpl.h>
 #include <asm/global_data.h>
+#include <asm/io.h>
 #include <asm/arch/hardware.h>
 #include <asm/arch/sys_proto.h>
+#include <linux/delay.h>
 #include "../common/board.h"
 
 DECLARE_GLOBAL_DATA_PTR;
@@ -32,6 +34,60 @@ void board_debug_uart_init(void)
 }
 #endif
 
+#include "iomux.c"
+
+// volatile unsigned long long g_cnt = 60000;
+volatile unsigned long long g_cnt = 30000;
+// volatile unsigned long long g_cnt = 2500;
+void __attribute__((optimize(0))) phy_delay(void)
+{
+    while(g_cnt--);
+}
+
+int board_early_init_f(void)
+{
+	CLEAR_BIT(SYSC_AWO_BASE + AWO_PIN_SEL0, 0xfffffffe);
+	CLEAR_BIT(SYSC_AWO_BASE + AWO_PIN_SEL1, 0xffffffff);
+	CLEAR_BIT(SYSC_AWO_BASE + AWO_PIN_SEL2, 0xffffffff);
+	CLEAR_BIT(SYSC_AWO_BASE + AWO_PIN_SEL3, 0xffffffff);
+	CLEAR_BIT(SYSC_AWO_BASE + AWO_PIN_SEL4, 0xffffffff);
+
+	/* enable dw_i2c0 */
+	// pinmux_iic1_init(PA02, PA01);
+
+	/* BMC console */
+	// pinmux_dwuart1_init(PB15, PB03);
+
+	/* PDRGD */
+	io_cfg_input(PH11);
+	/* CPURST# */
+	io_cfg_input(PA13);
+	/* BMC_RESET# */
+	io_cfg_input(PC01);
+
+	/* BMC_PHY_RST_N */
+	io_cfg_opendrain(PA10);
+	io_cfg_output(PA10);
+
+	io_write_pin(PA10, 0);
+	phy_delay();
+	io_write_pin(PA10, 1);
+
+	/* BMC_FWSPI_CS_N */
+	io_cfg_output(PA02);
+	io_cfg_pushpull(PA02);
+	/* deassert */
+	io_write_pin(PA10, 1);
+
+	/* BMC console workaound */
+	pinmux_dwuart1_init(PH10, PD06);
+
+	pinmux_lpc_init();
+	pinmux_lpc_serirq_init();
+
+	return 0;
+}
+
 int board_init(void)
 {
 	if (IS_ENABLED(CONFIG_SPL_BUILD))
