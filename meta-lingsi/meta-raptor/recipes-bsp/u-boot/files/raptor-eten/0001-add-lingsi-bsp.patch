+void io_cfg_input(uint8_t pin)
+{
+    gpio_port_pin_t *x = (gpio_port_pin_t *)&pin;
+    CLEAR_BIT(SYSC_AWO_BASE + AWO_IO + (AWO_IO_GPIO_SIZE * x->port) + AWO_IO_GPIO_OE_FIR, 1<<16<<x->num);
+    CLEAR_BIT(SYSC_AWO_BASE + AWO_IO + (AWO_IO_GPIO_SIZE * x->port) + AWO_IO_GPIO_IEN_OD, 1<<16<<x->num);
+}
+
+void io_cfg_output(uint8_t pin)
+{
+    gpio_port_pin_t *x = (gpio_port_pin_t *)&pin;
+    SET_BIT(SYSC_AWO_BASE + AWO_IO + (AWO_IO_GPIO_SIZE * x->port) + AWO_IO_GPIO_OE_FIR, 1<<16<<x->num);
+}
+
+void io_cfg_opendrain(uint8_t pin)
+{
+    gpio_port_pin_t *x = (gpio_port_pin_t *)&pin;
+    SET_BIT(SYSC_AWO_BASE + AWO_IO + (AWO_IO_GPIO_SIZE * x->port) + AWO_IO_GPIO_IEN_OD, 1<<x->num);
+}
+
+void io_cfg_pushpull(uint8_t pin)
+{
+    gpio_port_pin_t *x = (gpio_port_pin_t *)&pin;
+    CLEAR_BIT(SYSC_AWO_BASE + AWO_IO + (AWO_IO_GPIO_SIZE * x->port) + AWO_IO_GPIO_IEN_OD, 1<<16<<x->num);
+}
+
+void io_set_pin(uint8_t pin)
+{
+    gpio_port_pin_t *x = (gpio_port_pin_t *)&pin;
+    SET_BIT(SYSC_AWO_BASE + AWO_IO + (AWO_IO_GPIO_SIZE * x->port) + AWO_IO_GPIO_DOT, 1<<x->num);
+}
+
+void io_clr_pin(uint8_t pin)
+{
+    gpio_port_pin_t *x = (gpio_port_pin_t *)&pin;
+    SET_BIT(SYSC_AWO_BASE + AWO_IO + (AWO_IO_GPIO_SIZE * x->port) + AWO_IO_GPIO_DOT, 1<<16<<x->num);
+}
+
+void io_write_pin(uint8_t pin,uint8_t val)
+{
+    if(val)
+    {
+        io_set_pin(pin);
+    }else
+    {
+        io_clr_pin(pin);
+    }
+}
+
+static uint8_t pin2func_io(gpio_port_pin_t *x)
+{
+    return x->port*16+x->num;
+}
+
+static void per_func_enable(uint8_t func_io_num,uint8_t per_func)
+{
+    uint32_t alt_offset = 0;
+    MODIFY_REG(SYSC_PER_BASE + PER_FUNC_SEL + ((func_io_num>>2)<<2), 0xff<<8*(func_io_num%4), per_func<<8*(func_io_num%4));
+    alt_offset = AWO_PIN_SEL1 + (func_io_num >> 5) * 0x4;
+    SET_BIT(SYSC_AWO_BASE + alt_offset, 1 << (func_io_num % 32));
+}
+
+void pinmux_dwuart1_init(uint8_t txd,uint8_t rxd)
+{
+    per_func_enable(pin2func_io((gpio_port_pin_t *)&txd),DWUART1_TXD);
+    per_func_enable(pin2func_io((gpio_port_pin_t *)&rxd),DWUART1_RXD);
+}
+
+void pinmux_espi_init(void)
+{
+    CLEAR_BIT(SYSC_AWO_BASE + AWO_IO + AWO_IO_GPIO_SIZE * 3 + AWO_IO_GPIO_IEN_OD, 0xfe000000);
+    SET_BIT(SYSC_AWO_BASE + AWO_PIN_SEL0, SYSC_AWO_ESPI_EN);
+}
