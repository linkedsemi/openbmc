+#define PER_PD_PER_CLKG0 0x0
+#define PER_PD_PER_CLKG1 0x4
+#define PER_PD_PER_CLKG2 0x8
+#define PER_PD_PER_CLKG3 0xc
+#define PER_PD_PER_SRST0 0x10
+#define PER_PD_PER_SRST1 0x14
+#define PER_PD_PER_SRST2 0x18
+#define PER_PD_PER_SRST3 0x1c
+#define PER_FUNC_SEL 0x20
+#define PER_COMP_PIS 0xa0
+#define PER_PIS_SFT 0xa4
+#define PER_TIMER_UART 0xa8
+
+typedef struct
+{
+    uint8_t num:4,   /*!<gpio pin */
+            port:4;  /*!<gpio port */
+}gpio_port_pin_t;
+
+#define WRITE_REG(REG, VAL)  writel(VAL, REG)
+
+#define READ_REG(REG)  readl(REG)
+
+#define SET_BIT(REG, BIT)  WRITE_REG(REG, (READ_REG(REG)) | (BIT))
+
+#define CLEAR_BIT(REG, BIT)   WRITE_REG(REG, (READ_REG(REG)) & (~(BIT)))
+
+#define READ_BIT(REG, BIT)    (READ_REG(REG) & (BIT))
+
+#define CLEAR_REG(REG)        WRITE_REG(REG, 0x0)
+
+#define MODIFY_REG(REG, CLEARMASK, SETMASK)  \
+        WRITE_REG((REG), (((READ_REG(REG)) & (~(CLEARMASK))) | (SETMASK)))
+
