#include "irq.h"
#include "gpio.h"
#include "lingsi-pinfunc.h"

/ {
    usb_phy0: phy@e0002000 {
        compatible = "ulpi-phy";
        #phy-cells = <0>;
        reg = <0xe0002000 0x1000>;
        view-port = <0x0170>;
        drv-vbus;
    };

    axi {
        #address-cells = <1>;
        #size-cells = <1>;
        interrupt-parent = <&intc>;

        gic_cpu: gic_cpu@f8f00100 {
            compatible = "arm,cortex-a9-gic-cpu", "syscon", "simple-mfd";
            reg = <0xf8f00100 0x100>;
        };

        sysc_awo: sysc_awo@4000a000 {
            compatible = "lingsi,sysc_awo", "syscon", "simple-mfd";
            reg = <0x4000a000 0x60>;
        };

        sysc_per: sysc_per@4008d000 {
            compatible = "lingsi,sysc_per", "syscon", "simple-mfd";
            reg = <0x4008d000 0x400>;
        };

        video: video@80000000 {
            compatible = "lingsi,video-engine";
            status = "disabled";
            dmas = <&dmac_s 0>;
            dma-names = "gdma";
            vram = /bits/ 64 <0x80000000>;
        };

        peri_intc: interrupt-controller@40009000 {
            compatible = "lingsi,peri-intc", "syscon", "simple-mfd";
            reg = <0x40009000 0x1000>;
            interrupt-parent = <&intc>;
            interrupt-controller;
            #interrupt-cells = <1>;
            interrupts = <0 29 4>;
        };

        exti_intc: interrupt-controller@4000a180 {
            compatible = "lingsi,exti-intc";
            interrupt-controller;
            #interrupt-cells = <2>;
            reg = <0x4000a180 0x80>;
            interrupt-parent = <&peri_intc>;
            interrupts = <62>;
        };

        lingsi_pinctrl: lingsi_pinctrl@4000a060 {
            compatible = "lingsi,pinctrl-raptor";

            fpga_i2c0_pins: fpga_i2c0_pins-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('E', 8, LINGSI_I2C1_SCL)>,
                             /bits/ 64 <LINGSI_PINMUX('E', 9, LINGSI_I2C1_SDA)>;
                };
            };

            fpga_i2c1_pins: fpga_i2c1_pins-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('B', 13, LINGSI_I2C2_SCL)>,
                             /bits/ 64 <LINGSI_PINMUX('B', 14, LINGSI_I2C2_SDA)>;
                };
            };

            // CONSOLE_TX RX
            // fpga_uart0_pins: fpga_uart0-0 {
            //     pins {
            //         pinmux = <LINGSI_PINMUX('A', 6, LINGSI_DWUART1_RXD)>,
            //                 <LINGSI_PINMUX('A', 5, LINGSI_DWUART1_TXD)>;
            //     };
            // };

            // BMC console
            // fpga_uart0_pins: fpga_uart0-0 {
            //     pins {
            //         pinmux = <LINGSI_PINMUX('A', 6, LINGSI_DWUART1_RXD)>,
            //                 <LINGSI_PINMUX('A', 5, LINGSI_DWUART1_TXD)>;
            //     };
            // };

            /* BMC console workaound */
            fpga_uart0_pins: fpga_uart0-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('D', 6, LINGSI_DWUART1_RXD)>,
                             /bits/ 64 <LINGSI_PINMUX('H', 10, LINGSI_DWUART1_TXD)>;
                };
            };

            fpga_uart1_pins: fpga_uart1-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('A', 0, LINGSI_DWUART2_RXD)>,
                             /bits/ 64 <LINGSI_PINMUX('A', 1, LINGSI_DWUART2_TXD)>;
                };
            };

            fpga_sgpm_pins: fpga_sgpm-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('A', 12, LINGSI_SGPMLD)>,
                             /bits/ 64 <LINGSI_PINMUX('E', 15, LINGSI_SGPMI)>,
                             /bits/ 64 <LINGSI_PINMUX('A', 11, LINGSI_SGPMO)>,
                             /bits/ 64 <LINGSI_PINMUX('H', 0, LINGSI_SGPMCK)>;
                };
            };

            fpga_sgpsm_pins: fpga_sgpsm-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('A', 9, LINGSI_SGPSMLD)>,
                             /bits/ 64 <LINGSI_PINMUX('A', 0, LINGSI_SGPSMI)>,
                             /bits/ 64 <LINGSI_PINMUX('G', 0, LINGSI_SGPSMO)>,
                             /bits/ 64 <LINGSI_PINMUX('B', 6, LINGSI_SGPSMCK)>;
                };
            };

            vuart0_pins: vuart0-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('A', 4, LINGSI_DWUART2_RXD)>,
                             /bits/ 64 <LINGSI_PINMUX('A', 3, LINGSI_DWUART2_TXD)>;
                };
            };

            fpga_spi_pins: fpga_spi-0 {
                pins {
                    pinmux = /bits/ 64 <LINGSI_PINMUX('E', 12, LINGSI_SPI1_SCK)>,
                             /bits/ 64 <LINGSI_PINMUX('F', 0, LINGSI_SPI1_NSS0)>,
                             /bits/ 64 <LINGSI_PINMUX('H', 13, LINGSI_SPI1_DQ0)>,
                             /bits/ 64 <LINGSI_PINMUX('H', 12, LINGSI_SPI1_DQ1)>;
                };
            };

            // Just writing to see
            // espi_pins: espi {
            //     pins {
            //         pinmux = <LINGSI_PINMUX('H', 2, LINGSI_ESPI_RST)>,
            //                 <LINGSI_PINMUX('D', 13, LINGSI_ESPI_D1)>,
            //                 <LINGSI_PINMUX('D', 14, LINGSI_ESPI_D0)>,
            //                 <LINGSI_PINMUX('D', 9, LINGSI_ESPI_ALERT)>,
            //                 <LINGSI_PINMUX('D', 10, LINGSI_ESPI_CS)>,
            //                 <LINGSI_PINMUX('D', 11, LINGSI_ESPI_D3)>,
            //                 <LINGSI_PINMUX('D', 12, LINGSI_ESPI_D2)>,
            //                 <LINGSI_PINMUX('D', 15, LINGSI_ESPI_CLK)>;
            //     };
            // };
        };

        dummy_apb: apb-clock {
            compatible = "fixed-clock";
            clock-frequency = <50000000>;
            clock-output-names = "dummy_apb";
            #clock-cells = <0>;
        };

        fpga_dmac0: dma-controller@40002000 {
            compatible = "snps,axi-dma-1.01a";
            reg = <0x40002000 0x1000>;
            interrupt-parent = <&peri_intc>;
            interrupts = <9>;
            #dma-cells = <1>;
            clocks = <&dummy_apb>, <&dummy_apb>;
            clock-names = "core-clk", "cfgr-clk";
            dma-channels = <6>;
            snps,dma-masters = <2>;
            snps,priority = <0 1 2 3 4 5>;
            snps,data-width = <4>;
            snps,block-size = <0x200000 0x200000 0x200000 0x200000 0x200000 0x200000>;
            snps,axi-max-burst-len = <256>;
        };

        fpga_gpio: gpio@4000a060 {
            compatible = "lingsi,gpio", "syscon", "simple-mfd";
            reg = <0x4000a060 0x200>;
            interrupt-parent = <&exti_intc>;
            interrupt-controller;
            #interrupt-cells = <2>;
            gpio-controller;
            #gpio-cells = <2>;
            gpio-ranges = <&lingsi_pinctrl 0 0 128>;
            ngpios = <128>;
            status = "disabled";
        };

        fpga_i2c0: i2c@40083000 {
            compatible = "snps,designware-i2c";
            reg = <0x40083000 0x400>;
            interrupt-parent = <&peri_intc>;
            interrupts = <29>;
            clocks = <&dummy_apb>;
            clock-frequency = <100000>;
            pinctrl-names = "default";
            pinctrl-0 = <&fpga_i2c0_pins>;
            status = "disabled";
        };

        fpga_i2c1: i2c@40083400 {
            compatible = "snps,designware-i2c";
            reg = <0x40083400 0x400>;
            interrupt-parent = <&peri_intc>;
            interrupts = <30>;
            clocks = <&dummy_apb>;
            clock-frequency = <100000>;
            pinctrl-names = "default";
            pinctrl-0 = <&fpga_i2c1_pins>;
            status = "disabled";
        };

        fpga_sgpiom: sgpiom@4008e800 {
            #gpio-cells = <2>;
            gpio-controller;
            compatible = "lingsi,sgpiom";
            reg = <0x4008e800 0x400>;
            interrupt-parent = <&peri_intc>;
            interrupts = <56>;
            clocks = <&dummy_apb>;
            interrupt-controller;
            bus-frequency = <115200>;
            pinctrl-names = "default";
            pinctrl-0 = <&fpga_sgpm_pins>;
            status = "disabled";
        };

        fpga_uart0: serial@40085c00 {
            compatible = "snps,dw-apb-uart";
            reg = <0x40085c00 0x400>;

            // interrupt-parent = <&intc>;
            // interrupts = <0 29 4>;

            // interrupt-parent = <&intc>;
            // interrupts = <0 31 4>;

            interrupt-parent = <&peri_intc>;
            interrupts = <38>;

            clocks = <&dummy_apb>;
            clock-names = "baudclk";
            reg-shift = <2>;
            reg-io-width = <4>;
            clock-frequency = <50000000>;
            current-speed = <115200>;
            pinctrl-names = "default";
            pinctrl-0 = <&fpga_uart0_pins>;
            status = "disabled";
        };

        fpga_uart1: serial@40086000 {
            compatible = "snps,dw-apb-uart";
            reg = <0x40086000 0x400>;
            interrupt-parent = <&peri_intc>;
            interrupts = <39>;
            clocks = <&dummy_apb>;
            clock-names = "baudclk";
            reg-shift = <2>;
            reg-io-width = <4>;
            clock-frequency = <50000000>;
            current-speed = <115200>;
            pinctrl-names = "default";
            pinctrl-0 = <&fpga_uart1_pins>;
            status = "disabled";
        };

        fpga_spi: spi@40087000 {
            compatible = "snps,dw-apb-ssi";
            reg = <0x40087000 0x400>;
            interrupt-parent = <&peri_intc>;
            interrupts = <40>;
            clocks = <&dummy_apb>;
            #address-cells = <1>;
            #size-cells = <0>;
            reg-io-width = <4>;
            num-cs = <1>;
            pinctrl-names = "default";
            pinctrl-0 = <&fpga_spi_pins>;
            status = "disabled";
        };

        fpga_espi: espi@40004000 {
            compatible = "lingsi,espi", "simple-mfd";
            reg = <0x40004000 0x1000>;
            interrupt-parent = <&peri_intc>;
            interrupts = <11>;
            #address-cells = <1>;
            #size-cells = <1>;
            ranges;
            status = "disabled";

            espi_kcs0: kcs@0 {
                compatible = "lingsi,kcs-bmc";
                kcs_chan = <0x3>;
                kcs_addr = <0xca2>;
                status = "disabled";
            };

            espi_kcs1: kcs@1 {
                compatible = "lingsi,kcs-bmc";
                kcs_chan = <0x4>;
                kcs_addr = <0xca4>;
                status = "disabled";
            };

            host_dev0: host_dev@0 {
                compatible = "lingsi,host-dev";
                reg = <0x40086000 0x400>;
                interrupt-parent = <&peri_intc>;
                interrupts = <39>;
                host_reg = <0x3f8 8>;
                upstream_irq = <0x4 IRQ_TYPE_LEVEL_HIGH>;
                status = "disabled";
            };

            host_vuart0: host_vuart@0 {
                compatible = "lingsi,host-vuart";
                reg = <0x40086000 0x400>;
                interrupt-parent = <&peri_intc>;
                interrupts = <39>;
                host_reg = <0x3f8 8>;
                upstream_irq = <0x4 IRQ_TYPE_LEVEL_HIGH>;
                pinctrl-names = "default";
                pinctrl-0 = <&vuart0_pins>;
                status = "disabled";
            };

            vuart0: vuart@0 {
                compatible = "lingsi,vuart";
                host_reg = <0x4f8 8>;
                upstream_irq = <0x4 IRQ_TYPE_LEVEL_HIGH>;
                status = "disabled";
            };

            mmbi: mmbi@0 {
                compatible = "lingsi,mmbi";
                host-addr = <0xf6810000>;
                size-order = <0>;
                status = "disabled";
            };

            sio: sio@0 {
                compatible = "lingsi,sio";
                status = "disabled";
            };

            host_dev2: host_dev@2 {
                compatible = "lingsi,host-dev";
                host_reg = <0x5f8 8>;
                upstream_irq = <0x4 IRQ_TYPE_LEVEL_HIGH>;
                status = "disabled";
            };

            vuart2: vuart@2 {
                compatible = "lingsi,vuart";
                host_reg = <0x6f8 8>;
                upstream_irq = <0x4 IRQ_TYPE_LEVEL_HIGH>;
                status = "disabled";
            };
        };

        fpga_lpc: lpc@40005000 {
            compatible = "lingsi,lpc", "simple-mfd";
            reg = <0x40005000 0x1000>;
            interrupt-parent = <&peri_intc>;
            interrupts = <12>;
            #address-cells = <1>;
            #size-cells = <1>;
            ranges;
            status = "disabled";

            lpc_kcs0: kcs@0 {
                compatible = "lingsi,kcs-bmc";
                kcs_chan = <0x3>;
                kcs_addr = <0xca2>;
                status = "disabled";
            };

            lpc_kcs1: kcs@1 {
                compatible = "lingsi,kcs-bmc";
                kcs_chan = <0x4>;
                kcs_addr = <0xca4>;
                status = "disabled";
            };
        };

        test_gpio: test_gpio@0 {
            compatible = "lingsi,home_key";
        };

        // test_dma: test_dma@0 {
        //     compatible = "lingsi,test_dma";
        //     dmas = <&fpga_dmac1 6 0 0>;
        //     // dmas = <&dmac_s 6>;
        //     dma-names = "gdma";
        // };
    };

    aliases {
        /* runbmc ARM(PS) console */
        serial0 = &uart0;
        /* runbmc FPGA(PL) console */
        fpga_serial0 = &fpga_uart0;
        /* cpu sol console */
        vuart0 = &host_vuart0;
        ethernet0 = &gem0;
        spi0 = &qspi;
    };

    chosen {
        /* AX7450, AX7Z100, runbmc PS console */
        // bootargs = "console=ttyPS0,115200 earlycon log_buf_len=32M";
        // stdout-path = "serial0:115200n8";

        /* runbmc PL console */
        bootargs = "console=ttyS0,115200 earlycon log_buf_len=32M";
        stdout-path = "fpga_serial0:115200n8";
    };
};

// &cpu1 {
//     status = "disabled";
// };

&clkc {
    fclk-enable = <0xf>;
    ps-clk-frequency = <33333333>;
};

/* ttyPS0 */
// &uart0 {
//     status = "disabled";
// };

/* ttyPS1 */
&uart1 {
    status = "disabled";
};

&qspi {
    status = "disabled";

    is-dual = <1>;
    num-cs = <2>;
    spi-rx-bus-width = <4>;
    spi-tx-bus-width = <4>;
    spi-max-frequency = <40000000>;
    flash0: flash@0 {
        #address-cells = <1>;
        #size-cells = <1>;
        reg = <0>, <1>;
        parallel-memories = /bits/ 64 <0x2000000 0x2000000>; /* 32MB + 32MB */
        m25p,fast-read;
        spi-max-frequency = <40000000>;
        compatible = "jedec,spi-nor";
        partition@0 {
            label = "qspi-boot";
            reg = <0x00000000 0x1000000>;
        };
        partition@99 {
            label = "qspi-flash";
            reg = <0x00000000 0xffffffff>;
        };
    };
};

&gem0 {
    // status = "disabled";

    // phy-mode = "rgmii";
    phy-mode = "rgmii-id";
    // /delete-property/phy-mode;
    phy-handle = <&ethphy0>;
    local-mac-address = [36 04 F6 A7 7F DF];

    ethphy0: ethernet-phy@0 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0>;
    };

    // fixed-link {
    //     speed = <100>;
    //     full-duplex;
    // };
};

&gem1 {
    local-mac-address = [36 04 F6 A7 7F EF];
};

&usb0 {
    // status = "okay";
    // dr_mode = "otg";
    dr_mode = "peripheral";
    usb-phy = <&usb_phy0>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_usb0_default>;
};

&usb1 {
    status = "disabled";
};

&adc {
    status = "disabled";
};

&can0 {
    status = "disabled";
};

&can1 {
    status = "disabled";
};

&gpio0 {
    status = "disabled";
};

&i2c1 {
    status = "disabled";
};

&spi0 {
    status = "disabled";
};

&spi1 {
    status = "disabled";
};

