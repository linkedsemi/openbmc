&fpga_spi {
    // status = "okay";

    bios_flash: flash@0 {
        compatible = "jedec,spi-nor";
        #address-cells = <1>;
        #size-cells = <1>;
        reg = <0>;
        spi-max-frequency = <1000000>;
    };
};

