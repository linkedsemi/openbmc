Subject: [PATCH] lingsi: add kvm support

---
 create_usbhid.sh | 19 +++++--------------
 ikvm_input.hpp   |  2 +-
 ikvm_server.cpp  |  1 +
 ikvm_video.cpp   |  8 +++++++-
 4 files changed, 14 insertions(+), 16 deletions(-)

diff --git a/create_usbhid.sh b/create_usbhid.sh
index 58e4034..8407e36 100644
--- a/create_usbhid.sh
+++ b/create_usbhid.sh
@@ -1,10 +1,11 @@
 #!/bin/sh
 
 hid_conf_directory="/sys/kernel/config/usb_gadget/obmc_hid"
-dev_name="1e6a0000.usb-vhub"
+dev_name="ci_hdrc.0"
 
 create_hid() {
     # create gadget
+    [ -d "/sys/kernel/config/usb_gadget" ] || modprobe libcomposite
     mkdir "${hid_conf_directory}"
     cd "${hid_conf_directory}" || exit 1
 
@@ -125,23 +126,13 @@ create_hid() {
 }
 
 connect_hid() {
-    if ! grep -q "${dev_name}:p" UDC; then
-        i=0
-        num_ports=5
-        base_usb_dir="/sys/bus/platform/devices/${dev_name}/${dev_name}:p"
-        while [ "${i}" -lt "${num_ports}" ]; do
-            port=$(("${i}" + 1))
-            i="${port}"
-            if [ ! -e "${base_usb_dir}${port}/gadget/suspended" ]; then
-                break
-            fi
-        done
-        echo "${dev_name}:p${port}" > UDC
+    if ! grep -q "${dev_name}" UDC; then
+        echo "${dev_name}" > UDC
     fi
 }
 
 disconnect_hid() {
-    if grep -q "${dev_name}:p" UDC; then
+    if grep -q "${dev_name}" UDC; then
         echo "" > UDC
     fi
 }
